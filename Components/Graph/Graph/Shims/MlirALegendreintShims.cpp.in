/// @brief C Interface to MLIR for a al int operator
/// column major data, cpu operators
/// @param op
/// @param uval
/// @param umod
extern "C" void _ciface_quiccir_al_@Op@_@Kind@_complexf64_S1CLCSC3D_complexf64_DCCSC3D(void* obj, view3_cd_t* pUmod, view3_cd_t* pUval)
{
    QuICC::Profiler::RegionFixture<3> fixTotal("MlirALegendreintShims");

