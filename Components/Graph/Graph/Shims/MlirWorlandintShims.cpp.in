/// @brief C Interface to MLIR for a jw @Op@ operator of kind @Kind@
/// column major data, gpu operators
/// @param op
/// @param uval
/// @param umod
extern "C" void _ciface_quiccir_jw_@Op@_@Kind@_complexf64_DCCSC3D_complexf64_DCCSC3D(void* obj, view3_cd_t* pUmod, view3_cd_t* pUval)
{
    QuICC::Profiler::RegionFixture<3> fixTotal("MlirWorlandintShims");

    #ifndef NDEBUG
    std::cout <<
        "_ciface_quiccir_jw_@Op@_@Kind@_complexf64_DCCSC3D_complexf64_DCCSC3D\n";
    #endif
    assert(obj != nullptr);
    assert(pUval != nullptr);
    assert(pUmod != nullptr);

    // op
    //using namespace QuICC::Transform::Quadrature;
    using Tin = C_DCCSC3D_t;
    using Tout = C_DCCSC3D_t;
    // QUICC_USE_IBLOCKED_CUDA_MATMUL_WARP_TILE
    using Top = QuICC::View::View<double, QuICC::View::CSL3D>;
    //using backend_t = Cuda::ImplOp<Tout, Tin, Top>;

    //using op_t = Op<Tout, Tin, Top, backend_t>;
    // views
    using namespace QuICC::View;
    constexpr std::uint32_t rank = 3;
    ViewBase<std::uint32_t> pointers[rank];
    pointers[1] = ViewBase<std::uint32_t>(pUmod->pos, pUmod->posSize);
    ViewBase<std::uint32_t> indices[rank];
    indices[1] = ViewBase<std::uint32_t>(pUmod->coo, pUmod->cooSize);
    assert(pUmod->pos == pUval->pos);
    assert(pUmod->coo == pUval->coo);
    assert(QuICC::Cuda::isDeviceMemory(pUmod->pos));
    assert(QuICC::Cuda::isDeviceMemory(pUmod->coo));
    assert(QuICC::Cuda::isDeviceMemory(pUmod->data));
    assert(QuICC::Cuda::isDeviceMemory(pUval->data));
    Tin viewVal(pUval->data, pUval->dataSize, pUval->dims, pointers, indices);
    Tout viewMod(pUmod->data, pUmod->dataSize, pUmod->dims, pointers, indices);

    // Check that op was set up
    //auto cl = reinterpret_cast<QuICC::Operator::UnaryOp<Tout, Tin>*>(obj);
    using mods_t = QuICC::View::View<std::complex<double>, QuICC::View::DCCSC3D>;
    using phys_t = QuICC::View::View<std::complex<double>, QuICC::View::DCCSC3D>;
   
    QuICC::Transform::Worland_parallALT::ParallaltOp<phys_t, mods_t>* cl = (QuICC::Transform::Worland_parallALT::ParallaltOp<phys_t, mods_t>*)obj;
    
     const char* proj_operator = "@Kind@";
    //printf("%s\n", proj_operator);
    if (!strcmp(proj_operator, "P"))
        cl->setType(PFSOLVE_RADIAL, 0, 1);
    if (!strcmp(proj_operator, "P_Zero"))
        cl->setType(PFSOLVE_RADIAL_ZERO, 0, 1);
    if (!strcmp(proj_operator, "DivR1"))
        cl->setType(PFSOLVE_RADIAL_DIVR, 0, 1);
    if (!strcmp(proj_operator, "DivR1_Zero"))
        cl->setType(PFSOLVE_RADIAL_DIVR_ZERO, 0, 1);
    if (!strcmp(proj_operator, "D1"))
        cl->setType(PFSOLVE_RADIAL_DR, 0, 1);
    if (!strcmp(proj_operator, "R1"))
        cl->setType(PFSOLVE_RADIAL_R, 0, 1);
    if (!strcmp(proj_operator, "R1_Zero"))
        cl->setType(PFSOLVE_RADIAL_R_ZERO, 0, 1);
    if (!strcmp(proj_operator, "DivR1D1R1"))
        cl->setType(PFSOLVE_RADIAL_DIVR_DR_R, 0, 1);
    if (!strcmp(proj_operator, "DivR1D1R1_Zero"))
        cl->setType(PFSOLVE_RADIAL_DIVR_DR_R_ZERO, 0, 1);
    if (!strcmp(proj_operator, "SphLapl"))
        cl->setType(PFSOLVE_RADIAL_SPHLAPL, 0, 1);

    if (!strcmp(proj_operator, "I2"))
        cl->setType(PFSOLVE_RADIAL_I2, 0, 1);
    if (!strcmp(proj_operator, "I2_Zero"))
        cl->setType(PFSOLVE_RADIAL_I2_ZERO, 0, 1);
    if (!strcmp(proj_operator, "I2DivR1"))
        cl->setType(PFSOLVE_RADIAL_I2_DIVR, 0, 1);
    if (!strcmp(proj_operator, "I2DivR1_Zero"))
        cl->setType(PFSOLVE_RADIAL_I2_DIVR_ZERO, 0, 1);
    if (!strcmp(proj_operator, "I2DivR1D1R1"))
        cl->setType(PFSOLVE_RADIAL_I2_DIVR_DR_R, 0, 1);
    if (!strcmp(proj_operator, "I2DivR1D1R1_Zero"))
        cl->setType(PFSOLVE_RADIAL_I2_DIVR_DR_R_ZERO, 0, 1);
    if (!strcmp(proj_operator, "I4"))
        cl->setType(PFSOLVE_RADIAL_I4, 0, 1);    
    if (!strcmp(proj_operator, "I4_Zero"))
        cl->setType(PFSOLVE_RADIAL_I4_ZERO, 0, 1);
    if (!strcmp(proj_operator, "I4DivR1"))
        cl->setType(PFSOLVE_RADIAL_I4_DIVR, 0, 1);
    if (!strcmp(proj_operator, "I4DivR1_Zero"))
        cl->setType(PFSOLVE_RADIAL_I4_DIVR_ZERO, 0, 1);
    if (!strcmp(proj_operator, "I4DivR1D1R1"))
        cl->setType(PFSOLVE_RADIAL_I4_DIVR_DR_R, 0, 1);
    if (!strcmp(proj_operator, "I4DivR1D1R1_Zero"))
        cl->setType(PFSOLVE_RADIAL_I4_DIVR_DR_R_ZERO, 0, 1);
     
     cl->apply(viewMod, viewVal);
    
};

/// @brief C Interface to MLIR for a jw @Op@ operator of kind @Kind@
/// column major data, gpu operators
/// @param op
/// @param uval
/// @param umod
extern "C" void _ciface_quiccir_jw_@Op@_@Kind@_complexf64_DCCSC3DJIK_complexf64_DCCSC3DJIK(void* obj, view3_cd_t* pUmod, view3_cd_t* pUval)
{
    QuICC::Profiler::RegionFixture<3> fixTotal("MlirWorlandintShims");

    #ifndef NDEBUG
    std::cout <<
        "_ciface_quiccir_jw_@Op@_@Kind@_complexf64_DCCSC3DJIK_complexf64_DCCSC3DJIK\n";
    #endif
    assert(obj != nullptr);
    assert(pUval != nullptr);
    assert(pUmod != nullptr);

    // op
    //using namespace QuICC::Transform::Quadrature;
    using Tin = C_DCCSC3DJIK_t;
    using Tout = C_DCCSC3DJIK_t;
    // QUICC_USE_IBLOCKED_CUDA_MATMUL_WARP_TILE
    using Top = QuICC::View::View<double, QuICC::View::CSL3DJIK>;
    //using backend_t = Cuda::ImplOp<Tout, Tin, Top>;

    //using op_t = Op<Tout, Tin, Top, backend_t>;
    // views
    using namespace QuICC::View;
    constexpr std::uint32_t rank = 3;
    ViewBase<std::uint32_t> pointers[rank];
    pointers[1] = ViewBase<std::uint32_t>(pUmod->pos, pUmod->posSize);
    ViewBase<std::uint32_t> indices[rank];
    indices[1] = ViewBase<std::uint32_t>(pUmod->coo, pUmod->cooSize);
    assert(pUmod->pos == pUval->pos);
    assert(pUmod->coo == pUval->coo);
    assert(QuICC::Cuda::isDeviceMemory(pUmod->pos));
    assert(QuICC::Cuda::isDeviceMemory(pUmod->coo));
    assert(QuICC::Cuda::isDeviceMemory(pUmod->data));
    assert(QuICC::Cuda::isDeviceMemory(pUval->data));
    Tin viewVal(pUval->data, pUval->dataSize, pUval->dims, pointers, indices);
    Tout viewMod(pUmod->data, pUmod->dataSize, pUmod->dims, pointers, indices);

    // Check that op was set up
    //auto cl = reinterpret_cast<QuICC::Operator::UnaryOp<Tout, Tin>*>(obj);
    using mods_t = QuICC::View::View<std::complex<double>, QuICC::View::DCCSC3DJIK>;
    using phys_t = QuICC::View::View<std::complex<double>, QuICC::View::DCCSC3DJIK>;
   
    QuICC::Transform::Worland_parallALT::ParallaltOp<phys_t, mods_t>* cl = (QuICC::Transform::Worland_parallALT::ParallaltOp<phys_t, mods_t>*)obj;
    
     const char* proj_operator = "@Kind@";
    //printf("%s\n", proj_operator);
    if (!strcmp(proj_operator, "P"))
        cl->setType(PFSOLVE_RADIAL, 0, 2);
    if (!strcmp(proj_operator, "P_Zero"))
        cl->setType(PFSOLVE_RADIAL_ZERO, 0, 2);
    if (!strcmp(proj_operator, "DivR1"))
        cl->setType(PFSOLVE_RADIAL_DIVR, 0, 2);
    if (!strcmp(proj_operator, "DivR1_Zero"))
        cl->setType(PFSOLVE_RADIAL_DIVR_ZERO, 0, 2);
    if (!strcmp(proj_operator, "D1"))
        cl->setType(PFSOLVE_RADIAL_DR, 0, 2);
    if (!strcmp(proj_operator, "R1"))
        cl->setType(PFSOLVE_RADIAL_R, 0, 2);
    if (!strcmp(proj_operator, "R1_Zero"))
        cl->setType(PFSOLVE_RADIAL_R_ZERO, 0, 2);
    if (!strcmp(proj_operator, "DivR1D1R1"))
        cl->setType(PFSOLVE_RADIAL_DIVR_DR_R, 0, 2);
    if (!strcmp(proj_operator, "DivR1D1R1_Zero"))
        cl->setType(PFSOLVE_RADIAL_DIVR_DR_R_ZERO, 0, 2);
    if (!strcmp(proj_operator, "SphLapl"))
        cl->setType(PFSOLVE_RADIAL_SPHLAPL, 0, 2);

    if (!strcmp(proj_operator, "I2"))
        cl->setType(PFSOLVE_RADIAL_I2, 0, 2);
    if (!strcmp(proj_operator, "I2_Zero"))
        cl->setType(PFSOLVE_RADIAL_I2_ZERO, 0, 2);
    if (!strcmp(proj_operator, "I2DivR1"))
        cl->setType(PFSOLVE_RADIAL_I2_DIVR, 0, 2);
    if (!strcmp(proj_operator, "I2DivR1_Zero"))
        cl->setType(PFSOLVE_RADIAL_I2_DIVR_ZERO, 0, 2);
    if (!strcmp(proj_operator, "I2DivR1D1R1"))
        cl->setType(PFSOLVE_RADIAL_I2_DIVR_DR_R, 0, 2);
    if (!strcmp(proj_operator, "I2DivR1D1R1_Zero"))
        cl->setType(PFSOLVE_RADIAL_I2_DIVR_DR_R_ZERO, 0, 2);
    if (!strcmp(proj_operator, "I4"))
        cl->setType(PFSOLVE_RADIAL_I4, 0, 2);    
    if (!strcmp(proj_operator, "I4_Zero"))
        cl->setType(PFSOLVE_RADIAL_I4_ZERO, 0, 2);
    if (!strcmp(proj_operator, "I4DivR1"))
        cl->setType(PFSOLVE_RADIAL_I4_DIVR, 0, 2);
    if (!strcmp(proj_operator, "I4DivR1_Zero"))
        cl->setType(PFSOLVE_RADIAL_I4_DIVR_ZERO, 0, 2);
    if (!strcmp(proj_operator, "I4DivR1D1R1"))
        cl->setType(PFSOLVE_RADIAL_I4_DIVR_DR_R, 0, 2);
    if (!strcmp(proj_operator, "I4DivR1D1R1_Zero"))
        cl->setType(PFSOLVE_RADIAL_I4_DIVR_DR_R_ZERO, 0, 2);
     
     cl->apply(viewMod, viewVal);
    
};

#else

/// @brief C Interface to MLIR for a jw @Op@ operator of kind @Kind@
/// column major data, gpu operators
/// @param op
/// @param uval
/// @param umod
extern "C" void _ciface_quiccir_jw_@Op@_@Kind@_complexf64_DCCSC3DJIK_complexf64_DCCSC3DJIK(void* obj, view3_cd_t* pUmod, view3_cd_t* pUval)
{
    QuICC::Profiler::RegionFixture<3> fixTotal("MlirWorlandintShims");

    #ifndef NDEBUG
    std::cout <<
        "_ciface_quiccir_jw_@Op@_@Kind@_complexf64_DCCSC3DJIK_complexf64_DCCSC3DJIK\n";
    #endif
    assert(obj != nullptr);
    assert(pUval != nullptr);
    assert(pUmod != nullptr);

    // op
    using namespace QuICC::Transform::Quadrature;
    using Tin = C_DCCSC3DJIK_t;
    using Tout = C_DCCSC3DJIK_t;
    // QUICC_USE_IBLOCKED_CUDA_MATMUL_WARP_TILE
    using Top = QuICC::View::View<double, QuICC::View::CSL3DJIK>;
    using backend_t = Cuda::ImplOp<Tout, Tin, Top>;
    using op_t = Op<Tout, Tin, Top, backend_t>;
    // views
    using namespace QuICC::View;
    constexpr std::uint32_t rank = 3;
    ViewBase<std::uint32_t> pointers[rank];
    pointers[1] = ViewBase<std::uint32_t>(pUmod->pos, pUmod->posSize);
    ViewBase<std::uint32_t> indices[rank];
    indices[1] = ViewBase<std::uint32_t>(pUmod->coo, pUmod->cooSize);
    /// \todo stronger check?
    assert(pUmod->posSize == pUval->posSize);
    assert(pUmod->cooSize == pUval->cooSize);
    assert(QuICC::Cuda::isDeviceMemory(pUmod->pos));
    assert(QuICC::Cuda::isDeviceMemory(pUmod->coo));
    assert(QuICC::Cuda::isDeviceMemory(pUmod->data));
    assert(QuICC::Cuda::isDeviceMemory(pUval->data));
    Tin viewVal(pUval->data, pUval->dataSize, pUval->dims, pointers, indices);
    Tout viewMod(pUmod->data, pUmod->dataSize, pUmod->dims, pointers, indices);
    // Check that op was set up
    auto cl = reinterpret_cast<op_t*>(obj);
    if (cl->getOp().data() == nullptr)
    {
        QuICC::Profiler::RegionFixture<3> fixInit("MlirWorlandintShims-init");

        // dim 0 - N  - radial modes
        // dim 1 - Nr - radial points
        // dim 2 - L  - harmonic degree
        std::array<std::uint32_t, rank> dims {pUmod->dims[0], pUval->dims[0], pUmod->dims[2]};
        std::vector<std::uint32_t> layers;
        // Converter for metadata
        auto pos = pointers[1];
        using namespace QuICC::Memory;
        tempOnHostMemorySpace converterP(pos, TransferMode::read | TransferMode::block);
        for (std::size_t i = 0; i < dims[2]; ++i) {
            if (pos[i+1]-pos[i] > 0)
            {
                layers.push_back(i);
            }
        }
        cl->allocOp(dims, layers);
        /// Set grid \todo set once per operator kind
        ::QuICC::Internal::Array igrid;
        ::QuICC::Internal::Array iweights;
        using namespace QuICC::Transform::Worland;
        OpsQuadrature<@Kind@_t> quad;
        quad.computeQuadrature(igrid, iweights, pUval->dims[0]);
        // Populate op
        auto opView = cl->getOp();
        OpsBuilder<Top, @Kind@_t, @OpDirection@> tBuilder;
        tBuilder.compute(opView, igrid, iweights);
    }
    assert(cl->getOp().data() != nullptr);
    // call
    cl->apply(viewMod, viewVal);
    
};
#endif

#else

/// @brief C Interface to MLIR for a jw @Op@ operator of kind @Kind@
/// column major data, cpu operators
/// @param op
/// @param uval
/// @param umod
extern "C" void _ciface_quiccir_jw_@Op@_@Kind@_complexf64_DCCSC3D_complexf64_DCCSC3D(void* obj, view3_cd_t* pUmod, view3_cd_t* pUval)
{
    QuICC::Profiler::RegionFixture<3> fixTotal("MlirWorlandintShims");

    #ifndef NDEBUG
    std::cout <<
        "_ciface_quiccir_jw_@Op@_@Kind@_complexf64_DCCSC3D_complexf64_DCCSC3D\n";
    #endif
    assert(obj != nullptr);
    assert(pUval != nullptr);
    assert(pUmod != nullptr);
    // op
    using namespace QuICC::Transform::Quadrature;
    using Tin = C_DCCSC3D_t;
    using Tout = C_DCCSC3D_t;
    using Top = QuICC::View::View<double, QuICC::View::CSL3DJIK>;
    using backend_t = Cpu::ImplOp<Tout, Tin, Top>;
    using op_t = Op<Tout, Tin, Top, backend_t>;
    // views
    using namespace QuICC::View;
    constexpr std::uint32_t rank = 3;
    ViewBase<std::uint32_t> pointers[rank];
    pointers[1] = ViewBase<std::uint32_t>(pUmod->pos, pUmod->posSize);
    ViewBase<std::uint32_t> indices[rank];
    indices[1] = ViewBase<std::uint32_t>(pUmod->coo, pUmod->cooSize);
    /// \todo stronger check?
    assert(pUmod->posSize == pUval->posSize);
    assert(pUmod->cooSize == pUval->cooSize);
    Tin viewVal(pUval->data, pUval->dataSize, pUval->dims, pointers, indices);
    Tout viewMod(pUmod->data, pUmod->dataSize, pUmod->dims, pointers, indices);
    // Check that op was set up
    auto cl = reinterpret_cast<op_t*>(obj);
    if (cl->getOp().data() == nullptr)
    {
        QuICC::Profiler::RegionFixture<3> fixInit("MlirWorlandintShims-init");

        // dim 0 - N  - radial modes
        // dim 1 - Nr - radial points
        // dim 2 - L  - harmonic degree
        std::array<std::uint32_t, rank> dims {pUmod->dims[0], pUval->dims[0], pUmod->dims[2]};
        std::vector<std::uint32_t> layers;
        for (std::size_t i = 0; i < dims[2]; ++i) {
            if (pUmod->pos[i+1]-pUmod->pos[i] > 0)
            {
                layers.push_back(i);
            }
        }
        cl->allocOp(dims, layers);
        /// Set grid \todo set once per operator kind
        ::QuICC::Internal::Array igrid;
        ::QuICC::Internal::Array iweights;
        using namespace QuICC::Transform::Worland;
        OpsQuadrature<@Kind@_t> quad;
        quad.computeQuadrature(igrid, iweights, pUval->dims[0]);
        // Populate op
        auto opView = cl->getOp();
        OpsBuilder<Top, @Kind@_t, @OpDirection@> tBuilder;
        tBuilder.compute(opView, igrid, iweights);
    }
    assert(cl->getOp().data() != nullptr);
    // call
    cl->apply(viewMod, viewVal);
};
#endif
