/**
 * @file @Operator@Test.cpp
 * @brief Tests for the Worland @Operator@ DenseSM operator
 */


// System includes
//
#include <catch2/catch.hpp>
#include <iostream>

// Project includes
//
#include "TestSuite/DenseSM/Worland/TestArgs.hpp"
#include "DenseSM/Worland/@Operator@.hpp"
#include "QuICC/Polynomial/Worland/WorlandBase.hpp"
#include "QuICC/Bc/Name/FixedTemperature.hpp"

#include "QuICC/SparseSM/Worland/Stencil/Value.hpp"
#include "QuICC/Polynomial/Worland/Wnl.hpp"

namespace currentts = ::QuICC::TestSuite::DenseSM::Worland;

TEST_CASE( "Error for @Operator@ operator", "[@Operator@:@type@]" )
{

   // Set default arguments if required
   if(currentts::args().useDefault)
   {
      currentts::args().params = {0,1,2,3,4,10,11,12,13,14};
   }

   Catch::StringMaker<double>::precision = 15;

   // Set type
   currentts::args().setType("@type@");

   REQUIRE( currentts::args().params.size() > 0 );

   typedef ::QuICC::DenseSM::Worland::@Operator@ Operator;

   auto a = ::QuICC::Polynomial::Worland::WorlandBase::ALPHA_CHEBYSHEV;                                                                                                                           
   auto b = ::QuICC::Polynomial::Worland::WorlandBase::DBETA_CHEBYSHEV;

   int nN = 13;
   int oN = 7;
   int l = 1;
   Operator op(oN, ::QuICC::Bc::Name::FixedTemperature::id(), nN, nN, a, b, l);

   auto mat = op.mat();

   std::cerr << mat.rows() << " x " << mat.cols() << std::endl;
   std::cerr << mat << std::endl;

   ::QuICC::SparseSM::Worland::Stencil::Value S(nN, nN-1, a, b, l);
   auto bcIn = ::QuICC::Array::Random(nN-1);
   ::QuICC::Array in = S.mat()*bcIn;
   ::QuICC::Array out = mat*in;

   std::cerr << in.transpose() << std::endl;
   std::cerr << out.transpose() << std::endl;
}
