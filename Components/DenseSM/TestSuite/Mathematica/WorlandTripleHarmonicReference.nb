Cell[BoxData[{
 RowBox[{
  RowBox[{"IqProj", "[", 
   RowBox[{
   "q_", ",", "op_", ",", "lmo_", ",", "g_", ",", "lmi_", ",", "fA_", ",", 
    "fB_", ",", "lmf_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
