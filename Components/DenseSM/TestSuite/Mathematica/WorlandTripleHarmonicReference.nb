         RowBox[{
          RowBox[{"radFct", "=", 
           RowBox[{"radialFunctions", "[", 
            RowBox[{"[", 
             RowBox[{"fctBId", "+", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"lF", "=", 
           RowBox[{"radFct", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"mF", "=", 
           RowBox[{"radFct", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"fB", "=", 
           RowBox[{
            RowBox[{"radFct", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "[", 
            RowBox[{"r", ",", "lF"}], "]"}]}], ";"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fB", "=", "Null"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"name", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{
          RowBox[{"ToString", "[", "op", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<p\>\"", "->", "\"\<P\>\""}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"msg", "=", 
        RowBox[{
        "\"\<Exporting \>\"", "<>", "name", "<>", "\"\< operator \>\"", "<>", 
         
         RowBox[{"ToString", "[", 
          RowBox[{"outN", "+", "1"}], "]"}], "<>", "\"\< x \>\"", " ", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"inN", "+", "1"}], "]"}], " ", "<>", 
         "\"\< for \!\(\*SubscriptBox[\(l\), \(out\)]\) = \>\"", "<>", 
         RowBox[{"ToString", "[", "lOut", "]"}], "<>", 
         "\"\<, \!\(\*SubscriptBox[\(l\), \(F\)]\) = \>\"", "<>", 
         RowBox[{"ToString", "[", "lF", "]"}], "<>", 
         "\"\<, \!\(\*SubscriptBox[\(l\), \(in\)]\) = \>\"", "<>", 
         RowBox[{"ToString", "[", "lIn", "]"}], "<>", "\"\<...\>\""}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tempmsg", "=", 
        RowBox[{"PrintTemporary", "[", "msg", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Generate", " ", "metadata"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"fname", "=", 
        RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
         RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_meta.dat\>\""}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"descr", " ", "=", " ", 
        RowBox[{"createProjMetadata", "[", 
