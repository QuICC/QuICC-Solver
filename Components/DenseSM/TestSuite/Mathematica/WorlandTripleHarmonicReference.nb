          RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", "\[Alpha]", ",", 
        "d\[Beta]", ",", "False"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diff", "=", 
