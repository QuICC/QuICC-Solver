Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"createMetadata", "[", 
     RowBox[{
     "outN_", ",", " ", "inN_", ",", "q_", ",", "lOut_", ",", "mOut_", ",", 
      "lF_", ",", "mF_", ",", "lIn_", ",", "mIn_", ",", "fctId_", ",", 
      "\[Alpha]_", ",", "d\[Beta]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"header", "=", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
         "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
          "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
          "\"\<# line 2: output truncation\>\"", ",", " ", 
          "\[IndentingNewLine]", "\"\<# line 3: input truncation\>\"", ",", 
          "\[IndentingNewLine]", "\"\<# line 4: order of quasi-inverse\>\"", 
          ",", "\[IndentingNewLine]", 
          "\"\<# line 5: output harmonic degree\>\"", " ", ",", 
          "\[IndentingNewLine]", "\"\<# line 6: output harmonic order\>\"", 
          " ", ",", "\[IndentingNewLine]", 
          "\"\<# line 7: function F harmonic degree\>\"", " ", ",", 
          "\[IndentingNewLine]", 
          "\"\<# line 8: function F harmonic order\>\"", " ", ",", 
          "\[IndentingNewLine]", "\"\<# line 9: input harmonic degree\>\"", 
          ",", "\[IndentingNewLine]", 
          "\"\<# line 10: input harmonic order\>\"", ",", 
          "\[IndentingNewLine]", "\"\<# line 11: ID of function F\>\"", " ", 
          ",", "\[IndentingNewLine]", "\"\<# line 12: Jacobi alpha\>\"", " ", 
          ",", "\[IndentingNewLine]", 
          "\"\<# line 13: Jacobi dBeta: beta = l + dBeta\>\""}], " ", 
         "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"descr", " ", "=", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{
          "outN", ",", "inN", ",", "q", ",", "lOut", ",", "mOut", ",", "lF", 
           ",", "mF", ",", "lIn", ",", "mIn", ",", "fctId", ",", "\[Alpha]", 
           ",", "d\[Beta]"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"descr", " ", "=", " ", 
        RowBox[{"Prepend", "[", 
         RowBox[{"descr", ",", 
          RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"descr", " ", "=", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9470553641283293`*^9, 3.947055389614932*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"e2c28916-9cf1-4edb-9582-3d033976e52c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"refIqOperator", "[", 
   RowBox[{"meta_", ",", "op_", ",", "idN_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "name", ",", 
      RowBox[{"idx", "=", "1"}], ",", "outN", ",", "inN", ",", "q", ",", 
      "lOut", ",", "mOut", ",", "lF", ",", "mF", ",", "lIn", ",", "mIn", ",", 
      "fctId", ",", "radFct", ",", "\[Alpha]", ",", "d\[Beta]", ",", "mat", 
      ",", "msg", ",", "descr", ",", "tempmsg", ",", "fname"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"outN", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"inN", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lOut", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"mOut", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lIn", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"mIn", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fctId", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d\[Beta]", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"radFct", "=", 
      RowBox[{"radialFunctions", "[", 
       RowBox[{"[", 
        RowBox[{"fctId", "+", "1"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lF", "=", 
      RowBox[{"radFct", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mF", "=", 
      RowBox[{"radFct", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"name", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{
        RowBox[{"ToString", "[", "op", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<d\>\"", "->", "\"\<D\>\""}], ",", 
          RowBox[{"\"\<r\>\"", "->", "\"\<R\>\""}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"q", ">", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"name", "=", 
         RowBox[{"\"\<Iq\>\"", "<>", "name"}]}], ";"}]}], 
