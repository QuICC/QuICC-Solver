Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Gaunt", " ", "projections"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"projCurlPolCrossPolGQ", "[", 
     RowBox[{
     "nNr_", ",", "nNc_", ",", "lOut_", ",", "mOut_", ",", "lF_", ",", "mF_", 
      ",", "lIn_", ",", "mIn_", ",", "fA_", ",", "fB_", ",", "\[Alpha]_", ",",
       "d\[Beta]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mat", ",", 
        RowBox[{"ng", "=", 
         RowBox[{"3", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             RowBox[{"Max", "[", 
              RowBox[{"nNr", ",", "nNc"}], "]"}]}], "+", 
            RowBox[{"Max", "[", 
             RowBox[{"lOut", ",", "lF", ",", "lIn"}], "]"}]}], ")"}]}]}], ",",
         "wg", ",", "rg", ",", "L2o", ",", "L2f", ",", "L2i", ",", "rhs"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rg", "=", 
        RowBox[{"wgrid", "[", "ng", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"wg", "=", 
        RowBox[{"wweights", "[", "ng", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"L2o", "=", 
        RowBox[{"lOut", 
