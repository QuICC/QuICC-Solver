      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"lIn", " ", "=", " ", 
           RowBox[{"lOut", "+", "lShift"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"lIn", ">", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Do", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"fIds", "=", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "1"}], ",", 
                   RowBox[{"-", "1"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
                
                RowBox[{
                 RowBox[{"fIds", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "=", "fId"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"meta", "=", 
                 RowBox[{"makeMeta", "[", 
                  RowBox[{"nN", ",", "lOut", ",", "lIn", ",", 
                   RowBox[{"fIds", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                   RowBox[{"fIds", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"refProjection", "[", 
                 RowBox[{
                 "meta", ",", "projCurlPolCrossPolGQ", ",", "idN", ",", 
                  "\"\<ProjCurlPolCrossPol\>\""}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"refProjection", "[", 
                 RowBox[{
                 "meta", ",", "projCurlCurlTorCrossPolGQ", ",", "idN", ",", 
                  "\"\<ProjCurlCurlTorCrossPol\>\""}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"refProjection", "[", 
                 RowBox[{
                 "meta", ",", "projCurlCurlPolCrossTorGQ", ",", "idN", ",", 
                  "\"\<ProjCurlCurlPolCrossTor\>\""}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"refProjection", "[", 
                 RowBox[{
                 "meta", ",", "projCurlCurlCPolCrossPolGQ", ",", "idN", ",", 
                  "\"\<ProjCurlCurlCPolCrossPol\>\""}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Clear", "[", 
                 RowBox[{"meta", ",", "fIds"}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"idN", "++"}], ";"}], "\[IndentingNewLine]", ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"lShift", ",", "lShifts"}], "}"}]}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", " ", 
      RowBox[{"{", 
       RowBox[{"lOut", ",", " ", "lOuts"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Generated test IDs until \>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"idN", "-", "1"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{
    "makeMeta", ",", "fId", ",", "idN", ",", "nN", ",", "lOuts", ",", 
