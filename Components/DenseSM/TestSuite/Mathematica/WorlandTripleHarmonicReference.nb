           "\[IndentingNewLine]", "\"\<# line 10: ID of function Fa\>\"", " ",
            ",", "\[IndentingNewLine]", 
           "\"\<# line 11: ID of function Fb\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 12: Jacobi alpha\>\"", " ", ",",
            "\[IndentingNewLine]", 
           "\"\<# line 13: Jacobi dBeta: beta = l + dBeta\>\""}], " ", 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
