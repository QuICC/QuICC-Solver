Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "References", " ", "for", " ", "Elsasser", " ", "coefficienst", " ", 
    "with", " ", "dipolar", " ", "radial", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"makeMeta", "[", 
     RowBox[{"nN_", ",", "lOut_", ",", "lIn_", ",", "m_", ",", "fId_"}], 
     "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
     "nN", ",", "nN", ",", "lOut", ",", "m", ",", "lIn", ",", "m", ",", "fId",
       ",", "$w\[Alpha]", ",", "$wd\[Beta]"}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"configureGenerator", "[", "True", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fId", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nN", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ms", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lOuts", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "5", ",", "10"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lShifts", "=", 
     RowBox[{"{", "0", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"idN", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"lIn", " ", "=", " ", 
           RowBox[{"lOut", "+", "lShift"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"lIn", ">=", "m"}], " ", "&&", " ", 
                RowBox[{"lOut", " ", ">=", " ", "m"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"meta", "=", 
                 RowBox[{"makeMeta", "[", 
                  RowBox[{
                  "nN", ",", "lOut", ",", "lIn", ",", "m", ",", "fId"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                
                RowBox[{"refTripleHarmonic", "[", 
                 RowBox[{
                 "meta", ",", "divr1FGQ", ",", "idN", ",", "\"\<DivR1F\>\""}],
                  "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"refTripleHarmonic", "[", 
                 RowBox[{
                 "meta", ",", "divr1CFGQ", ",", "idN", ",", 
                  "\"\<DivR1CF\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"refTripleHarmonic", "[", 
                 RowBox[{
                 "meta", ",", "divr1FCGQ", ",", "idN", ",", 
                  "\"\<DivR1FC\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"refTripleHarmonic", "[", 
                 RowBox[{
                 "meta", ",", "divr2d1r1FGQ", ",", "idN", ",", 
                  "\"\<DivR2D1R1F\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"refTripleHarmonic", "[", 
                 RowBox[{
                 "meta", ",", "divr2Fd1r1GQ", ",", "idN", ",", 
                  "\"\<DivR2FD1R1\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"refTripleHarmonic", "[", 
                 RowBox[{
                 "meta", ",", "divr1d1divr1Fd1r1GQ", ",", "idN", ",", 
                  "\"\<DivR1D1DivR1FD1R1\>\""}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"refTripleHarmonic", "[", 
                 RowBox[{
                 "meta", ",", "divr1d1divr1d1r1FGQ", ",", "idN", ",", 
                  "\"\<DivR1D1DivR1D1R1F\>\""}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"refTripleHarmonic", "[", 
                 RowBox[{
                 "meta", ",", "divr3d1r1Fd1r1GQ", ",", "idN", ",", 
                  "\"\<DivR3D1R1FD1R1\>\""}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Clear", "[", 
                 RowBox[{"meta", ",", "lIn"}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"idN", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
             ";"}], "\[IndentingNewLine]", ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "ms"}], "}"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"lShift", ",", "lShifts"}], "}"}]}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", " ", 
      RowBox[{"{", 
       RowBox[{"lOut", ",", " ", "lOuts"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Generated test IDs until \>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"idN", "-", "1"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{
    "makeMeta", ",", "fId", ",", "idN", ",", "nN", ",", "lOuts", ",", 
     "lShifts", ",", "ms"}], "]"}]}]}]], "Input",
