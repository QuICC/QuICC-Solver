Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Gaunt", " ", "projections"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"projCurlCurlPolCrossTor", "[", 
     RowBox[{
     "lmo_", ",", "g_", ",", "lmi_", ",", "fA_", ",", "fB_", ",", "lmf_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"op", ",", 
        RowBox[{"n", "=", 
         RowBox[{"lmo", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"l", "=", 
         RowBox[{"lmi", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"k", "=", 
         RowBox[{"lmf", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", "L2o", ",", "L2f", ",", 
        "L2i", ",", "\[Gamma]", ",", "s1", ",", "s2"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"L2o", "=", 
        RowBox[{"n", 
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"L2f", "=", 
        RowBox[{"k", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"L2i", "=", 
        RowBox[{"l", 
         RowBox[{"(", 
          RowBox[{"l", "+", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
