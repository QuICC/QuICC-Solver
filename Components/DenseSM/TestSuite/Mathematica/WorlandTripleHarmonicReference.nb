     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"mIn", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
     RowBox[{"idx", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fctId", "=", 
