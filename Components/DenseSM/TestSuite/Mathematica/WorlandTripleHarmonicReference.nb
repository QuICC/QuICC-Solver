Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "References", " ", "for", " ", "Gaunt", " ", "projections", " ", "with", 
    " ", "quadrupolar", " ", "radial", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"makeMeta", "[", 
     RowBox[{"nN_", ",", "lOut_", ",", "lIn_", ",", "fAId_", ",", "fBId_"}], 
     "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
     "nN", ",", "nN", ",", "lOut", ",", "0", ",", "lIn", ",", "0", ",", 
      "fAId", ",", "fBId", ",", "$w\[Alpha]", ",", "$wd\[Beta]"}], "}"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"configureGenerator", "[", "True", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fId", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nN", "=", "10"}], ";"}], "\[IndentingNewLine]", 
