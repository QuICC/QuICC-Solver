         RowBox[{
          RowBox[{"s1", "=", 
           RowBox[{
            RowBox[{"-", "L2o"}], 
            FractionBox[
             RowBox[{"(", 
              RowBox[{"L2f", "+", "L2i", "-", "L2o"}], ")"}], "2"]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"s2", "=", 
