Cell[BoxData[
 RowBox[{
  RowBox[{"checkGQTriple", "[", 
   RowBox[{"meta_", ",", "op_", ",", "idN_", ",", 
    RowBox[{"show_", ":", "False"}]}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "outN", ",", "inN", ",", 
      
      RowBox[{"idx", "=", "1"}], ",", "q", ",", "lOut", ",", "mOut", ",", 
