        ",", "mIn", ",", "fctAId", ",", "fctBId", ",", "radFct", ",", "fA", 
        ",", "fB", ",", "\[Alpha]", ",", "d\[Beta]", ",", "mat", ",", "msg", 
        ",", "descr", ",", "tempmsg", ",", "fname", ",", "name"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"outN", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"inN", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"meta", "[", 
