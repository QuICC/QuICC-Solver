          RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", "\[Alpha]", ",", 
        "d\[Beta]", ",", "True"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"matGQ", "=", 
      RowBox[{"QIqOpMat", "[", 
       RowBox[{
        RowBox[{"outN", "+", "1"}], ",", 
        RowBox[{"inN", "+", "1"}], ",", "0", ",", "op", ",", "lOut", ",", 
