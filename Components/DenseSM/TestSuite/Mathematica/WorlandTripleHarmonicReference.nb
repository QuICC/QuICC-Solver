            RowBox[{"r", ",", "lF"}], "]"}]}], ";"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fB", "=", "Null"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"name", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{
          RowBox[{"ToString", "[", "op", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<p\>\"", "->", "\"\<P\>\""}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"msg", "=", 
        RowBox[{
        "\"\<Exporting \>\"", "<>", "name", "<>", "\"\< operator \>\"", "<>", 
         
         RowBox[{"ToString", "[", 
          RowBox[{"outN", "+", "1"}], "]"}], "<>", "\"\< x \>\"", " ", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"inN", "+", "1"}], "]"}], " ", "<>", 
         "\"\< for \!\(\*SubscriptBox[\(l\), \(out\)]\) = \>\"", "<>", 
         RowBox[{"ToString", "[", "lOut", "]"}], "<>", 
         "\"\<, \!\(\*SubscriptBox[\(l\), \(F\)]\) = \>\"", "<>", 
