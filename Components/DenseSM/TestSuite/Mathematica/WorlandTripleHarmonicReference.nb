                    "meta", ",", "projCurlCurlCPolCrossTorGQ", ",", "idN", 
                    ",", "\"\<ProjCurlCurlCPolCrossTor\>\""}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Clear", "[", 
                    RowBox[{"meta", ",", "fIds"}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"idN", "++"}], ";"}], "\[IndentingNewLine]", ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}], ";"}]}],
               "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
            ",", 
