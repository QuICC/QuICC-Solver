Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createProjMetadata", "[", 
      RowBox[{
      "outN_", ",", " ", "inN_", ",", "q_", ",", "lOut_", ",", "mOut_", ",", 
       "lF_", ",", "mF_", ",", "lIn_", ",", "mIn_", ",", "fctAId_", ",", 
       "fctBId_", ",", "\[Alpha]_", ",", "d\[Beta]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 2: output truncation\>\"", ",", " ", 
           "\[IndentingNewLine]", "\"\<# line 3: input truncation\>\"", ",", 
           "\[IndentingNewLine]", "\"\<# line 4: order of quasi-inverse\>\"", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 5: output harmonic degree\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 6: output harmonic order\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 7: function F harmonic degree\>\"", " ", ",", 
           "\[IndentingNewLine]", 
           "\"\<# line 8: function F harmonic order\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 9: input harmonic degree\>\"", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 10: input harmonic order\>\"", ",", 
           "\[IndentingNewLine]", "\"\<# line 11: ID of function Fa\>\"", " ",
            ",", "\[IndentingNewLine]", 
           "\"\<# line 12: ID of function Fb\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 13: Jacobi alpha\>\"", " ", ",",
            "\[IndentingNewLine]", 
           "\"\<# line 14: Jacobi dBeta: beta = l + dBeta\>\""}], " ", 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
           "outN", ",", "inN", ",", "q", ",", "lOut", ",", "mOut", ",", "lF", 
            ",", "mF", ",", "lIn", ",", "mIn", ",", "fctAId", ",", "fctBId", 
            ",", "\[Alpha]", ",", "d\[Beta]"}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"refProjection", "[", 
     RowBox[{"meta_", ",", "op_", ",", "idN_"}], "]"}], ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"outprec", " ", "=", " ", "32"}], ",", "outN", ",", "inN", 
        ",", "q", ",", "lOut", ",", "mOut", ",", "lF", ",", "mF", ",", "lIn", 
        ",", "mIn", ",", "fctAId", ",", "fctBId", ",", "radFct", ",", "fA", 
        ",", "fB", ",", "\[Alpha]", ",", "d\[Beta]", ",", "mat", ",", "msg", 
        ",", "descr", ",", "tempmsg", ",", "fname", ",", "name"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"outN", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"inN", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lOut", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mOut", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lIn", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mIn", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "7", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fctAId", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "8", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
