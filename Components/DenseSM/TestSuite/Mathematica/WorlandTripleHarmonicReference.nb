 RowBox[{
  RowBox[{"gaunt3J", "[", 
   RowBox[{"lma_", ",", "lmb_", ",", "lmg_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"la", "=", 
       RowBox[{"lma", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"ma", "=", 
       RowBox[{"lma", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"lb", "=", 
       RowBox[{"lmb", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"mb", "=", 
       RowBox[{"lmb", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"lg", "=", 
       RowBox[{"lmg", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"mg", "=", 
       RowBox[{"lmg", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", "coeff"}], "}"}], ",", 
    RowBox[{
     RowBox[{"coeff", "=", 
      RowBox[{
       SqrtBox[
        FractionBox[
