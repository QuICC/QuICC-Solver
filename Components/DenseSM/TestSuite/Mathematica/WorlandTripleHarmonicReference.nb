                    RowBox[{"fIds", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "=", "fId"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"meta", "=", 
                    RowBox[{"makeMeta", "[", 
                    RowBox[{"nN", ",", "lOut", ",", "lIn", ",", "m", ",", 
                    RowBox[{"fIds", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"fIds", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
                   "\[IndentingNewLine]", "\[IndentingNewLine]", 
                   RowBox[{"refProjection", "[", 
                    RowBox[{
                    "meta", ",", "projCurlTorCrossPolGQ", ",", "idN", ",", 
                    "\"\<ProjCurlTorCrossPol\>\""}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"refProjection", "[", 
                    RowBox[{
                    "meta", ",", "projCurlPolCrossTorGQ", ",", "idN", ",", 
                    "\"\<ProjCurlPolCrossTor\>\""}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"refProjection", "[", 
                    RowBox[{
                    "meta", ",", "projCurlCPolCrossPolGQ", ",", "idN", ",", 
                    "\"\<ProjCurlCPolCrossPol\>\""}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"refProjection", "[", 
                    RowBox[{
                    "meta", ",", "projCurlCurlTorCrossTorGQ", ",", "idN", 
                    ",", "\"\<ProjCurlCurlTorCrossTor\>\""}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"refProjection", "[", 
                    RowBox[{
                    "meta", ",", "projCurlCurlPolCrossPolGQ", ",", "idN", 
