            RowBox[{"i", ",", "0", ",", 
             RowBox[{"nNr", "-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"nNc", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
       "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xg", "=", 
         RowBox[{"chebgrid", "[", "ng", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rg", "=", 
         RowBox[{
          RowBox[{"a", " ", "xg"}], " ", "+", "b"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wg", "=", 
         RowBox[{"chebweights", "[", "ng", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rhs", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"tmp", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"QIqOp", "[", 
                RowBox[{"q", ",", "p", ",", "op", ",", 
                 RowBox[{"Tnab", "[", 
                  RowBox[{"j", ",", "a", ",", "b", ",", "r"}], "]"}], ",", 
                 "lIn", ",", 
                 RowBox[{"f", "[", 
                  RowBox[{"r", ",", "lF"}], "]"}], ",", "lF", ",", "r"}], 
                "]"}], ")"}], "/.", 
              RowBox[{"{", 
               RowBox[{"r", "->", "rg"}], "}"}]}]}], ";", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"ListQ", "[", "tmp", "]"}]}], ",", 
              RowBox[{
               RowBox[{"tmp", " ", "=", 
                RowBox[{"tmp", " ", "+", " ", 
                 RowBox[{"0", " ", "xg"}]}]}], ";"}]}], "]"}], ";", "tmp"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"nNc", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
