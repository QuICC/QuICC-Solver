Cell[BoxData[{
 RowBox[{
  RowBox[{"la", " ", "=", " ", "4"}], ";", " ", 
  RowBox[{"lb", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"lg", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ma", "=", 
   RowBox[{"-", "1"}]}], ";", 
  RowBox[{"mb", "=", "1"}], ";", 
  RowBox[{"mg", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"s1", "=", 
  RowBox[{
   RowBox[{"elsasser3J", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"la", ",", "ma"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"lb", ",", "mb"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"lg", ",", "mg"}], "}"}]}], "]"}], "//", 
   "N"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["1", 
       RowBox[{"ma", "+", "mb", "-", "mg"}]]}], 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"SphericalHarmonicY", "[", 
              RowBox[{"la", ",", "ma", ",", "\[Theta]", ",", "\[Phi]"}], 
              "]"}], ",", "\[Theta]"}], "]"}], 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"SphericalHarmonicY", "[", 
              RowBox[{"lb", ",", "mb", ",", "\[Theta]", ",", "\[Phi]"}], 
              "]"}], ",", "\[Phi]"}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"SphericalHarmonicY", "[", 
              RowBox[{"la", ",", "ma", ",", "\[Theta]", ",", "\[Phi]"}], 
              "]"}], ",", "\[Phi]"}], "]"}], 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"SphericalHarmonicY", "[", 
              RowBox[{"lb", ",", "mb", ",", "\[Theta]", ",", "\[Phi]"}], 
              "]"}], ",", "\[Theta]"}], "]"}]}]}], ")"}], 
        RowBox[{"Conjugate", "[", 
         RowBox[{"SphericalHarmonicY", "[", 
          RowBox[{"lg", ",", "mg", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
         "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]}], "//", "N"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"s1", " ", 
  SqrtBox[
   RowBox[{"4", "\[Pi]"}]]}], "\[IndentingNewLine]", 
 RowBox[{"s2", " ", 
  SqrtBox[
   RowBox[{"4", "\[Pi]"}]]}]}], "Input",
