Cell[BoxData[
 RowBox[{
  RowBox[{"r2divr2FIntg", "[", 
   RowBox[{
   "nNr_", ",", "nNc_", ",", "lOut_", ",", "lF_", ",", "lIn_", ",", "f_", ",",
     "lb_", ",", "ub_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mat", ",", "a", ",", "b"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "=", 
      RowBox[{"abSphere", "[", 
       RowBox[{"lb", "/", "ub"}], "]"}]}], ";", 
     RowBox[{"mat", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"2", " ", "a"}], 
          RowBox[{" ", "\[Pi]"}]], 
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{
            FractionBox["1", 
             SqrtBox[
              RowBox[{"1", "-", 
               SuperscriptBox["x", "2"]}]]], 
            RowBox[{"ChebyshevT", "[", 
             RowBox[{"i", ",", "x"}], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"f", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"a", " ", "x"}], " ", "+", "b"}], ",", "lF"}], "]"}], 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"j", "==", "0"}], ",", "1", ",", "2"}], "]"}], 
              RowBox[{"ChebyshevT", "[", 
               RowBox[{"j", ",", "x"}], "]"}]}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"nNr", "-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", 
          RowBox[{"nNc", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "mat"}]}], "]"}]}]], "Input",
 CellLabel->
