         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"lhs", "=", 
             RowBox[{"wg", " ", 
              RowBox[{"ChebyshevT", "[", 
               RowBox[{"i", ",", "xg"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Dot", "[", 
               RowBox[{"lhs", ",", 
                RowBox[{"rhs", "[", 
