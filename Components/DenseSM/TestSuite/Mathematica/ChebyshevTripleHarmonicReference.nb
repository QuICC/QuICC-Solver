Cell[BoxData[
 RowBox[{
  RowBox[{"QIqOpMat", "[", 
   RowBox[{
   "nNr_", ",", "nNc_", ",", "q_", ",", "p_", ",", "op_", ",", "lOut_", ",", 
    "lF_", ",", "lIn_", ",", "f_", ",", "lb_", ",", "ub_", ",", 
    RowBox[{"analytic_", ":", "False"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mat", ",", "a", ",", "b", ",", 
      RowBox[{"ng", "=", 
       RowBox[{"chebgridN", "[", 
        RowBox[{"nNr", ",", "nNc", ",", "lOut", ",", "lF", ",", "lIn"}], 
        "]"}]}], ",", "wg", ",", "xg", ",", "rg", ",", "lhs", ",", "rhs", ",",
       "tmp"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "=", 
      RowBox[{"abSphere", "[", 
       RowBox[{"lb", "/", "ub"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"analytic", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rhs", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"tmp", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"QIqOp", "[", 
                RowBox[{"q", ",", "p", ",", "op", ",", 
                 RowBox[{"Tnab", "[", 
                  RowBox[{"j", ",", "a", ",", "b", ",", "r"}], "]"}], ",", 
                 "lIn", ",", 
                 RowBox[{"f", "[", 
                  RowBox[{"r", ",", "lF"}], "]"}], ",", "lF", ",", "r"}], 
                "]"}], ")"}], "/.", 
              RowBox[{"{", 
               RowBox[{"r", "->", 
                RowBox[{
                 RowBox[{"a", " ", "x"}], " ", "+", "b"}]}], "}"}]}]}], ";", 
            "tmp"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"nNc", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mat", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            FractionBox[
             RowBox[{"2", " ", "a"}], 
             RowBox[{" ", "\[Pi]"}]], 
            RowBox[{"Integrate", "[", 
             RowBox[{
              RowBox[{
               FractionBox["1", 
                SqrtBox[
                 RowBox[{"1", "-", 
                  SuperscriptBox["x", "2"]}]]], 
               RowBox[{"ChebyshevT", "[", 
                RowBox[{"i", ",", "x"}], "]"}], 
               RowBox[{"rhs", "[", 
                RowBox[{"[", 
                 RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ",", 
