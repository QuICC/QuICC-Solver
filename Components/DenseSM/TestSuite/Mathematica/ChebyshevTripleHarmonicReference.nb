Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "References", " ", "for", " ", "anelastic", " ", "operator", " ", 
    "coefficients", " ", "with", " ", "polytropic", " ", "radial", " ", 
    "functions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "copied", " ", "from", " ", "the", " ", "Gaunt", " ", "coefficient", " ", 
    "version"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"makeMeta", "[", 
     RowBox[{
     "nN_", ",", "q_", ",", "p_", ",", "lOut_", ",", "lIn_", ",", "m_", ",", 
      "fId_", ",", "\[Chi]_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
     "nN", ",", "nN", ",", "q", ",", "p", ",", "lOut", ",", "m", ",", "lIn", 
      ",", "m", ",", "fId", ",", 
      FractionBox["\[Chi]", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Chi]"}], ")"}]], ",", 
      FractionBox["1", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Chi]"}], ")"}]]}], "}"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"configureGenerator", "[", "True", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fId", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nN", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lOuts", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "5", ",", "10"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lShifts", "=", 
     RowBox[{"{", "0", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Chi]", "=", 
     FractionBox["7", "20"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"qs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], ";"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"no", " ", "Iq", " ", "operators", " ", "tested", " ", "yet"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qs", " ", "=", 
     RowBox[{"{", "0", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"block", " ", "with", " ", "p"}], "=", "1"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"idN", "=", 
        RowBox[{
         RowBox[{"1000", "q"}], "+", "400"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"lIn", " ", "=", " ", 
              RowBox[{"lOut", "+", "lShift"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"lIn", ">", "0"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"meta", "=", 
                 RowBox[{"makeMeta", "[", 
                  RowBox[{
                  "nN", ",", "q", ",", "1", ",", "lOut", ",", "lIn", ",", "0",
                    ",", "fId", ",", "\[Chi]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"ops", "=", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"divr1F", ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"Fd1", ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"Fd2", ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"Fd3", ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"Fd4", ",", "1"}], "}"}]}], "}"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Do", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"q", "==", "0"}], "||", 
                    RowBox[{"q", ">=", 
                    RowBox[{"op", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"refIqRpOperator", "[", 
                    RowBox[{"meta", ",", 
                    RowBox[{"op", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "idN"}], "]"}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
                  "\[IndentingNewLine]", ",", 
                  RowBox[{"{", 
                   RowBox[{"op", ",", "ops"}], "}"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Clear", "[", "meta", "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"idN", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"Clear", "[", "lIn", "]"}], ";"}], "\[IndentingNewLine]",
             ",", 
            RowBox[{"{", 
             RowBox[{"lShift", ",", "lShifts"}], "}"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"lOut", ",", " ", "lOuts"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Generated test IDs until \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"idN", "-", "1"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"block", " ", "with", " ", "p"}], "=", "4"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"sidN", "=", "idN"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"lIn", " ", "=", " ", 
              RowBox[{"lOut", "+", "lShift"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"lIn", ">", "0"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"meta", "=", 
                 RowBox[{"makeMeta", "[", 
                  RowBox[{
                  "nN", ",", "q", ",", "4", ",", "lOut", ",", "lIn", ",", "0",
                    ",", "fId", ",", "\[Chi]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"ops", "=", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"divr1F", ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"Fd1", ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"Fd2", ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"Fd3", ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"Fd4", ",", "1"}], "}"}]}], "}"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Do", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"q", "==", "0"}], "||", 
                    RowBox[{"q", ">=", 
                    RowBox[{"op", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"refIqRpOperator", "[", 
                    RowBox[{"meta", ",", 
                    RowBox[{"op", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "idN"}], "]"}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
                  "\[IndentingNewLine]", ",", 
                  RowBox[{"{", 
                   RowBox[{"op", ",", "ops"}], "}"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Clear", "[", "meta", "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"idN", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"Clear", "[", "lIn", "]"}], ";"}], "\[IndentingNewLine]",
             ",", 
            RowBox[{"{", 
             RowBox[{"lShift", ",", "lShifts"}], "}"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"lOut", ",", " ", "lOuts"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Generated test IDs from \>\"", "<>", 
         RowBox[{"ToString", "[", "sidN", "]"}], "<>", "\"\< until \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"idN", "-", "1"}], "]"}]}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"q", ",", "qs"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{
    "makeMeta", ",", "fId", ",", "idN", ",", "sidN", ",", "\[Chi]", ",", "nN",
      ",", "lOuts", ",", "lShifts", ",", "qs"}], "]"}]}]}]], "Input",
