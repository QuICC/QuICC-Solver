Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "References", " ", "for", " ", "anelastic", " ", "operator", " ", 
    "coefficients", " ", "with", " ", "quadrupolar", " ", "radial", " ", 
    "functions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "copied", " ", "from", " ", "the", " ", "Gaunt", " ", "coefficients", " ", 
    "version"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"makeMeta", "[", 
     RowBox[{
     "nN_", ",", "q_", ",", "p_", ",", "lOut_", ",", "lIn_", ",", "m_", ",", 
      "fId_", ",", "\[Chi]_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
     "nN", ",", "nN", ",", "q", ",", "p", ",", "lOut", ",", "m", ",", "lIn", 
      ",", "m", ",", "fId", ",", 
      FractionBox["\[Chi]", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Chi]"}], ")"}]], ",", 
      FractionBox["1", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Chi]"}], ")"}]]}], "}"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"configureGenerator", "[", "True", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fId", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nN", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lOuts", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "5", ",", "10"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lShifts", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "0", ",", "2"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Chi]", "=", 
     FractionBox["7", "20"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"qs", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], ";"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "no", " ", "Iq", " ", "are", " ", "tested", " ", "for", " ", "now"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qs", "=", 
     RowBox[{"{", "0", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"idN", "=", 
