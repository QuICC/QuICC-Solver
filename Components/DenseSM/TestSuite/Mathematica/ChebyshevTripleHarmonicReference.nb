Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format"}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createIqMetadata", "[", 
      RowBox[{
      "outN_", ",", " ", "inN_", ",", "q_", ",", "p_", ",", "lOut_", ",", 
       "mOut_", ",", "lF_", ",", "mF_", ",", "lIn_", ",", "mIn_", ",", 
       "fctId_", ",", "lb_", ",", "ub_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 2: output truncation\>\"", ",", " ", 
           "\[IndentingNewLine]", "\"\<# line 3: input truncation\>\"", ",", 
           "\[IndentingNewLine]", "\"\<# line 4: order of quasi-inverse\>\"", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 5: power of radial prefactor\>\"", ",", 
           "\[IndentingNewLine]", "\"\<# line 6: output harmonic degree\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 7: output harmonic order\>\"", " ", ",", 
           "\[IndentingNewLine]", 
           "\"\<# line 8: function F harmonic degree\>\"", " ", ",", 
           "\[IndentingNewLine]", 
           "\"\<# line 9: function F harmonic order\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 10: input harmonic degree\>\"", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 11: input harmonic order\>\"", ",", 
           "\[IndentingNewLine]", "\"\<# line 12: ID of function F\>\"", " ", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 13: lower bound of linear map r = ax + b\>\"", " ", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 14: upper bound of linear map r = ax + b\>\""}], " ", 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
           "outN", ",", "inN", ",", "q", ",", "p", ",", "lOut", ",", "mOut", 
            ",", "lF", ",", "mF", ",", "lIn", ",", "mIn", ",", "fctId", ",", 
            "lb", ",", "ub"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"refIqRpOperator", "[", 
     RowBox[{"meta_", ",", "op_", ",", "idN_"}], "]"}], ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"outprec", " ", "=", " ", "32"}], ",", "name", ",", "outN", 
        ",", "inN", ",", "q", ",", "p", ",", "lOut", ",", "mOut", ",", "lF", 
        ",", "mF", ",", "lIn", ",", "mIn", ",", "fctId", ",", "radFct", ",", 
        "lb", ",", "ub", ",", "mat", ",", "msg", ",", "descr", ",", "tempmsg",
         ",", "fname"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"outN", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"inN", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lOut", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mOut", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lIn", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "7", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mIn", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "8", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fctId", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "9", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lb", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "10", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ub", "=", 
        RowBox[{"meta", "[", 
         RowBox[{"[", "11", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"radFct", "=", 
        RowBox[{"radialFunctions", "[", 
         RowBox[{"[", 
          RowBox[{"fctId", "+", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"lF", "=", 
        RowBox[{"radFct", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mF", "=", 
        RowBox[{"radFct", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"name", "=", 
        RowBox[{"\"\<Rp\>\"", "<>", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"ToString", "[", "op", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<d\>\"", "->", "\"\<D\>\""}], ",", 
             RowBox[{"\"\<r\>\"", "->", "\"\<R\>\""}]}], "}"}]}], "]"}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"q", ">", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"name", "=", 
           RowBox[{"\"\<Iq\>\"", "<>", "name"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"msg", "=", 
        RowBox[{
        "\"\<Exporting \>\"", "<>", "name", "<>", "\"\< operator \>\"", "<>", 
         
         RowBox[{"ToString", "[", 
          RowBox[{"outN", "+", "1"}], "]"}], "<>", "\"\< x \>\"", " ", "<>", 
         RowBox[{"ToString", "[", 
