Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "References", " ", "for", " ", "Elsasser", " ", "coefficient", " ", "with",
     " ", "dipolar", " ", "radial", " ", "functions"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"makeMeta", "[", 
     RowBox[{"nN_", ",", "lOut_", ",", "lIn_", ",", "fId_", ",", "\[Chi]_"}], 
     "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
     "nN", ",", "nN", ",", "lOut", ",", "0", ",", "lIn", ",", "0", ",", "fId",
       ",", 
      FractionBox["\[Chi]", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Chi]"}], ")"}]], ",", 
      FractionBox["1", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Chi]"}], ")"}]]}], "}"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"configureGenerator", "[", "True", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fId", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nN", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lOuts", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "5", ",", "10"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lShifts", "=", 
     RowBox[{"{", "0", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Chi]", "=", 
     FractionBox["7", "20"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"idN", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"lIn", "=", 
           RowBox[{"lOut", "+", "lShift"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"lIn", ">", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"meta", "=", 
              RowBox[{"makeMeta", "[", 
               RowBox[{
               "nN", ",", "lOut", ",", "lIn", ",", "fId", ",", "\[Chi]"}], 
               "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"refTripleHarmonic", "[", 
              RowBox[{
              "meta", ",", "r2divr1FGQ", ",", "idN", ",", 
               "\"\<R2DivR1F\>\""}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"refTripleHarmonic", "[", 
              RowBox[{
              "meta", ",", "r4divr1FGQ", ",", "idN", ",", 
               "\"\<R4DivR1F\>\""}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"refTripleHarmonic", "[", 
              RowBox[{
              "meta", ",", "r4divr1FCGQ", ",", "idN", ",", 
               "\"\<R4DivR1FC\>\""}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"refTripleHarmonic", "[", 
              RowBox[{
              "meta", ",", "r4divr1CFGQ", ",", "idN", ",", 
