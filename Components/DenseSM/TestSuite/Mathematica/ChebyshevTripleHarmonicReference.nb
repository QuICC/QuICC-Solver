Cell[BoxData[
 RowBox[{
  RowBox[{"checkTripleGQ", "[", 
   RowBox[{"meta_", ",", "name_", ",", "idN_", ",", 
    RowBox[{"show_", ":", "False"}]}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "outN", ",", "inN", ",", 
