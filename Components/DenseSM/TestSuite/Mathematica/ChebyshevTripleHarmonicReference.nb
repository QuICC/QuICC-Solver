        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"matDiff", "//", "N"}], "//", "MatrixForm"}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"NotebookDelete", "[", "tempmsg", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"msg", ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"\"\< Done(\>\"", "<>", 
            RowBox[{"DateString", "[", "]"}], "<>", "\"\<)\>\""}], ",", 
           RowBox[{"FontColor", "\[Rule]", "Green"}]}], "]"}]}], "}"}], "]"}],
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "matDiff", "]"}], "]"}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
