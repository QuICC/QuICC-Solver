                  RowBox[{"j", ",", "1", ",", "s\[Alpha]", ",", 
                   RowBox[{"s\[Beta]", "-", "1"}], ",", "s"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"s", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
             RowBox[{"{", 
