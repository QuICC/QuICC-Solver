Cell[BoxData[
 RowBox[{
  RowBox[{"refTor2GridS", "[", 
   RowBox[{"meta_", ",", "idN_", ",", "name_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "maxN", ",", "maxL", ",",
       "s\[Alpha]", ",", "s\[Beta]", ",", "isTriangular", ",", "op", ",", 
      "msg", ",", "descr", ",", "tempmsg", ",", "fname"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"maxN", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"maxL", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s\[Alpha]", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s\[Beta]", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"isTriangular", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"msg", "=", 
      RowBox[{
      "\"\<Exporting \>\"", "<>", "name", "<>", 
       "\"\< Tor2GridS operator for N = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<, L = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxL", "]"}], "<>", "\"\<...\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tempmsg", "=", 
      RowBox[{"PrintTemporary", "[", "msg", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "metadata"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fname", "=", 
      RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
       RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_meta.dat\>\""}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"descr", " ", "=", " ", 
      RowBox[{"createMetadataTor2GridS", "[", 
       RowBox[{"maxN", ",", "maxL", ",", 
        RowBox[{"N", "[", 
         RowBox[{"$w\[Alpha]", ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"$wd\[Beta]", ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"s\[Alpha]", ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"s\[Beta]", ",", "outprec"}], "]"}], ",", "isTriangular"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
        "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "operator"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"generateRefData", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"op", "=", 
         RowBox[{"tor2GridS", "[", 
          RowBox[{
          "maxN", ",", "maxL", ",", " ", "s\[Alpha]", ",", "s\[Beta]", ",", 
           "isTriangular"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"op", ",", "outprec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
          RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_ref.dat\>\""}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", "op"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "tempmsg", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"msg", ",", 
            RowBox[{"Style", "[", 
