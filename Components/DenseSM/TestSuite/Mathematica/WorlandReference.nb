Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format", " ", "for", " ", "Tor2GridS"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataTor2GridS", "[", 
      RowBox[{
      "maxN_", ",", "maxL_", ",", "\[Alpha]_", ",", "d\[Beta]_", ",", 
       "s\[Alpha]_", ",", "s\[Beta]_", ",", "isTriangular_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", " ", 
           "\"\<# line 3: harmonic degree truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 4: Worland Jacobi alpha\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 5: Worland Jacobi dBeta: beta = l + dBeta \>\"", " ", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 6: S grid Jacobi Alpha\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 7: S grid Jacobi Beta\>\"", " ",
            ",", "\[IndentingNewLine]", "\"\<# line 8: isTriangular\>\""}], 
          " ", "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
           "maxN", ",", "maxL", ",", "\[Alpha]", ",", "d\[Beta]", ",", 
            "s\[Alpha]", ",", "s\[Beta]", ",", 
            RowBox[{"Boole", "[", "isTriangular", "]"}]}], "}"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cylTruncNs", "[", 
     RowBox[{"nR_", ",", "nL_", ",", " ", "isTriangular_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{"isTriangular", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nL", "+", "2"}], ")"}], "-", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"nL", "+", "2"}], ",", "2"}], "]"}]}], "2"], " ", "+", 
         " ", "3"}], "]"}], " ", "+", " ", "1"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nL", "-", "1"}], ")"}], "-", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"nL", "-", "1"}], ",", "2"}], "]"}]}], "2"], "+", "nR", 
         "+", "1"}], "]"}], "+", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cylTruncNz", "[", 
     RowBox[{"nR_", ",", "nL_", ",", " ", "isTriangular_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{"isTriangular", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nL", "-", "1"}], ")"}], "-", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"nL", "-", "1"}], ",", "2"}], "]"}]}], "2"], " ", "+", 
         " ", "2"}], "]"}], " ", "+", " ", "1"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nL", "-", "1"}], ")"}], "-", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"nL", "-", "1"}], ",", "2"}], "]"}]}], "2"], "+", "nR", 
         "+", "1"}], "]"}], "+", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cylTruncNug", "[", 
     RowBox[{"nR_", ",", "nL_", ",", " ", "isTriangular_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{"isTriangular", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"nL", "-", "2"}], ")"}], "-", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"nL", "-", "2"}], ",", "2"}], "]"}]}], "2"], "]"}], " ", 
       "+", " ", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"nL", "-", "2"}], ")"}], "-", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"nL", "-", "2"}], ",", "2"}], "]"}]}], "2"], "]"}], "+", 
       "nR"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"truncMaxNug", "[", 
     RowBox[{
     "nN_", ",", "nL_", ",", "maxNug_", ",", "l_", ",", "isTriangular_"}], 
     "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{"isTriangular", ",", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"l", ",", "2"}], "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"-", "1"}], ",", "\[IndentingNewLine]", 
        RowBox[{"maxNug", "-", 
         RowBox[{"(", 
          FractionBox[
           RowBox[{"l", "-", "1"}], "2"], ")"}]}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"nN", "-", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dLegendreP", "[", 
      RowBox[{"l_", ",", "m_", ",", "t_"}], "]"}], "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"LegendreP", "[", 
        RowBox[{"l", ",", "m", ",", "t"}], "]"}], ",", "t"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dPlm", "[", 
     RowBox[{"l_", ",", "m_", ",", "t_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      SqrtBox[
       RowBox[{"1", "-", 
        SuperscriptBox["t", "2"]}]]}], 
     RowBox[{
      RowBox[{"dLegendreP", "[", 
       RowBox[{"l", ",", "m", ",", "t"}], "]"}], "/", 
      RowBox[{"(", 
       SqrtBox[
        RowBox[{"2", "\[Pi]", 
         FractionBox[
          RowBox[{"2", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "+", "m"}], ")"}], "!"}]}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "l"}], "+", "1"}], ")"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "-", "m"}], ")"}], "!"}]}]]}]], ")"}]}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"jgrid", "[", 
      RowBox[{"n_", ",", "a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{"x", "/.", 
      RowBox[{"{", 
       RowBox[{"ToRules", "[", 
        RowBox[{"NRoots", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"JacobiP", "[", 
            RowBox[{"n", ",", "a", ",", "b", ",", "x"}], "]"}], "\[Equal]", 
           "0"}], ",", "x", ",", 
          RowBox[{"PrecisionGoal", "\[Rule]", "$mpprec"}]}], "]"}], "]"}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dP", "[", 
      RowBox[{"n_", ",", "a_", ",", "b_", ",", "x_"}], "]"}], "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"JacobiP", "[", 
         RowBox[{"n", ",", "a", ",", "b", ",", "x"}], "]"}], ",", "x"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"jweights", "[", 
      RowBox[{"n_", ",", "a_", ",", "b_", ",", "g_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"2", "n"}], "+", "a", "+", "b", "+", "2"}], 
        RowBox[{"n", "+", "a", "+", "b", "+", "1"}]]}], 
      FractionBox[
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"n", "+", "a", "+", "1"}], "]"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"n", "+", "b", "+", "1"}], "]"}]}], 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"n", "+", "a", "+", "b", "+", "1"}], "]"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"n", "+", "2"}], "]"}]}]], 
      FractionBox[
       SuperscriptBox["2", 
        RowBox[{"a", "+", "b"}]], 
       RowBox[{
        RowBox[{"dP", "[", 
         RowBox[{"n", ",", "a", ",", "b", ",", 
          RowBox[{"g", "[", 
           RowBox[{"n", ",", "a", ",", "b"}], "]"}]}], "]"}], 
        RowBox[{"JacobiP", "[", 
         RowBox[{
          RowBox[{"n", "+", "1"}], ",", "a", ",", "b", ",", 
          RowBox[{"g", "[", 
           RowBox[{"n", ",", "a", ",", "b"}], "]"}]}], "]"}]}]]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tor2GridS", "[", 
     RowBox[{
     "maxN_", ",", "maxL_", ",", " ", "s\[Alpha]_", ",", "s\[Beta]_", ",", 
      "isTriangular_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nS", ",", "nZ", ",", "nNug", ",", "zg", ",", "zw", ",", "sxg", ",", 
        "sg", ",", "bs", ",", "l", ",", "maxNl", ",", "bOp", ",", "s", ",", 
        "rg", ",", "ctg", ",", "wOp", ",", "pOp", ",", "op"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nS", "=", 
        RowBox[{"cylTruncNs", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nZ", "=", 
        RowBox[{"cylTruncNz", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nNug", "=", 
        RowBox[{"cylTruncNug", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zg", " ", "=", " ", 
        RowBox[{
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"nZ", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zw", "=", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{
          RowBox[{"GaussianQuadratureWeights", "[", 
           RowBox[{"nZ", ",", 
            RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sxg", "=", 
        RowBox[{"jgrid", "[", 
         RowBox[{"nS", ",", "s\[Alpha]", ",", 
          RowBox[{"s\[Beta]", "-", "1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sg", "=", 
        SqrtBox[
         FractionBox[
          RowBox[{"sxg", "+", "1"}], "2"]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bs", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"l", "=", "0"}], ",", 
         RowBox[{"l", "<=", " ", "maxL"}], ",", " ", 
         RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"maxNl", "=", 
           RowBox[{"truncMaxNug", "[", 
            RowBox[{
             RowBox[{"maxN", "+", "1"}], ",", 
             RowBox[{"maxL", "+", "1"}], ",", 
             RowBox[{"nNug", "-", "1"}], ",", "l", ",", "isTriangular"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"bOp", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nS"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"maxN", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"l", ",", "2"}], "]"}], "==", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"k", "=", "1"}], ",", 
               RowBox[{"k", "<=", " ", 
                RowBox[{"Length", "@", "sg"}]}], ",", 
               RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"s", "=", 
                 RowBox[{"sg", "[", 
                  RowBox[{"[", "k", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"rg", "=", 
                 SqrtBox[
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{"1", "-", 
                    SuperscriptBox["s", "2"]}]], "zg"}], ")"}], "2"], "+", 
                   SuperscriptBox["s", "2"]}]]}], ";", "\[IndentingNewLine]", 
                
                RowBox[{"ctg", "=", " ", 
                 FractionBox[
                  RowBox[{
                   SqrtBox[
                    RowBox[{"1", "-", 
                    SuperscriptBox["s", "2"]}]], "zg"}], "rg"]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"wOp", "=", 
                 RowBox[{"Transpose", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Wnl", "[", 
                    RowBox[{"n", ",", "l", ",", "rg"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"n", ",", "0", ",", "maxNl"}], "}"}]}], "]"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"pOp", "=", 
                 RowBox[{"dPlm", "[", 
                  RowBox[{"l", ",", "0", ",", "ctg"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"bOp", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", 
                    RowBox[{"1", ";;", 
                    RowBox[{"maxNl", "+", "1"}]}]}], "]"}], "]"}], "=", 
                 RowBox[{"-", 
                  RowBox[{
                   RowBox[{"Transpose", "[", 
                    RowBox[{"zw", "*", "pOp"}], "]"}], ".", "wOp"}]}]}], 
                ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"bs", ",", "bOp"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"op", "=", 
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", "bs", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "op"}]}], "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
