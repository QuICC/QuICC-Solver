                    RowBox[{"zw", "*", "pOp"}], "]"}], ".", "wOp"}]}]}], 
                ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"bOp", "=", 
              RowBox[{"ugOp", ".", "bOpS"}]}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";", "\[IndentingNewLine]", 
