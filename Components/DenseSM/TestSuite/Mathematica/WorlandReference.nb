Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format", " ", "for", " ", "Geostrophic2Tor"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataGeostrophic2Tor", "[", 
      RowBox[{
      "maxN_", ",", "maxL_", ",", "\[Alpha]_", ",", "d\[Beta]_", ",", 
       "s\[Alpha]_", ",", "s\[Beta]_", ",", "isGeneric_", ",", 
       "isTriangular_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", " ", 
           "\"\<# line 3: harmonic degree truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 4: Worland Jacobi alpha\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 5: Worland Jacobi dBeta: beta = l + dBeta \>\"", " ", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 6: S grid Jacobi Alpha\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 7: S grid Jacobi Beta\>\"", " ",
            ",", "\[IndentingNewLine]", "\"\<# line 8: isGeneric\>\"", " ", 
           ",", "\[IndentingNewLine]", "\"\<# line 9: isTriangular\>\""}], 
          " ", "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
           "maxN", ",", "maxL", ",", "\[Alpha]", ",", "d\[Beta]", ",", 
            "s\[Alpha]", ",", "s\[Beta]", ",", 
            RowBox[{"Boole", "[", "isGeneric", "]"}], ",", 
            RowBox[{"Boole", "[", "isTriangular", "]"}]}], "}"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cylTruncNr", "[", 
     RowBox[{"nL_", ",", " ", "isTriangular_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{"isTriangular", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nL", "+", "1"}], ")"}], "-", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"nL", "+", "1"}], ",", "2"}], "]"}]}], "2"], "+", "2"}], 
        "]"}], " ", "+", " ", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"nL", "+", "1", "+", "2"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Cn", "[", "n_", "]"}], ":=", 
    SqrtBox[
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "n"}], "+", "3"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", "n"}], "+", "5"}], ")"}]}], 
      RowBox[{"8", "\[Pi]", 
       RowBox[{"(", 
        RowBox[{"n", "+", "1"}], ")"}]}]]]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Cnab", "[", 
     RowBox[{"n_", ",", "a_", ",", "b_"}], "]"}], ":=", 
    SqrtBox[
     FractionBox[
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "n"}], "+", "a", "+", "b", "+", "1"}], ")"}], 
       RowBox[{"Gamma", "[", 
        RowBox[{"n", "+", "a", "+", "b", "+", "1"}], "]"}], 
       RowBox[{"Gamma", "[", 
        RowBox[{"n", "+", "1"}], "]"}]}], 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"n", "+", "a", "+", "1"}], "]"}], 
       RowBox[{"Gamma", "[", 
        RowBox[{"n", "+", "b", "+", "1"}], "]"}]}]]]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"geostrophic2Tor", "[", 
     RowBox[{
     "maxN_", ",", "maxL_", ",", "s\[Alpha]_", ",", "s\[Beta]_", ",", 
      "isGeneric_", ",", "isTriangular_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nR", ",", "nNug", ",", "wg", ",", "ww", ",", "maxNl", ",", "wOp", ",",
         "nT", ",", "tg", ",", "tw", ",", "pOp", ",", "sg", ",", "invLaplh", 
        ",", "op", ",", "n", ",", "c", ",", "tOp", ",", "k", ",", "ugOp", ",",
         "l", ",", "tmp"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nR", "=", 
        RowBox[{"cylTruncNr", "[", 
         RowBox[{
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nNug", "=", 
        RowBox[{"cylTruncNug", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wg", "=", 
        RowBox[{"wgrid", "[", "nR", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ww", "=", 
        RowBox[{"wweights", "[", "nR", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxNl", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"truncMaxNug", "[", 
           RowBox[{
            RowBox[{"maxN", "+", "1"}], ",", 
            RowBox[{"maxL", "+", "1"}], ",", 
            RowBox[{"nNug", "-", "1"}], ",", "l", ",", "isTriangular"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "0", ",", "maxL"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wOp", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"l", ",", "2"}], "]"}], "==", "1"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"ww", " ", 
               RowBox[{"Wnl", "[", 
                RowBox[{"n", ",", "l", ",", "wg"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "0", ",", 
                RowBox[{"Min", "[", 
                 RowBox[{
                  RowBox[{"maxNl", "[", 
                   RowBox[{"[", 
                    RowBox[{"l", "+", "1"}], "]"}], "]"}], ",", "maxN"}], 
                 "]"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "0", ",", "maxL"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nT", "=", 
        RowBox[{"IntegerPart", "[", 
         RowBox[{"3", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"maxL", "+", "2"}], ")"}], "/", "2"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tg", " ", "=", " ", 
        RowBox[{
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"nT", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tw", "=", 
        RowBox[{
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"nT", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pOp", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"tw", " ", 
           RowBox[{"dPlm", "[", 
            RowBox[{"l", ",", "0", ",", "tg"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "0", ",", "maxL"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"invLaplh", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"l", ">", "0"}], ",", 
            FractionBox["1", 
             RowBox[{"l", 
              RowBox[{"(", 
               RowBox[{"l", "+", "1"}], ")"}]}]], ",", "0"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "0", ",", "maxL"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"op", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"maxN", "+", "1"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"maxL", "+", "1"}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "nNug"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"n", "=", "0"}], ",", 
         RowBox[{"n", "<", "nNug"}], ",", 
         RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{"isGeneric", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"c", "=", 
              SuperscriptBox["2", 
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{"s\[Alpha]", "+", "2"}], ")"}]}]]}], ";"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"c", "=", 
              RowBox[{"2", "\[Pi]", 
               FractionBox[
                RowBox[{"Cn", "[", "n", "]"}], 
                RowBox[{"Cnab", "[", 
                 RowBox[{"n", ",", "s\[Alpha]", ",", "s\[Beta]"}], "]"}]]}]}],
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tOp", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nR"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"maxL", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"k", "=", "1"}], ",", 
            RowBox[{"k", "<=", " ", "nR"}], ",", 
            RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"sg", "=", 
              RowBox[{
               RowBox[{"wg", "[", 
                RowBox[{"[", "k", "]"}], "]"}], 
               RowBox[{"Sin", "[", 
                RowBox[{"ArcCos", "[", "tg", "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"ugOp", "=", 
              RowBox[{"c", " ", 
               RowBox[{"Wnlab", "[", 
                RowBox[{"n", ",", "1", ",", "s\[Alpha]", ",", 
                 RowBox[{"s\[Beta]", "-", "1"}], ",", "sg"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"tOp", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", ";;"}], "]"}], "]"}], "=", 
              RowBox[{"-", 
               RowBox[{
                RowBox[{"DiagonalMatrix", "[", "invLaplh", "]"}], ".", "pOp", 
                ".", "ugOp"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"l", "=", "0"}], ",", 
            RowBox[{"l", "<", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"2", " ", "n"}], " ", "+", " ", "2"}], ",", 
               RowBox[{"maxL", "+", "1"}]}], "]"}]}], ",", 
            RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"l", ",", "2"}], "]"}], "==", "1"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"tmp", "=", 
                 RowBox[{
                  RowBox[{"wOp", "[", 
                   RowBox[{"[", 
                    RowBox[{"l", "+", "1"}], "]"}], "]"}], ".", 
                  RowBox[{"tOp", "[", 
                   RowBox[{"[", 
                    RowBox[{";;", ",", 
                    RowBox[{"l", "+", "1"}]}], "]"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"op", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"l", 
                    RowBox[{"(", 
                    RowBox[{"maxN", "+", "1"}], ")"}]}], "+", "1"}], ";;", 
                    RowBox[{
                    RowBox[{"l", 
                    RowBox[{"(", 
                    RowBox[{"maxN", "+", "1"}], ")"}]}], "+", 
                    RowBox[{
                    RowBox[{"Dimensions", "[", "tmp", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
                    RowBox[{"n", "+", "1"}]}], "]"}], "]"}], "=", "tmp"}], 
                ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "op"}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.921831250651967*^9, {3.921893799643091*^9, 3.92189390085954*^9}, {
   3.921896806613146*^9, 3.921896907190342*^9}, {3.921909271004073*^9, 
   3.921909274612501*^9}, {3.9219093648006*^9, 3.92190938574407*^9}, {
   3.921909508234075*^9, 3.921909584049718*^9}, {3.922161437672329*^9, 
   3.922161535143229*^9}, {3.9223504246441383`*^9, 3.922350427482976*^9}, {
   3.922408827272464*^9, 3.922408932783845*^9}, {3.922503931225172*^9, 
   3.922503931515356*^9}},ExpressionUUID->"d499b62b-fc8b-412a-9c82-\
cb3d91f8719e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"refGeostrophic2Tor", "[", 
   RowBox[{"meta_", ",", "idN_", ",", "name_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "maxN", ",", "maxL", ",",
       "s\[Alpha]", ",", "s\[Beta]", ",", "isGeneric", ",", "isTriangular", 
      ",", "op", ",", "tmp", ",", "msg", ",", "descr", ",", "tempmsg", ",", 
      "fname"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"maxN", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"maxL", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s\[Alpha]", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s\[Beta]", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"isGeneric", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"isTriangular", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"msg", "=", 
      RowBox[{
      "\"\<Exporting \>\"", "<>", "name", "<>", 
       "\"\< Geostrophic2Tor operator for N = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<, L = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxL", "]"}], "<>", "\"\<...\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tempmsg", "=", 
      RowBox[{"PrintTemporary", "[", "msg", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "metadata"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fname", "=", 
      RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
       RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_meta.dat\>\""}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"descr", " ", "=", " ", 
      RowBox[{"createMetadataGeostrophic2Tor", "[", 
       RowBox[{"maxN", ",", "maxL", ",", 
        RowBox[{"N", "[", 
         RowBox[{"$w\[Alpha]", ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"$wd\[Beta]", ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"s\[Alpha]", ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"s\[Beta]", ",", "outprec"}], "]"}], ",", "isGeneric", ",", 
        "isTriangular"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
        "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "operator"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"generateRefData", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"op", "=", 
         RowBox[{"geostrophic2Tor", "[", 
          RowBox[{
          "maxN", ",", "maxL", ",", "s\[Alpha]", ",", "s\[Beta]", ",", 
           "isGeneric", ",", "isTriangular"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"op", ",", "outprec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
          RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_ref.dat\>\""}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", "op"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "tempmsg", "]"}], ";", 
