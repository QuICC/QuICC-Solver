  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataGeostrophicEnergy", "[", 
      RowBox[{
      "maxN_", ",", "maxL_", ",", "s\[Alpha]_", ",", "s\[Beta]_", ",", 
       "isGeneric_", ",", "isTriangular_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", " ", 
           "\"\<# line 3: harmonic degree truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 4: S grid Jacobi Alpha\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 5: S grid Jacobi Beta\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 6: isGeneric\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 7: isTriangular\>\""}], " ", 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
           "maxN", ",", "maxL", ",", "s\[Alpha]", ",", "s\[Beta]", ",", 
            RowBox[{"Boole", "[", "isGeneric", "]"}], ",", 
            RowBox[{"Boole", "[", "isTriangular", "]"}]}], "}"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
