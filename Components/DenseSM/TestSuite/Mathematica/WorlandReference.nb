       RowBox[{"zg", " ", "=", " ", 
        RowBox[{
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"nZ", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zw", "=", 
