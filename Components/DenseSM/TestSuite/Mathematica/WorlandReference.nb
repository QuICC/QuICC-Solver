     RowBox[{
      RowBox[{"{", 
       RowBox[{"op", ",", "nNug"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nNug", "=", 
        RowBox[{"cylTruncNug", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
