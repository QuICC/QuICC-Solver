Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format", " ", "for", " ", "Tor2EGeostrophic"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataTor2EGeostrophic", "[", 
      RowBox[{
      "maxN_", ",", "maxL_", ",", "\[Alpha]_", ",", "d\[Beta]_", ",", 
       "s\[Alpha]_", ",", "s\[Beta]_", ",", "isGeneric_", ",", "b\[Alpha]_", 
       ",", "b\[Beta]_", ",", "isTriangular_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", " ", 
           "\"\<# line 3: harmonic degree truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 4: Worland Jacobi alpha\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 5: Worland Jacobi dBeta: beta = l + dBeta \>\"", " ", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 6: S grid Jacobi Alpha\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 7: S grid Jacobi Beta\>\"", " ",
            ",", "\[IndentingNewLine]", "\"\<# line 8: isGeneric\>\"", " ", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 9: Second basis Jacobi Alpha\>\"", " ", ",", 
           "\[IndentingNewLine]", 
           "\"\<# line 10: Second basis Jacobi Beta\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 11: isTriangular\>\""}], " ", 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
           "maxN", ",", "maxL", ",", "\[Alpha]", ",", "d\[Beta]", ",", 
            "s\[Alpha]", ",", "s\[Beta]", ",", 
            RowBox[{"Boole", "[", "isGeneric", "]"}], ",", "b\[Alpha]", ",", 
            "b\[Beta]", ",", 
            RowBox[{"Boole", "[", "isTriangular", "]"}]}], "}"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tor2EGeostrophic", "[", 
     RowBox[{
