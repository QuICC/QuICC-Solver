Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format", " ", "for", " ", "Tor2Geostrophic"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataTor2Geostrophic", "[", 
      RowBox[{
      "maxN_", ",", "maxL_", ",", "\[Alpha]_", ",", "d\[Beta]_", ",", 
       "s\[Alpha]_", ",", "s\[Beta]_", ",", "isGeneric_", ",", 
       "isTriangular_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", " ", 
           "\"\<# line 3: harmonic degree truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 4: Worland Jacobi alpha\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 5: Worland Jacobi dBeta: beta = l + dBeta \>\"", " ", 
           ",", "\[IndentingNewLine]", 
           "\"\<# line 6: S grid Jacobi Alpha\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 7: S grid Jacobi Beta\>\"", " ",
            ",", "\[IndentingNewLine]", "\"\<# line 8: isGeneric\>\"", " ", 
           ",", "\[IndentingNewLine]", "\"\<# line 9: isTriangular\>\""}], 
          " ", "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
           "maxN", ",", "maxL", ",", "\[Alpha]", ",", "d\[Beta]", ",", 
            "s\[Alpha]", ",", "s\[Beta]", ",", 
            RowBox[{"Boole", "[", "isGeneric", "]"}], ",", 
            RowBox[{"Boole", "[", "isTriangular", "]"}]}], "}"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Wnlab", "[", 
     RowBox[{"n_", ",", "l_", ",", "\[Alpha]_", ",", "d\[Beta]_", ",", "r_"}],
      "]"}], ":=", 
    RowBox[{
     RowBox[{"r", "^", "l"}], " ", 
     RowBox[{
      RowBox[{"JacobiP", "[", 
       RowBox[{"n", ",", "\[Alpha]", ",", 
        RowBox[{"l", "+", "d\[Beta]"}], ",", 
        RowBox[{
         RowBox[{"2", 
          RowBox[{"r", "^", "2"}]}], "-", "1"}]}], "]"}], "/", 
      RowBox[{"wnorm", "[", 
       RowBox[{"n", ",", "\[Alpha]", ",", 
        RowBox[{"l", "+", "d\[Beta]"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tor2Geostrophic", "[", 
     RowBox[{
     "maxN_", ",", "maxL_", ",", "s\[Alpha]_", ",", "s\[Beta]_", ",", 
      "isGeneric_", ",", "isTriangular_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nS", ",", "nZ", ",", "nNug", ",", "zg", ",", "zw", ",", "sxg", ",", 
        "sw", ",", "sg", ",", "ugOp", ",", "bs", ",", "l", ",", "maxNl", ",", 
        "bOp", ",", "bOpS", ",", "s", ",", "rg", ",", "ctg", ",", "wOp", ",", 
        "pOp", ",", "op"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nS", "=", 
        RowBox[{"cylTruncNs", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nZ", "=", 
        RowBox[{"cylTruncNz", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nNug", "=", 
        RowBox[{"cylTruncNug", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zg", " ", "=", " ", 
        RowBox[{
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"nZ", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zw", "=", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{
          RowBox[{"GaussianQuadratureWeights", "[", 
           RowBox[{"nZ", ",", 
            RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sxg", "=", 
        RowBox[{"jgrid", "[", 
         RowBox[{"nS", ",", "s\[Alpha]", ",", 
          RowBox[{"s\[Beta]", "-", "1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sw", "=", 
        RowBox[{"jweights", "[", 
         RowBox[{"nS", ",", "s\[Alpha]", ",", 
          RowBox[{"s\[Beta]", "-", "1"}], ",", "jgrid"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sg", "=", 
        SqrtBox[
         FractionBox[
          RowBox[{"sxg", "+", "1"}], "2"]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"isGeneric", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ugOp", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              SuperscriptBox["2", 
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{"s\[Alpha]", "+", "2"}], ")"}]}]], "sw", " ", 
              RowBox[{"Wnlab", "[", 
               RowBox[{"n", ",", "1", ",", "s\[Alpha]", ",", 
                RowBox[{"s\[Beta]", "-", "1"}], ",", "sg"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "0", ",", 
               RowBox[{"nNug", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ugOp", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"4", "\[Pi]"}], 
               SuperscriptBox["2", 
                RowBox[{"s\[Alpha]", "+", "2"}]]], " ", 
              FractionBox[
               RowBox[{"Cn", "[", "n", "]"}], 
               RowBox[{"Cnab", "[", 
                RowBox[{"n", ",", "s\[Alpha]", ",", "s\[Beta]"}], "]"}]], 
              "sw", " ", 
              RowBox[{"Wnlab", "[", 
               RowBox[{"n", ",", "1", ",", "s\[Alpha]", ",", 
                RowBox[{"s\[Beta]", "-", "1"}], ",", "sg"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "0", ",", 
               RowBox[{"nNug", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"bs", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"l", "=", "0"}], ",", 
         RowBox[{"l", "<=", " ", "maxL"}], ",", " ", 
         RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"maxNl", "=", 
           RowBox[{"truncMaxNug", "[", 
            RowBox[{
             RowBox[{"maxN", "+", "1"}], ",", 
             RowBox[{"maxL", "+", "1"}], ",", 
             RowBox[{"nNug", "-", "1"}], ",", "l", ",", "isTriangular"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"bOp", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nNug"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"maxN", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"l", ",", "2"}], "]"}], "==", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"bOpS", "=", 
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "1", ",", "nS"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", 
                  RowBox[{"maxN", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"k", "=", "1"}], ",", 
               RowBox[{"k", "<=", " ", 
                RowBox[{"Length", "@", "sg"}]}], ",", 
               RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"s", "=", 
                 RowBox[{"sg", "[", 
                  RowBox[{"[", "k", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"rg", "=", 
                 SqrtBox[
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{"1", "-", 
                    SuperscriptBox["s", "2"]}]], "zg"}], ")"}], "2"], "+", 
                   SuperscriptBox["s", "2"]}]]}], ";", "\[IndentingNewLine]", 
                
                RowBox[{"ctg", "=", " ", 
                 FractionBox[
                  RowBox[{
                   SqrtBox[
                    RowBox[{"1", "-", 
                    SuperscriptBox["s", "2"]}]], "zg"}], "rg"]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"wOp", "=", 
                 RowBox[{"Transpose", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Wnl", "[", 
                    RowBox[{"n", ",", "l", ",", "rg"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"n", ",", "0", ",", "maxNl"}], "}"}]}], "]"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"pOp", "=", 
                 RowBox[{"dPlm", "[", 
                  RowBox[{"l", ",", "0", ",", "ctg"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"bOpS", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", 
                    RowBox[{"1", ";;", 
                    RowBox[{"maxNl", "+", "1"}]}]}], "]"}], "]"}], "=", 
                 RowBox[{"-", 
