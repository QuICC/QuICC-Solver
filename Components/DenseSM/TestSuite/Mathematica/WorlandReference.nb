      "isGeneric_", ",", " ", "b\[Alpha]_", ",", "b\[Beta]_", ",", 
      "isTriangular_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nS", ",", "nZ", ",", "nNug", ",", "zg", ",", "zw", ",", "sxg", ",", 
