          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sxg", "=", 
        RowBox[{"jgrid", "[", 
         RowBox[{"nS", ",", "s\[Alpha]", ",", 
