        "maxNl", ",", "bs", ",", "bOp", ",", "bOpS", ",", "s", ",", "rg", ",",
         "ctg", ",", "wOp", ",", "pOp", ",", "op"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nS", "=", 
        RowBox[{"cylTruncNs", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nZ", "=", 
        RowBox[{"cylTruncNz", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}], ",", "isTriangular"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nNug", "=", 
        RowBox[{"cylTruncNug", "[", 
