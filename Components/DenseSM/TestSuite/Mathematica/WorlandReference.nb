Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
   "Metadata", " ", "format", " ", "for", " ", "GeostrophicAngularMomentum"}],
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataGeostrophicAngularMomentum", "[", 
      RowBox[{
      "maxN_", ",", "s\[Alpha]_", ",", "s\[Beta]_", ",", "isGeneric_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 3: S grid Jacobi Alpha\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 4: S grid Jacobi Beta\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 5: isGeneric\>\""}], " ", 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"maxN", ",", "s\[Alpha]", ",", "s\[Beta]", ",", 
            RowBox[{"Boole", "[", "isGeneric", "]"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"geostrophicAngularMomentum", "[", 
     RowBox[{
     "maxN_", ",", "s\[Alpha]_", ",", "s\[Beta]_", ",", "isGeneric_"}], "]"}],
     ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"op", ",", "nR", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"op", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "maxN"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"isGeneric", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "0"}], ",", 
            RowBox[{"j", "<", 
             RowBox[{"maxN", "+", "1"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"op", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", 
              RowBox[{"4", "\[Pi]", " ", 
               RowBox[{"Integrate", "[", 
                RowBox[{
                 RowBox[{"s", " ", 
                  RowBox[{"Wnlab", "[", 
                   RowBox[{"j", ",", "1", ",", "s\[Alpha]", ",", 
                    RowBox[{"s\[Beta]", "-", "1"}], ",", "s"}], "]"}], " ", 
                  "s", " ", 
                  SqrtBox[
                   RowBox[{"1", "-", 
                    SuperscriptBox["s", "2"]}]]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"s", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"op", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", "1"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "op"}]}], 
     "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
