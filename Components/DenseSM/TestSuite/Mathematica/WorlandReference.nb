Cell[BoxData[
 RowBox[{
  RowBox[{"refop", "[", 
   RowBox[{"meta_", ",", "opfunc_", ",", "bcfunc_", ",", "name_"}], "]"}], ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "idN", ",", "i", ",", 
      "outN", ",", "bcId", ",", "maxN", ",", "l", ",", " ", "gridN", ",", 
      "lg", ",", "lw", ",", "matW", ",", "matS", ",", " ", "op", ",", "msg", 
      ",", "descr", ",", "tempmsg", ",", "fname"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"i", "\[LessEqual]", " ", 
        RowBox[{"Length", "[", "meta", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"idN", "=", 
         RowBox[{"$idBase", "+", "i", "-", "1"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"outN", "=", 
         RowBox[{"meta", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"bcId", "=", 
         RowBox[{"meta", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxN", "=", 
         RowBox[{"meta", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"l", "=", 
         RowBox[{"meta", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "4"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"msg", "=", 
         RowBox[{
         "\"\<Exporting \>\"", "<>", "name", "<>", 
          "\"\< Worland operator for N = \>\"", "<>", 
          RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<, l = \>\"", "<>", 
          RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<...\>\""}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tempmsg", "=", 
         RowBox[{"PrintTemporary", "[", "msg", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Generate", " ", "metadata"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
          RowBox[{"ToString", "[", "idN", "]"}], "<>", 
          "\"\<_meta.dat\>\""}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"createMetadata", "[", 
          RowBox[{"outN", ",", "bcId", ",", "maxN", ",", 
           RowBox[{"N", "[", 
            RowBox[{"$w\[Alpha]", ",", "outprec"}], "]"}], ",", 
           RowBox[{"N", "[", 
            RowBox[{"$wd\[Beta]", ",", "outprec"}], "]"}], ",", "l"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Generate", " ", "operator"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"generateRefData", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"gridN", "=", 
            RowBox[{
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"maxN", "+", "1"}], ")"}]}], "+", "l"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"gridN", "=", 
            RowBox[{"gridN", "+", "2", "+", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"gridN", "+", "2"}], ",", "2"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"lg", " ", "=", " ", 
            RowBox[{"wleggrid", "[", "gridN", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"lw", "=", 
            RowBox[{"wlegweights", "[", "gridN", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"matW", " ", "=", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Dot", "[", 
                RowBox[{"lw", " ", ",", 
                 RowBox[{"opfunc", "[", 
                  RowBox[{"i", ",", "j", ",", "l", ",", "lg"}], "]"}]}], 
                "]"}], "+", 
               RowBox[{"bcfunc", "[", 
                RowBox[{"i", ",", "j", ",", "l"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "0", ",", "outN"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "0", ",", "maxN"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Switch", "[", 
            RowBox[{"bcId", ",", " ", "\[IndentingNewLine]", "0", ",", 
             RowBox[{
              RowBox[{"matS", "=", 
               RowBox[{"valueStencil", "[", 
                RowBox[{"outN", ",", "l"}], "]"}]}], ";"}], ",", 
             "\[IndentingNewLine]", "1", ",", 
             RowBox[{
              RowBox[{"matS", "=", 
               RowBox[{"d1Stencil", "[", 
                RowBox[{"outN", ",", "l"}], "]"}]}], ";"}], ",", 
             "\[IndentingNewLine]", "2", ",", 
             RowBox[{
              RowBox[{"matS", "=", 
               RowBox[{"insulatingStencil", "[", 
                RowBox[{"outN", ",", "l"}], "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"op", " ", "=", " ", 
            RowBox[{"matS", ".", 
             RowBox[{"Inverse", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", "matS", "]"}], ".", 
               RowBox[{"matW", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"1", ";;", 
                   RowBox[{"outN", "+", "1"}]}], ",", 
                  RowBox[{"1", ";;", 
                   RowBox[{"outN", "+", "1"}]}]}], "]"}], "]"}], ".", 
               "matS"}], "]"}], ".", 
             RowBox[{"Transpose", "[", "matS", "]"}], ".", "matW"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"op", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"DiagonalMatrix", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"i", ">", "outN"}], ",", "0", ",", "1"}], "]"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "0", ",", "maxN"}], "}"}]}], "]"}], "]"}],
               "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"1", ";;"}], ",", 
                RowBox[{"1", ";;", 
                 RowBox[{"outN", "+", "1"}]}]}], "]"}], "]"}], ".", "op"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"op", " ", "=", " ", 
            RowBox[{"N", "[", 
             RowBox[{"op", ",", "outprec"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"fname", "=", 
            RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
             RowBox[{"ToString", "[", "idN", "]"}], "<>", 
             "\"\<_ref.dat\>\""}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Export", "[", 
            RowBox[{
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"{", 
                RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], 
               "]"}], "]"}], ",", "op"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"NotebookDelete", "[", "tempmsg", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"msg", ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\< Done(\>\"", "<>", 
                  RowBox[{"DateString", "[", "]"}], "<>", "\"\<)\>\""}], ",", 
                 
                 RowBox[{"FontColor", "\[Rule]", "Green"}]}], "]"}]}], "}"}], 
             "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
