          RowBox[{"ToString", "[", "idN", "]"}], "<>", 
          "\"\<_meta.dat\>\""}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"createCoriolisMetadata", "[", 
          RowBox[{"outDNu", ",", "inDNu", ",", "maxN", ",", "l"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Generate", " ", "operator"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"generateRefData", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ref", "=", 
            RowBox[{"Transpose", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"opfunc", "[", 
                RowBox[{"j", ",", 
                 RowBox[{"maxN", "+", "1"}], ",", "l", ",", "bgrid", ",", 
                 "bweights", ",", "outDNu", ",", "inDNu"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "0", ",", "maxN"}], "}"}]}], "]"}], "]"}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"ref", " ", "=", " ", 
            RowBox[{"N", "[", 
