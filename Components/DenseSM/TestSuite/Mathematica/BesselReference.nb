Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format", " ", "for", " ", "Tor2Geostrophic"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataTor2Geostrophic", "[", 
      RowBox[{"maxN_", ",", "maxL_", ",", "d\[Nu]_", ",", "sd\[Nu]_"}], "]"}],
      ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", " ", 
           "\"\<# line 3: harmonic degree truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 4: Toroidal Bessel d\[Nu]\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 5: S grid Bessel d\[Nu]\>\""}], " ", 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"maxN", ",", "maxL", ",", "d\[Nu]", ",", "sd\[Nu]"}], 
           "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tor2Geostrophic", "[", 
     RowBox[{"maxN_", ",", "maxL_", ",", "d\[Nu]_", ",", "sd\[Nu]_"}], "]"}], 
    ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nS", ",", "nZ", ",", "nNug", ",", "zg", ",", "zw", ",", "sw", ",", 
        "sg", ",", "ugOp", ",", "bs", ",", "l", ",", "maxNl", ",", "bOp", ",",
         "bOpS", ",", "k", ",", "s", ",", "rg", ",", "ctg", ",", "wOp", ",", 
        "pOp", ",", "op"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nS", "=", 
        RowBox[{"cylTruncNs", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nZ", "=", 
        RowBox[{"cylTruncNz", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nNug", "=", 
        RowBox[{"cylTruncNug", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"zg", " ", "=", " ", 
        RowBox[{
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"nZ", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zw", "=", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{
          RowBox[{"GaussianQuadratureWeights", "[", 
           RowBox[{"nZ", ",", 
            RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sw", "=", 
        RowBox[{"bweights", "[", "nS", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sg", "=", 
        RowBox[{"bgrid", "[", "nS", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ugOp", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"sw", " ", 
           RowBox[{"InsulatingSphJnl", "[", 
            RowBox[{"n", ",", "1", ",", "sg"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", 
            RowBox[{"nNug", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bs", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"l", "=", "0"}], ",", 
         RowBox[{"l", "<=", " ", "maxL"}], ",", " ", 
         RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"maxNl", "=", "maxN"}], ";", "\[IndentingNewLine]", 
          RowBox[{"bOp", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nNug"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"maxN", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"l", ",", "2"}], "]"}], "==", "1"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"bOpS", "=", 
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "1", ",", "nS"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", 
                  RowBox[{"maxN", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"k", "=", "1"}], ",", 
               RowBox[{"k", "<=", " ", 
                RowBox[{"Length", "@", "sg"}]}], ",", 
               RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"s", "=", 
                 RowBox[{"sg", "[", 
                  RowBox[{"[", "k", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"rg", "=", 
                 SqrtBox[
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{"1", "-", 
                    SuperscriptBox["s", "2"]}]], "zg"}], ")"}], "2"], "+", 
                   SuperscriptBox["s", "2"]}]]}], ";", "\[IndentingNewLine]", 
                
                RowBox[{"ctg", "=", " ", 
                 FractionBox[
                  RowBox[{
                   SqrtBox[
                    RowBox[{"1", "-", 
                    SuperscriptBox["s", "2"]}]], "zg"}], "rg"]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"wOp", "=", 
                 RowBox[{"Transpose", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"$Jnl", "[", 
                    RowBox[{"n", ",", "l", ",", "rg"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"n", ",", "0", ",", "maxNl"}], "}"}]}], "]"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"pOp", "=", 
                 RowBox[{"dPlm", "[", 
                  RowBox[{"l", ",", "0", ",", "ctg"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"bOpS", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", 
                    RowBox[{"1", ";;", 
                    RowBox[{"maxNl", "+", "1"}]}]}], "]"}], "]"}], "=", 
                 RowBox[{"-", 
                  RowBox[{
                   RowBox[{"Transpose", "[", 
                    RowBox[{"zw", "*", "pOp"}], "]"}], ".", "wOp"}]}]}], 
                ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"bOp", "=", 
              RowBox[{"ugOp", ".", "bOpS"}]}], ";"}]}], "\[IndentingNewLine]",
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"bs", ",", "bOp"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"op", "=", 
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", "bs", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "op"}]}], "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{
