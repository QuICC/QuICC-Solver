          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxN", "=", 
         RowBox[{"meta", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"l", "=", 
         RowBox[{"meta", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "4"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"msg", "=", 
         RowBox[{
         "\"\<Exporting \>\"", "<>", "name", "<>", 
          "\"\< Bessel operator for N = \>\"", "<>", 
          RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<, l = \>\"", "<>", 
          RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<...\>\""}]}], ";", 
        "\[IndentingNewLine]", 
