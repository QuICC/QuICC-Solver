       RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_meta.dat\>\""}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"descr", " ", "=", " ", 
      RowBox[{"createMetadataGeostrophicEnergy", "[", 
       RowBox[{"maxN", ",", "maxL", ",", 
        RowBox[{"N", "[", 
         RowBox[{"sd\[Nu]", ",", "outprec"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"Flatten", "[", 
