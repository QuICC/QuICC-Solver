               RowBox[{"{", 
                RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], 
               "]"}], "]"}], ",", "ref"}], "]"}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"NotebookDelete", "[", "tempmsg", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"msg", ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\< Done(\>\"", "<>", 
                  RowBox[{"DateString", "[", "]"}], "<>", "\"\<)\>\""}], ",", 
                 
                 RowBox[{"FontColor", "\[Rule]", "Green"}]}], "]"}]}], "}"}], 
             "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
