Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format", " ", "for", " ", "Geostrophic2Tor"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataGeostrophic2Tor", "[", 
      RowBox[{"maxN_", ",", "maxL_", ",", "d\[Nu]_", ",", "sd\[Nu]_"}], "]"}],
      ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", " ", 
           "\"\<# line 3: harmonic degree truncation\>\"", " ", ",", " ", 
           "\[IndentingNewLine]", "\"\<# line 4: Toroidal Bessel d\[Nu]\>\"", 
           " ", ",", "\[IndentingNewLine]", 
           "\"\<# line 5: S grid Bessel d\[Nu]\>\""}], " ", 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"maxN", ",", "maxL", ",", "d\[Nu]", ",", "sd\[Nu]"}], 
           "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cylTruncNr", "[", 
     RowBox[{"nR_", ",", "nL_"}], "]"}], ":=", 
    RowBox[{"nL", "+", "1", "+", "2"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"geostrophic2Tor", "[", 
     RowBox[{"maxN_", ",", "maxL_", ",", "d\[Nu]_", ",", "sd\[Nu]_"}], "]"}], 
    ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nR", ",", "nNug", ",", "bg", ",", "bw", ",", "maxNl", ",", "bOp", ",",
         "nT", ",", "tg", ",", "tw", ",", "pOp", ",", "invLaplh", ",", "n", 
        ",", "c", ",", "tOp", ",", "k", ",", "sg", ",", "ugOp", ",", "l", ",",
         "tmp", ",", "op"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nR", "=", 
        RowBox[{"cylTruncNr", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nNug", "=", 
        RowBox[{"cylTruncNug", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bg", "=", 
        RowBox[{"bgrid", "[", "nR", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bw", "=", 
        RowBox[{"bweights", "[", "nR", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxNl", "=", "maxN"}], ";", "\[IndentingNewLine]", 
       RowBox[{"bOp", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"l", ",", "2"}], "]"}], "==", "1"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"bw", " ", 
               RowBox[{"$Jnl", "[", 
                RowBox[{"n", ",", "l", ",", "bg"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "0", ",", "maxN"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "0", ",", "maxL"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nT", "=", 
        RowBox[{"IntegerPart", "[", 
         RowBox[{"3", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"maxL", "+", "2"}], ")"}], "/", "2"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tg", " ", "=", " ", 
        RowBox[{
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"nT", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tw", "=", 
        RowBox[{
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"nT", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "$mpprec"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pOp", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"tw", " ", 
           RowBox[{"dPlm", "[", 
            RowBox[{"l", ",", "0", ",", "tg"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "0", ",", "maxL"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"invLaplh", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"l", ">", "0"}], ",", 
            FractionBox["1", 
             RowBox[{"l", 
              RowBox[{"(", 
               RowBox[{"l", "+", "1"}], ")"}]}]], ",", "0"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "0", ",", "maxL"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"op", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"maxN", "+", "1"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"maxL", "+", "1"}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "nNug"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"n", "=", "0"}], ",", 
         RowBox[{"n", "<", "nNug"}], ",", 
         RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"c", "=", 
           RowBox[{"2", "\[Pi]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tOp", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nR"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"maxL", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"k", "=", "1"}], ",", 
            RowBox[{"k", "<=", " ", "nR"}], ",", 
            RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"sg", "=", 
              RowBox[{
               RowBox[{"bg", "[", 
                RowBox[{"[", "k", "]"}], "]"}], 
               RowBox[{"Sin", "[", 
                RowBox[{"ArcCos", "[", "tg", "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"ugOp", "=", 
              RowBox[{"c", " ", 
               RowBox[{"InsulatingSphJnl", "[", 
                RowBox[{"n", ",", "1", ",", "sg"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"tOp", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", ";;"}], "]"}], "]"}], "=", 
              RowBox[{"-", 
               RowBox[{
                RowBox[{"DiagonalMatrix", "[", "invLaplh", "]"}], ".", "pOp", 
                ".", "ugOp"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"l", "=", "0"}], ",", 
            RowBox[{"l", "<", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"2", " ", "n"}], " ", "+", " ", "2"}], ",", 
               RowBox[{"maxL", "+", "1"}]}], "]"}]}], ",", 
            RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"l", ",", "2"}], "]"}], "==", "1"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"tmp", "=", 
                 RowBox[{
                  RowBox[{"bOp", "[", 
                   RowBox[{"[", 
                    RowBox[{"l", "+", "1"}], "]"}], "]"}], ".", 
                  RowBox[{"tOp", "[", 
                   RowBox[{"[", 
                    RowBox[{";;", ",", 
                    RowBox[{"l", "+", "1"}]}], "]"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"op", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"l", 
                    RowBox[{"(", 
                    RowBox[{"maxN", "+", "1"}], ")"}]}], "+", "1"}], ";;", 
                    RowBox[{
                    RowBox[{"l", 
                    RowBox[{"(", 
                    RowBox[{"maxN", "+", "1"}], ")"}]}], "+", 
                    RowBox[{
                    RowBox[{"Dimensions", "[", "tmp", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
                    RowBox[{"n", "+", "1"}]}], "]"}], "]"}], "=", "tmp"}], 
                ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "op"}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.921831250651967*^9, {3.921893799643091*^9, 3.92189390085954*^9}, {
   3.921896806613146*^9, 3.921896907190342*^9}, {3.921909271004073*^9, 
   3.921909274612501*^9}, {3.9219093648006*^9, 3.92190938574407*^9}, {
