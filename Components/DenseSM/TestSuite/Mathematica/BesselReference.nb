         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"nL", "-", "1"}], ",", "2"}], "]"}]}], "2"], "+", "nR", 
       "+", "1"}], "]"}], "+", "1"}]}], "\[IndentingNewLine]", 
