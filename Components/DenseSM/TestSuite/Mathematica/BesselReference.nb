           RowBox[{"i", ",", "4"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"msg", "=", 
         RowBox[{
         "\"\<Exporting \>\"", "<>", "name", "<>", 
          "\"\< Bessel operator for N = \>\"", "<>", 
          RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<, l = \>\"", "<>", 
          RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<...\>\""}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tempmsg", "=", 
