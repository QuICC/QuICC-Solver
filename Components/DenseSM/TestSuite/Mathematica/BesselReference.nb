           "\[IndentingNewLine]", 
           RowBox[{"fname", "=", 
            RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
             RowBox[{"ToString", "[", "idN", "]"}], "<>", 
             "\"\<_ref.dat\>\""}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Export", "[", 
