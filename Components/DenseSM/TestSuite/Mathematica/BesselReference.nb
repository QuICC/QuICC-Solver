       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nL", "-", "1"}], ")"}], "-", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"nL", "-", "1"}], ",", "2"}], "]"}]}], "2"], "+", "nR", 
       "+", "1"}], "]"}], "+", "1"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cylTruncNz", "[", 
     RowBox[{"nR_", ",", "nL_"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"IntegerPart", "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"(", 
