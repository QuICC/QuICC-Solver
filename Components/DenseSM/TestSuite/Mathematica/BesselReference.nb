Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"Metadata", " ", "format", " ", "for", " ", "GeostrophicEnergy"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataGeostrophicEnergy", "[", 
      RowBox[{"maxN_", ",", "maxL_", ",", "sd\[Nu]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", " ", 
           "\"\<# line 3: harmonic degree truncation\>\"", " ", ",", " ", 
           "\[IndentingNewLine]", "\"\<# line 4: S grid Bessel d\[Nu]\>\""}], 
          " ", "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"maxN", ",", "maxL", ",", "sd\[Nu]"}], "}"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"geostrophicEnergy", "[", 
     RowBox[{"maxN_", ",", "maxL_", ",", "sd\[Nu]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"op", ",", "nNug"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nNug", "=", 
        RowBox[{"cylTruncNug", "[", 
         RowBox[{
          RowBox[{"maxN", "+", "1"}], ",", 
          RowBox[{"maxL", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"op", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"4", "\[Pi]", " ", 
             RowBox[{"Integrate", "[", 
              RowBox[{
               RowBox[{"s", " ", 
                SqrtBox[
                 RowBox[{"1", "-", 
                  SuperscriptBox["s", "2"]}]], 
                RowBox[{"InsulatingSphJnl", "[", 
                 RowBox[{"i", ",", "1", ",", "s"}], "]"}], 
                RowBox[{"InsulatingSphJnl", "[", 
                 RowBox[{"j", ",", "1", ",", "s"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"s", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"nNug", "-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "0", ",", 
              RowBox[{"nNug", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"op", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"4", "\[Pi]", " ", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{"s", " ", 
              SqrtBox[
               RowBox[{"1", "-", 
                SuperscriptBox["s", "2"]}]], 
              RowBox[{"InsulatingSphJnl", "[", 
               RowBox[{"i", ",", "1", ",", "s"}], "]"}], 
              RowBox[{"InsulatingSphJnl", "[", 
               RowBox[{"j", ",", "1", ",", "s"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
             RowBox[{"WorkingPrecision", "->", "32"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"nNug", "-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"nNug", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "op"}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
 InitializationCell->True,
