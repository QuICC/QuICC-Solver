      RowBox[{"meta", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"msg", "=", 
      RowBox[{
      "\"\<Exporting \>\"", "<>", "name", "<>", 
       "\"\< GeostrophicEnergy operator for N = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<...\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tempmsg", "=", 
