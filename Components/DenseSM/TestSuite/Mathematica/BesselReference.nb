 RowBox[{
  RowBox[{"refop", "[", 
   RowBox[{"meta_", ",", "opfunc_", ",", "bcfunc_", ",", "name_"}], "]"}], ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "idN", ",", "i", ",", 
      "outN", ",", "bcId", ",", "maxN", ",", "l", ",", " ", "gridN", ",", 
      "lg", ",", "lw", ",", "matW", ",", "matS", ",", " ", "op", ",", "msg", 
      ",", "descr", ",", "tempmsg", ",", "fname"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"i", "\[LessEqual]", " ", 
        RowBox[{"Length", "[", "meta", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"idN", "=", 
         RowBox[{"$idStart", "+", "i", "-", "1"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"outN", "=", 
         RowBox[{"meta", "[", 
