 RowBox[{
  RowBox[{"refTor2Geostrophic", "[", 
   RowBox[{"meta_", ",", "idN_", ",", "name_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "maxN", ",", "maxL", ",",
       "d\[Nu]", ",", "sd\[Nu]", ",", "nS", ",", "op", ",", "msg", ",", 
      "descr", ",", "tempmsg", ",", "fname"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"maxN", "=", 
