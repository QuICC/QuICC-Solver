      RowBox[{"meta", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"msg", "=", 
      RowBox[{
      "\"\<Exporting \>\"", "<>", "name", "<>", 
       "\"\< Tor2Geostrophic operator for N = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<, L = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxL", "]"}], "<>", "\"\<...\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tempmsg", "=", 
      RowBox[{"PrintTemporary", "[", "msg", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "metadata"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fname", "=", 
      RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
       RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_meta.dat\>\""}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"descr", " ", "=", " ", 
      RowBox[{"createMetadataTor2Geostrophic", "[", 
       RowBox[{"maxN", ",", "maxL", ",", 
        RowBox[{"N", "[", 
         RowBox[{"d\[Nu]", ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"sd\[Nu]", ",", "outprec"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
        "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "operator"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"generateRefData", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"op", "=", 
         RowBox[{"tor2Geostrophic", "[", 
          RowBox[{"maxN", ",", "maxL", ",", "d\[Nu]", ",", "sd\[Nu]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"op", ",", "outprec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
          RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_ref.dat\>\""}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", "op"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "tempmsg", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"msg", ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\< Done(\>\"", "<>", 
               RowBox[{"DateString", "[", "]"}], "<>", "\"\<)\>\""}], ",", 
              RowBox[{"FontColor", "\[Rule]", "Green"}]}], "]"}]}], "}"}], 
          "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
