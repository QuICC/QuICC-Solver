  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataTor2GridS", "[", 
      RowBox[{"maxN_", ",", "maxL_", ",", "d\[Nu]_", ",", "sd\[Nu]_"}], "]"}],
      ":=", 
     RowBox[{"Module", "[", 
