Cell[BoxData[
 RowBox[{
  RowBox[{"refGeostrophic2Tor", "[", 
   RowBox[{"meta_", ",", "idN_", ",", "name_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "maxN", ",", "maxL", ",",
       "d\[Nu]", ",", "sd\[Nu]", ",", "op", ",", "msg", ",", "descr", ",", 
      "tempmsg", ",", "fname"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"maxN", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"maxL", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d\[Nu]", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sd\[Nu]", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"msg", "=", 
      RowBox[{
      "\"\<Exporting \>\"", "<>", "name", "<>", 
       "\"\< Geostrophic2Tor operator for N = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<, L = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxL", "]"}], "<>", "\"\<...\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tempmsg", "=", 
      RowBox[{"PrintTemporary", "[", "msg", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "metadata"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fname", "=", 
      RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
       RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_meta.dat\>\""}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"descr", " ", "=", " ", 
      RowBox[{"createMetadataGeostrophic2Tor", "[", 
       RowBox[{"maxN", ",", "maxL", ",", 
        RowBox[{"N", "[", 
         RowBox[{"d\[Nu]", ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"sd\[Nu]", ",", "outprec"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
        "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "operator"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"generateRefData", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"op", "=", 
         RowBox[{"geostrophic2Tor", "[", 
          RowBox[{"maxN", ",", "maxL", ",", "d\[Nu]", ",", "sd\[Nu]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"op", ",", "outprec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
          RowBox[{"ToString", "[", "idN", "]"}], "<>", "\"\<_ref.dat\>\""}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", "op"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "tempmsg", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"msg", ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\< Done(\>\"", "<>", 
               RowBox[{"DateString", "[", "]"}], "<>", "\"\<)\>\""}], ",", 
              RowBox[{"FontColor", "\[Rule]", "Green"}]}], "]"}]}], "}"}], 
          "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
