Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
   "Metadata", " ", "format", " ", "for", " ", "GeostrophicAngularMomentum"}],
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"createMetadataGeostrophicAngularMomentum", "[", 
      RowBox[{"maxN_", ",", "sd\[Nu]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"descr", ",", "header"}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
          "\"\<# Format description\>\"", ",", "\[IndentingNewLine]", 
           "\"\<# line 1: number of lines\>\"", ",", "\[IndentingNewLine]", 
           " ", "\"\<# line 2: radial truncation\>\"", " ", ",", 
           "\[IndentingNewLine]", "\"\<# line 3: S grid Bessel d\[Nu]\>\""}], 
          " ", "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"maxN", ",", "sd\[Nu]"}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"descr", ",", 
           RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"descr", ",", "header"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "descr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"geostrophicAngularMomentum", "[", 
     RowBox[{"maxN_", ",", "sd\[Nu]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"op", ",", "nR", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"op", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "maxN"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "0"}], ",", 
         RowBox[{"j", "<", 
          RowBox[{"maxN", "+", "1"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"op", "[", 
            RowBox[{"[", 
             RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", 
           RowBox[{"4", "\[Pi]", " ", 
            RowBox[{"Integrate", "[", 
             RowBox[{
              RowBox[{"s", " ", 
               RowBox[{"InsulatingSphJnl", "[", 
                RowBox[{"j", ",", "1", ",", "s"}], "]"}], " ", "s", " ", 
               SqrtBox[
                RowBox[{"1", "-", 
                 SuperscriptBox["s", "2"]}]]}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";"}]}],
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "op"}]}], 
     "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
