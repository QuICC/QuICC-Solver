   RowBox[{"meta_", ",", "opfunc_", ",", "name_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "idN", ",", "i", ",", 
      "outDNu", ",", "inDNu", ",", "maxN", ",", "l", ",", " ", "ref", ",", 
      "msg", ",", "descr", ",", "tempmsg", ",", "fname"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"i", "\[LessEqual]", " ", 
        RowBox[{"Length", "[", "meta", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"idN", "=", 
         RowBox[{"1000", "+", "i", "-", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"outDNu", "=", 
         RowBox[{"meta", "[", 
          RowBox[{"[", 
