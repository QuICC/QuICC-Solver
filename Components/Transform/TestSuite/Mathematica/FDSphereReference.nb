          "\"\< spectrum], id = \>\"", "<>", 
          RowBox[{"ToString", "[", "id", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxL", "=", 
         RowBox[{
          SuperscriptBox["2", "p"], "-", "1"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"{", 
          RowBox[{"nN", ",", "nR", ",", "tFunc"}], "}"}], "=", 
