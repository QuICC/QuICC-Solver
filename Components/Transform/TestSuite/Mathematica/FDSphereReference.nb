Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "\[IndentingNewLine]", 
   RowBox[{"General", " ", "Worland", " ", "setup"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Worland", " ", "package", " ", "setup"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pkgroot", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
        "quiccroot", ",", "\"\<Components\>\"", ",", "\"\<TestSuite\>\"", 
         ",", "\"\<Mathematica\>\""}], "}"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"$Path", ",", " ", "pkgroot"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Worland`$mpprec", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Worland`$WorlandType", "=", "\"\<SphEnergy\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<Worland`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ParallelNeeds", "[", "\"\<Worland`\>\"", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$MaxExtraPrecision", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mpprec", " ", "=", " ", "Worland`$mpprec"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"FDSphere", " ", "package"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<FDSphere`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datadir", "=", 
     RowBox[{"{", 
      RowBox[{
      "\"\<_data\>\"", ",", "\"\<Transform\>\"", ",", "\"\<FiniteDiff\>\"", 
       ",", "\"\<Sphere\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"refdir", "=", 
     RowBox[{"{", 
      RowBox[{
      "\"\<_refdata\>\"", ",", "\"\<Transform\>\"", ",", "\"\<FiniteDiff\>\"",
        ",", "\"\<Sphere\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "intgdivrdrWorland", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"divr", "[", 
     RowBox[{"f_", ",", "l_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "out", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"out", " ", "=", " ", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          FractionBox["1", "t"], "f"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "out"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"divrdr", "[", 
     RowBox[{"f_", ",", "l_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "out", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"out", " ", "=", " ", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          FractionBox["1", "t"], 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"t", " ", "f"}], ",", "t"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "out"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "\[IndentingNewLine]", 
    RowBox[{"Operators", " ", "to", " ", "work", " ", "on", " ", "grid"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"WnlEnergy", "[", 
     RowBox[{"n_", ",", "l_", ",", "r_"}], "]"}], ":=", 
    RowBox[{
     SuperscriptBox["r", "l"], 
     RowBox[{
      RowBox[{"JacobiP", "[", 
       RowBox[{"n", ",", "$wsph\[Alpha]", ",", 
        RowBox[{"l", "+", "$wsphd\[Beta]"}], ",", 
        RowBox[{
         RowBox[{"2", 
          SuperscriptBox["r", "2"]}], "-", "1"}]}], "]"}], "/", 
      RowBox[{"norm", "[", 
       RowBox[{"n", ",", "$wsph\[Alpha]", ",", 
        RowBox[{"l", "+", "$wsphd\[Beta]"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"divrWnlzeroWnl", "[", 
      RowBox[{"n_", ",", "l_", ",", "r_"}], "]"}], ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"l", "==", "0"}], ",", 
       RowBox[{"0", "r"}], ",", 
       RowBox[{"divrWnl", "[", 
        RowBox[{"n", ",", "l", ",", "r"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dWnlWnl", "[", 
      RowBox[{"n_", ",", "l_", ",", "r_"}], "]"}], ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"l", "==", "0"}], ",", 
       RowBox[{"Wnl", "[", 
        RowBox[{"n", ",", "l", ",", "r"}], "]"}], ",", 
       RowBox[{"dWnl", "[", 
        RowBox[{"n", ",", "l", ",", "r"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"divrdrWnlzeroWnl", "[", 
      RowBox[{"n_", ",", "l_", ",", "r_"}], "]"}], ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"l", "==", "0"}], ",", 
       RowBox[{"0", "r"}], ",", 
       RowBox[{"divrdrWnl", "[", 
        RowBox[{"n", ",", "l", ",", "r"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uniformRadialGrid", "[", "n_", "]"}], ":=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        FractionBox["i", 
         RowBox[{"n", "-", "1"}]], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", "mpprec"}], "]"}]}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"uniformTruncation", "[", 
      RowBox[{"maxN_", ",", "l_"}], "]"}], ":=", "maxN"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dealiasGrid", "[", 
      RowBox[{"n_", ",", "l_", ",", 
       RowBox[{"tFunc_", ":", "uniformTruncation"}]}], "]"}], ":=", 
     RowBox[{"Floor", "[", 
      RowBox[{"3", 
       RowBox[{
        RowBox[{"(", 
