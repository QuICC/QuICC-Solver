            RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
          RowBox[{"genRef", "->", 
           RowBox[{
            RowBox[{"genTags", "[", 
             RowBox[{"[", "is", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
