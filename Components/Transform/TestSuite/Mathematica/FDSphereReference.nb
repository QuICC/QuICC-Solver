Cell[BoxData[{
 RowBox[{
  RowBox[{"maxL", "=", "18"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"genTags", "=", 
   RowBox[{"{", 
    RowBox[{"True", ",", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectra", "=", 
   RowBox[{"{", 
    RowBox[{
    "minSpectrum", ",", "maxSpectrum", ",", "unitSpectrum", ",", 
     "randSpectrum"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"it", "=", "1"}], ",", 
    RowBox[{"it", "<=", " ", 
     RowBox[{"Length", "[", "spectra", "]"}]}], ",", 
    RowBox[{"it", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"StringRepeat", "[", 
       RowBox[{"\"\<%\>\"", ",", "50"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"id", "=", 
      RowBox[{"(", 
       RowBox[{"it", "-", "1"}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<%%% Generating data with \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"spectra", "[", 
         RowBox[{"[", "it", "]"}], "]"}], "]"}], "<>", 
       "\"\< spectrum, id = \>\"", "<>", 
       RowBox[{"ToString", "[", "id", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nN", ",", "nR", ",", "tFunc"}], "}"}], "=", 
      RowBox[{"uniformSetup", "[", "maxL", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"meta", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"nN", ",", "nR", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3", ",", "8", ",", "maxL"}], "}"}]}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"generateEnergies", "[", 
      RowBox[{"meta", ",", "id", ",", 
       RowBox[{"spectra", "[", 
        RowBox[{"[", "it", "]"}], "]"}], ",", "uniformRadialGrid", ",", 
       RowBox[{"truncationFunc", "->", "tFunc"}], ",", " ", 
       RowBox[{"genIn", "->", 
        RowBox[{"genTags", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
       RowBox[{"genRef", "->", 
        RowBox[{"genTags", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{
  "it", ",", "spectra", ",", "is", ",", "maxL", ",", "nN", ",", "nR", ",", 
