  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fdg", "=", 
   SuperscriptBox[
    RowBox[{"Abs", "[", 
     RowBox[{"fdOp", ".", 
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"{", 
         RowBox[{"r", "->", "rg"}], "}"}]}], ")"}]}], "]"}], "2"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wgts", "=", 
