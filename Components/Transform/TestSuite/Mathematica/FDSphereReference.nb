        RowBox[{"l", "+", "$wsphd\[Beta]"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"divrWnlzeroWnl", "[", 
