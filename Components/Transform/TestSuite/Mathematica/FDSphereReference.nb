   RowBox[{
    RowBox[{"divrdr", "[", 
     RowBox[{"f_", ",", "l_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "out", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"out", " ", "=", " ", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          FractionBox["1", "t"], 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"t", " ", "f"}], ",", "t"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "out"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "\[IndentingNewLine]", 
