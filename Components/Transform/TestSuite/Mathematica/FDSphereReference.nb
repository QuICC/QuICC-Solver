             RowBox[{"{", 
              RowBox[{"l", ",", "0", ",", "maxL"}], "}"}]}], "]"}]}], "}"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"generateDbProjectors", "[", 
