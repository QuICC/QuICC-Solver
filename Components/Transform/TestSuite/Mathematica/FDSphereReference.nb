Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"testEnergy", "[", 
    RowBox[{
    "meta_", ",", "id_", ",", "infunc_", ",", "gfunc_", ",", "opfunc_", ",", 
     "name_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"outprec", " ", "=", " ", "32"}], ",", "i", ",", "tmp", ",", 
       "nN", ",", "gridN", ",", "ls", ",", "descr", ",", " ", "specR", ",", 
       "grid", ",", "zg", " ", ",", "in", ",", "inI", ",", "inR", ",", "gq", 
       ",", "xLeg", ",", "wLeg", ",", "rLeg", ",", "ref", ",", "msg", ",", 
       "tempmsg", ",", "fbase", ",", "fname", ",", 
       RowBox[{"tFunc", "=", 
        RowBox[{"OptionValue", "[", "truncationFunc", "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nN", "=", 
       RowBox[{"meta", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gridN", " ", "=", " ", 
       RowBox[{"meta", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ls", "=", 
       RowBox[{"meta", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fbase", "=", 
       RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
        RowBox[{"ToString", "[", "id", "]"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"msg", "=", 
       RowBox[{
       "\"\<Exporting \>\"", "<>", "name", "<>", 
        "\"\< FD sphere operator for N = \>\"", "<>", 
        RowBox[{"ToString", "[", "nN", "]"}], "<>", "\"\<, Ng = \>\"", " ", "<>", 
        RowBox[{"ToString", "[", "gridN", "]"}], "<>", "\"\<, l = \>\"", "<>", 
        RowBox[{"ToString", "[", "ls", "]"}], "<>", "\"\<...\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Generate", " ", "meta", " ", "data"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"fname", "=", 
       RowBox[{"fbase", "<>", "\"\<_meta.dat\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"descr", "=", 
       RowBox[{"createMetadata", "[", 
        RowBox[{"gridN", ",", "gridN", ",", "ls", ",", "tFunc"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
         "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Generate", " ", "input", " ", "data"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"generateInData", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"specR", "=", 
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"infunc", "[", 
             RowBox[{
              RowBox[{"i", "-", "1"}], ",", 
              RowBox[{"nN", "-", "1"}], ",", 
              RowBox[{"ls", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", "tFunc"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "nN"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "@", "ls"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"grid", " ", "=", " ", 
          RowBox[{"gfunc", "[", "gridN", "]"}]}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"zg", " ", "=", " ", 
          RowBox[{"0", "grid"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"inR", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"specR", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "j"}], "]"}], "]"}], "!=", "0"}], ",", 
                RowBox[{
                 RowBox[{"tmp", "=", 
                  RowBox[{"Wnl", "[", 
                   RowBox[{
                    RowBox[{"i", "-", "1"}], ",", 
                    RowBox[{"ls", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", "\[Zeta]"}], "]"}]}],
                  ";", 
                 RowBox[{"tmp", "=", 
                  RowBox[{"tmp", "/.", 
                   RowBox[{"{", 
                    RowBox[{"\[Zeta]", "->", "grid"}], "}"}]}]}], ";", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "@", "tmp"}], " ", "<", " ", 
                    RowBox[{"Length", "@", "grid"}]}], ",", 
                   RowBox[{"tmp", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{"tmp", ",", 
                    RowBox[{"Length", "@", "grid"}]}], "]"}]}]}], "]"}], ";", 
                 
                 RowBox[{
                  RowBox[{"specR", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "tmp"}]}], ",", 
                "zg"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "nN"}], "}"}]}], "]"}], ",", 
