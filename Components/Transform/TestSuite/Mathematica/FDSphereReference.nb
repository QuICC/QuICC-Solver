Cell[BoxData[{
 RowBox[{
  RowBox[{"genTags", "=", 
   RowBox[{"{", 
    RowBox[{"True", ",", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectra", "=", 
   RowBox[{"{", "randSpectrum", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"it", "=", "1"}], ",", 
    RowBox[{"it", "<=", " ", 
     RowBox[{"Length", "[", "spectra", "]"}]}], ",", 
    RowBox[{"it", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"StringRepeat", "[", 
       RowBox[{"\"\<%\>\"", ",", "50"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", " ", 
      RowBox[{
       RowBox[{"p", " ", "=", " ", "4"}], ",", 
       RowBox[{"p", "<", "9"}], ",", 
       RowBox[{"p", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"id", "=", 
         RowBox[{
          RowBox[{"100", "it"}], "+", "p"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<%%% Generating data with \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"spectra", "[", 
            RowBox[{"[", "it", "]"}], "]"}], "]"}], "<>", 
          "\"\< spectrum, id = \>\"", "<>", 
          RowBox[{"ToString", "[", "id", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxL", "=", 
         RowBox[{
          SuperscriptBox["2", "p"], "-", "1"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"{", 
          RowBox[{"nN", ",", "nR", ",", "tFunc"}], "}"}], "=", 
         RowBox[{"uniformSetup", "[", "maxL", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"meta", "=", 
         RowBox[{"{", 
          RowBox[{"nN", ",", "nR", ",", 
           RowBox[{"Table", "[", 
            RowBox[{"l", ",", 
             RowBox[{"{", 
              RowBox[{"l", ",", "0", ",", "maxL"}], "}"}]}], "]"}]}], "}"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"generateEnergies", "[", 
         RowBox[{"meta", ",", "id", ",", 
          RowBox[{"spectra", "[", 
           RowBox[{"[", "it", "]"}], "]"}], ",", ",", "uniformRadialGrid", 
          ",", 
          RowBox[{"truncationFunc", "->", "tFunc"}], ",", 
          RowBox[{"genIn", "->", 
           RowBox[{"genTags", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"genRef", "->", 
           RowBox[{"genTags", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";", 
