Cell[BoxData[{
 RowBox[{
  RowBox[{"maxL", "=", "18"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"genTags", "=", 
   RowBox[{"{", 
    RowBox[{"True", ",", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectra", "=", 
   RowBox[{"{", 
    RowBox[{
    "minSpectrum", ",", "maxSpectrum", ",", "unitSpectrum", ",", 
     "randSpectrum"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"it", "=", "1"}], ",", 
    RowBox[{"it", "<=", " ", 
     RowBox[{"Length", "[", "spectra", "]"}]}], ",", 
    RowBox[{"it", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"id", "=", 
      RowBox[{"(", 
       RowBox[{"it", "-", "1"}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"StringRepeat", "[", 
       RowBox[{"\"\<%\>\"", ",", "50"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
