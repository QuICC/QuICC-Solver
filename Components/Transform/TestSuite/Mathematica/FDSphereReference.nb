    RowBox[{"rg", ",", "4", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fdEnergy", "=", 
   RowBox[{"wgts", ".", 
    RowBox[{"(", "fdg", ")"}]}]}], ";"}], "\[IndentingNewLine]", 
