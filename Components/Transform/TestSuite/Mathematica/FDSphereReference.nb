       RowBox[{"\"\<%\>\"", ",", "50"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", " ", 
      RowBox[{
       RowBox[{"p", " ", "=", " ", "4"}], ",", 
       RowBox[{"p", "<", "7"}], ",", 
       RowBox[{"p", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"id", "=", 
         RowBox[{
          RowBox[{"100", "it"}], "+", "p"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<%%% Generating data with \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"spectra", "[", 
