Cell[BoxData[{
 RowBox[{
  RowBox[{"maxL", "=", "18"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"genTags", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"True", ",", "True"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"True", ",", "True"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"setups", "=", 
   RowBox[{"{", 
    RowBox[{"uniformSetup", ",", "triangularSetup"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectra", "=", 
   RowBox[{"{", 
    RowBox[{
    "minSpectrum", ",", "maxSpectrum", ",", "unitSpectrum", ",", 
     "randSpectrum"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"it", "=", "1"}], ",", 
    RowBox[{"it", "<=", " ", 
     RowBox[{"Length", "[", "spectra", "]"}]}], ",", 
    RowBox[{"it", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"StringRepeat", "[", 
       RowBox[{"\"\<%\>\"", ",", "50"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<%%% Generating data with \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"spectra", "[", 
         RowBox[{"[", "it", "]"}], "]"}], "]"}], "<>", "\"\< spectrum\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", " ", 
      RowBox[{
       RowBox[{"is", " ", "=", " ", "1"}], ",", 
       RowBox[{"is", "<=", " ", 
        RowBox[{"Length", "[", "setups", "]"}]}], ",", 
       RowBox[{"is", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"nN", ",", "nR", ",", "tFunc"}], "}"}], "=", 
         RowBox[{
          RowBox[{"setups", "[", 
           RowBox[{"[", "is", "]"}], "]"}], "[", "maxL", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"meta", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"nN", ",", "nR", ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"id", "=", 
         RowBox[{
          RowBox[{"1000", 
           RowBox[{"(", 
            RowBox[{"is", "-", "1"}], ")"}]}], "+", 
          RowBox[{"(", 
           RowBox[{"it", "-", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<--- Generating data with \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"setups", "[", 
            RowBox[{"[", "is", "]"}], "]"}], "]"}], "<>", 
          "\"\< truncation, id = \>\"", "<>", 
          RowBox[{"ToString", "[", "id", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"generateBFLoops", "[", 
         RowBox[{"meta", ",", "id", ",", 
          RowBox[{"spectra", "[", 
           RowBox[{"[", "it", "]"}], "]"}], ",", "wgrid", ",", "wweights", 
          ",", 
          RowBox[{"truncationFunc", "->", "tFunc"}], ",", " ", 
          RowBox[{"genIn", "->", 
