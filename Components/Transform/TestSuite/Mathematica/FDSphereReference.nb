Cell[BoxData[{
 RowBox[{
  RowBox[{"rg", "=", 
   RowBox[{"fdsphgrid", "[", "39", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", "18"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}], 
    RowBox[{"Wnl", "[", 
     RowBox[{"n", ",", "l", ",", "r"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   SuperscriptBox[
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}], 
      RowBox[{"divrdrWnl", "[", 
       RowBox[{"n", ",", "l", ",", "r"}], "]"}]}], "]"}], "2"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"refEnergy", "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"g", " ", 
      SuperscriptBox["r", "2"]}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fdOp", "=", 
