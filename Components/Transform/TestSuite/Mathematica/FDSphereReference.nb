     RowBox[{"{", 
      RowBox[{"tFunc", "=", 
       RowBox[{"OptionValue", "[", "truncationFunc", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"configureGenerator", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "genIn", "]"}], ",", 
        RowBox[{"OptionValue", "[", "genRef", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
