    RowBox[{
     RowBox[{"nM", "=", 
      SuperscriptBox["2", "p"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nG", " ", "=", " ", 
      RowBox[{
       FractionBox["3", "2"], "nM"}]}], ";", "\[IndentingNewLine]", 
