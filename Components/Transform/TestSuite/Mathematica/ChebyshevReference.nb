       RowBox[{"ToString", "[", "id", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "meta", " ", "data"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fname", "=", 
      RowBox[{"fbase", "<>", "\"\<_meta.dat\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"descr", "=", 
      RowBox[{"createMetadata", "[", 
       RowBox[{"nN", ",", "gridN", ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], "+", "b"}], ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"a", "+", "b"}], ",", "outprec"}], "]"}], ",", "ls"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
