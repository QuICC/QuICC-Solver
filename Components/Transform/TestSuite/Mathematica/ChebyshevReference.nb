       RowBox[{"generateInData", "&&", " ", "generateRefData"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"grid", " ", "=", " ", 
         RowBox[{"gfunc", "[", "gridN", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"phys", "=", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", ">", " ", "1"}], ",", " ", "2", ",", " ", "1"}], 
               "]"}], 
              RowBox[{"spec", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], 
              RowBox[{"bopfunc", "[", 
               RowBox[{
                RowBox[{"i", "-", "1"}], ",", "a", ",", "b", ",", 
                RowBox[{"ls", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", "grid"}], "]"}]}], ",", 
             
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nN"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "@", "ls"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wgts", "=", 
         RowBox[{"wfunc", "[", "gridN", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"spec", "=", 
