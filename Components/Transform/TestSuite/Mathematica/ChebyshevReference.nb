                RowBox[{"i", "-", "1"}], ",", "a", ",", "b", ",", 
                RowBox[{"ls", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", "grid"}], "]"}]}], ",", 
             
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nN"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "@", "ls"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"refData", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"Re", "[", "phys", "]"}], "]"}], ",", 
             RowBox[{"Transpose", "[", 
              RowBox[{"Im", "[", "phys", "]"}], "]"}]}], "]"}], ",", 
           "outprec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"fbase", "<>", "\"\<_ref.dat\>\""}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", "refData", ",", "\"\<Table\>\""}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"msg", ",", 
         RowBox[{"Style", "[", 
