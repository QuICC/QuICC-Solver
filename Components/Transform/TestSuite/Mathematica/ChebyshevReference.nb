       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"spec", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"infunc", "[", 
         RowBox[{
          RowBox[{"i", "-", "1"}], ",", 
          RowBox[{"nN", "-", "1"}], ",", "l", ",", "l"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nN"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "ls"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"msg", "=", 
      RowBox[{
      "\"\<Exporting \>\"", "<>", "name", "<>", 
       "\"\< Chebyshev operator for N = \>\"", "<>", 
       RowBox[{"ToString", "[", "nN", "]"}], "<>", "\"\<, Ng = \>\"", " ", "<>", 
       RowBox[{"ToString", "[", "gridN", "]"}], "<>", "\"\<, a = \>\"", "<>", 
       
       RowBox[{"ToString", "[", 
        RowBox[{"N", "[", 
         RowBox[{"a", ",", "5"}], "]"}], "]"}], "<>", "\"\<, b = \>\"", "<>", 
       
       RowBox[{"ToString", "[", 
        RowBox[{"N", "[", 
         RowBox[{"b", ",", "5"}], "]"}], "]"}], "<>", "\"\<, l = \>\"", "<>", 
       
       RowBox[{"ToString", "[", "ls", "]"}], "<>", "\"\<...\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fbase", "=", 
      RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
       RowBox[{"ToString", "[", "id", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fname", "=", 
      RowBox[{"fbase", "<>", "\"\<_meta.dat\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"descr", "=", 
      RowBox[{"createMetadata", "[", 
       RowBox[{"nN", ",", "gridN", ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], "+", "b"}], ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"a", "+", "b"}], ",", "outprec"}], "]"}], ",", "ls"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
        "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "input", " ", "data"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"generateInData", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"inData", " ", "=", " ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Re", "[", "spec", "]"}], ",", 
           RowBox[{"Im", "[", "spec", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"fbase", "<>", "\"\<_in.dat\>\""}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
