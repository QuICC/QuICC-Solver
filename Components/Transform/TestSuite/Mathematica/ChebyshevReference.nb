     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"generateInData", "&&", "generateRefData"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"grid", " ", "=", " ", 
         RowBox[{"gfunc", "[", "gridN", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"phys", "=", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", ">", " ", "1"}], ",", " ", "2", ",", " ", "1"}], 
               "]"}], 
              RowBox[{"spec", "[", 
