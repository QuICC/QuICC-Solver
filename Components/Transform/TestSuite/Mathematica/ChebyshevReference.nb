        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nN"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "ls"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"msg", "=", 
      RowBox[{
      "\"\<Exporting \>\"", "<>", "name", "<>", 
       "\"\< Chebyshev operator for N = \>\"", "<>", 
       RowBox[{"ToString", "[", "nN", "]"}], "<>", "\"\<, Ng = \>\"", " ", "<>", 
       RowBox[{"ToString", "[", "gridN", "]"}], "<>", "\"\<, a = \>\"", "<>", 
       
       RowBox[{"ToString", "[", 
        RowBox[{"N", "[", 
         RowBox[{"a", ",", "5"}], "]"}], "]"}], "<>", "\"\<, b = \>\"", "<>", 
       
       RowBox[{"ToString", "[", 
        RowBox[{"N", "[", 
         RowBox[{"b", ",", "5"}], "]"}], "]"}], "<>", "\"\<, l = \>\"", "<>", 
       
       RowBox[{"ToString", "[", "ls", "]"}], "<>", "\"\<...\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fbase", "=", 
      RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
       RowBox[{"ToString", "[", "id", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fname", "=", 
      RowBox[{"fbase", "<>", "\"\<_meta.dat\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"descr", "=", 
      RowBox[{"createMetadata", "[", 
       RowBox[{"nN", ",", "gridN", ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], "+", "b"}], ",", "outprec"}], "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"a", "+", "b"}], ",", "outprec"}], "]"}], ",", "ls"}], 
