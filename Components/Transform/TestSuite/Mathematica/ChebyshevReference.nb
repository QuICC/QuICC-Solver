Cell[BoxData[{
 RowBox[{
  RowBox[{"genTags", "=", 
   RowBox[{"{", 
    RowBox[{"True", ",", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectra", "=", 
   RowBox[{"{", "randSpectrum", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ab", " ", "=", " ", 
   RowBox[{"abSphere", "[", 
    FractionBox["7", "20"], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"it", "=", "1"}], ",", 
    RowBox[{"it", "<=", " ", 
     RowBox[{"Length", "[", "spectra", "]"}]}], ",", 
    RowBox[{"it", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"StringRepeat", "[", 
       RowBox[{"\"\<%\>\"", ",", "50"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<%%% Generating data with \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"spectra", "[", 
         RowBox[{"[", "it", "]"}], "]"}], "]"}], "<>", "\"\< spectrum\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", " ", 
      RowBox[{
       RowBox[{"p", " ", "=", " ", "4"}], ",", 
       RowBox[{"p", "<", "6"}], ",", 
       RowBox[{"p", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"id", "=", 
         RowBox[{
          RowBox[{"100", "it"}], "+", "p"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<--- Generating data with id = \>\"", "<>", 
          RowBox[{"ToString", "[", "id", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxL", "=", 
         RowBox[{
          SuperscriptBox["2", "p"], "-", "1"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{
