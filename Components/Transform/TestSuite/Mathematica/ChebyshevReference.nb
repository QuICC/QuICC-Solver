       "phys", ",", "grid", ",", "wgts", ",", "inData", ",", "refData", ",", 
      "msg", ",", "tempmsg", ",", "fbase", ",", "fname"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nN", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gridN", " ", "=", " ", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"meta", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"meta", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ls", "=", 
      RowBox[{
       RowBox[{"meta", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"msg", "=", 
      RowBox[{
      "\"\<Exporting \>\"", "<>", "name", "<>", 
       "\"\< Chebyshev operator for N = \>\"", "<>", 
       RowBox[{"ToString", "[", "nN", "]"}], "<>", "\"\<, Ng = \>\"", " ", "<>", 
       RowBox[{"ToString", "[", "gridN", "]"}], "<>", "\"\<, a = \>\"", "<>", 
       
       RowBox[{"ToString", "[", 
        RowBox[{"N", "[", 
         RowBox[{"a", ",", "5"}], "]"}], "]"}], "<>", "\"\<, b = \>\"", "<>", 
       
       RowBox[{"ToString", "[", 
        RowBox[{"N", "[", 
         RowBox[{"b", ",", "5"}], "]"}], "]"}], "<>", "\"\<, l = \>\"", "<>", 
       
       RowBox[{"ToString", "[", "ls", "]"}], "<>", "\"\<...\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fbase", "=", 
