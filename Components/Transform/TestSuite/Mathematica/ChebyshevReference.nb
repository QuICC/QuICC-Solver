     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "input", " ", "data"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"generateInData", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"spec", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"infunc", "[", 
