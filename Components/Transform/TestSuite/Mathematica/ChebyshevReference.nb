Cell[BoxData[
 RowBox[{
  RowBox[{"testProjector", "[", 
   RowBox[{
   "meta_", ",", "id_", ",", "infunc_", ",", "gfunc_", ",", "opfunc_", ",", 
    "name_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "a", ",", "b", ",", "i", 
      ",", "nN", ",", "gridN", ",", "ls", ",", "descr", ",", " ", "spec", ",",
       "phys", ",", "grid", ",", "inData", ",", "refData", ",", "msg", ",", 
      "tempmsg", ",", "fbase", ",", "fname"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nN", "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gridN", " ", "=", " ", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"meta", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "[", 
