          RowBox[{
           RowBox[{"Dot", "[", 
            RowBox[{
             RowBox[{"wgts", " ", 
              RowBox[{"fopfunc", "[", 
               RowBox[{
                RowBox[{"i", "-", "1"}], ",", "a", ",", "b", ",", 
                RowBox[{"ls", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", "grid"}], "]"}]}], ",", 
             
             RowBox[{"Transpose", "[", 
