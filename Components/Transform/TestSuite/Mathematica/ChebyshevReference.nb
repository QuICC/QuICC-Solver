        "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"fbase", "<>", "\"\<_in.dat\>\""}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
