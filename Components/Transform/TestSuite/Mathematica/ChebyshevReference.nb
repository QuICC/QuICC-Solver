           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "nN"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "@", "ls"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"refData", " ", "=", " ", 
         RowBox[{"Chop", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Re", "[", "spec", "]"}], ",", 
             RowBox[{"Im", "[", "spec", "]"}]}], "]"}], ",", 
           SuperscriptBox["10", 
            RowBox[{
             RowBox[{"-", "mpprec"}], "+", "5"}]]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"fbase", "<>", "\"\<_ref.dat\>\""}]}], ";", 
