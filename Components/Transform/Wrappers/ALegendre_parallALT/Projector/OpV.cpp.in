void @Op@<@Tag@>::initBackend() const
{
    Profiler::RegionFixture<3> fix("P<viewGpuParallalt_t>::initBackend");

    //SetupType &setup = &this->mspSetup;
    std::uint32_t Ntheta = this->mspSetup->bwdSize();//igrid.size();
    std::uint32_t K = static_cast<std::uint32_t>(this->mspSetup->fastSize(0));

    std::uint32_t nLayers = static_cast<std::uint32_t>(this->mspSetup->slowSize());

    ///\todo this should be the full matrix size
    std::uint32_t M = static_cast<std::uint32_t>(this->mspSetup->slow(nLayers-1)) + 1;
    std::uint32_t L = this->mspSetup->specSize();
    PfSolve::PfSolveResult resPfSolve = PfSolve::PFSOLVE_SUCCESS;

    num_m_even = 0;
    num_m_odd = 0;
    for (std::uint32_t i = 0; i < nLayers; ++i)
    {
        if ((static_cast<std::uint32_t>(this->mspSetup->slow(i))%2) == 0 )
        {
            num_m_even++;
        }
        if ((static_cast<std::uint32_t>(this->mspSetup->slow(i))%2) == 1 )
        {
            num_m_odd++;
        }
    }
    int start = 0;
    int iter = 0;
    m_even = (int*)calloc(num_m_even, sizeof(int));
    m_even_endBatch = (int*)calloc(num_m_even, sizeof(int));
    m_odd = (int*)calloc(num_m_odd, sizeof(int));
    m_odd_endBatch = (int*)calloc(num_m_odd, sizeof(int));
    //config_backward.m_even_list = m_even;
    //config_backward.m_even_endBatch = m_even_endBatch;
    //config_backward.m_odd_list = m_odd;
    //config_backward.m_odd_endBatch = m_odd_endBatch;
   
    for (std::uint32_t i = 0; i < nLayers; ++i)
    {
        if ((static_cast<std::uint32_t>(this->mspSetup->slow(i))%2) == 0 )
        {
            start += static_cast<std::uint32_t>(this->mspSetup->mult(i));
            m_even[iter] = static_cast<std::uint32_t>(this->mspSetup->slow(i));
            m_even_endBatch[iter] = 2*start;
            printf("%d %d %d \n", m_even[iter], m_even_endBatch[iter], iter);
            iter++;
        }
    }
    
    start = 0;
    iter = 0;
    for (std::uint32_t i = 0; i < nLayers; ++i)
    {
        if ((static_cast<std::uint32_t>(this->mspSetup->slow(i))%2) == 1 )
        {
            start += static_cast<std::uint32_t>(this->mspSetup->mult(i));
            m_odd[iter] = static_cast<std::uint32_t>(this->mspSetup->slow(i));
            m_odd_endBatch[iter] = 2*start;
            printf("%d %d %d \n", m_odd[iter], m_odd_endBatch[iter], iter);
            iter++;
        }
    }
    
    //config_backward.M = ((m_even[config_backward.num_m_even - 1]) / 2 + 1) * 2;// M;
    //config_backward.L = this->mspSetup->specSize();// 3 * M / 2;

    //std::cout << resPfSolve;

    constexpr size_t rank = 3;
    // dim 0 - Nr - radial points
    // dim 1 - R  - radial modes
    // dim 2 - L  - harmonic degree
    std::array<std::uint32_t, rank> dimensions {M, K, M};

    std::vector<std::uint32_t> layers(nLayers);
    for(std::uint32_t p = 0; p < nLayers; ++p)
    {
        layers[p] = this->mspSetup->slow(p);
    }

    // Make view operator
    auto mem = std::make_shared<QuICC::Memory::Cuda::Malloc>();

    mOp = std::make_unique<QuICC::Transform::ALegendre_parallALT::ParallaltOp<phys_t, mods_t>>(mem);

    //using op_t = QuICC::Transform::ALegendre_parallALT::ParallaltOp<phys_t, mods_t, 1, opType>;
    //mOp = std::make_unique<QuICC::Transform::ALegendre_parallALT::ParallaltOp<phys_t, mods_t, 1, opType>>(mem);

    //using namespace QuICC::Transform::Quadrature;
   /* using namespace QuICC::Transform::ALegendre;
    using backend_t = Cuda::ImplOp<phys_t, mods_t, op_t>;
    using derived_t = Op<phys_t, mods_t, op_t, backend_t>;
    auto mem = std::make_shared<QuICC::Memory::Cuda::Malloc>();*/

    /*std::vector<std::uint32_t> layers(nLayers);
    for(std::uint32_t p = 0; p < nLayers; ++p)
    {
        layers[p] = this->mspSetup->slow(p);
    }*/

    /*mOp = std::make_unique<derived_t>(mem);
    derived_t& derivedOp = dynamic_cast<derived_t&>(*mOp);
    derivedOp.allocOp(dimensions, layers);
    auto opView = derivedOp.getOp();
    using namespace QuICC::Fft::ALegendre;
    OpsBuilder<op_t, P_t, bwd_t> tBuilder;
    tBuilder.compute(opView);*/

    ///\todo move view setups to init

    // alloc in/out dataspace
    // indices/pointers are the same for In/Out
    mDataPointers.resize(M+1);
    mDataPointers[0] = 0;

    std::uint32_t N = 0;
    std::uint32_t nCols = 0;
    std::uint32_t inFlatSize = 0;
    std::uint32_t layerCtr = 0;
    for (std::uint32_t i = 0; i < M; ++i)
    {
        std::uint32_t blockWidth = 0;
        std::uint32_t blockSize = 0;
        if (static_cast<std::uint32_t>(this->mspSetup->slow(layerCtr)) == i )
        {
            int nPoly = this->mspSetup->fastSize(layerCtr);
            blockWidth = static_cast<std::uint32_t>(this->mspSetup->mult(layerCtr));
            blockSize = blockWidth*nPoly;
            ++layerCtr;
        }

        nCols += blockWidth;
        mDataPointers[i+1] = nCols;
        inFlatSize += blockSize;

        /// make up indices, we don't know them and
        /// the exact value is needed only for the comm stage
        for (std::uint32_t idx = 0; idx < blockWidth; idx++)
        {
            mDataIndices.push_back(idx);
        }

        N = std::max(N, blockWidth);
    }

    // dim 0 - R  - radial modes
    // dim 1 - M  - harmonic order
    // dim 2 - L  - harmonic degree
    //std::array<std::uint32_t, rank> modsDims = {Ntheta, config_backward.M, config_backward.L};
    //mModsFlat.resize(config_backward.Ntheta* 2*(m_even_endBatch[config_backward.num_m_even -1] + m_odd_endBatch[config_backward.num_m_odd -1]));
    std::array<std::uint32_t, rank> modsDims = {L, N, M};
    mModsFlat.resize(Ntheta * nCols);//slightly more for now
    // dim 0 - Nr - radial points
    // dim 1 - M  - harmonic order
    // dim 2 - L  - harmonic degree
    //std::array<std::uint32_t, rank> physDims = {Ntheta, config_backward.M, config_backward.L};
    //mPhysFlat.resize(config_backward.Ntheta* 2*(m_even_endBatch[config_backward.num_m_even -1] + m_odd_endBatch[config_backward.num_m_odd -1]));
    std::array<std::uint32_t, rank> physDims = {Ntheta, N, M};
    mPhysFlat.resize(Ntheta * nCols);

    using namespace QuICC::View;

    // alloc device memory
    mModsFlat_d = std::move(QuICC::Memory::MemBlock<cuda::std::complex<double>>(mModsFlat.size(), mem.get()));
    mDataPointers_d = std::move(QuICC::Memory::MemBlock<std::uint32_t>(mDataPointers.size(), mem.get()));
    mDataIndices_d = std::move(QuICC::Memory::MemBlock<std::uint32_t>(mDataIndices.size(), mem.get()));
    mPhysFlat_d = std::move(QuICC::Memory::MemBlock<cuda::std::complex<double>>(mPhysFlat.size(), mem.get()));

    // set device pointers
    ViewBase<std::uint32_t> dataPointers_d[rank];
    dataPointers_d[1] = ViewBase<std::uint32_t>(mDataPointers_d.data(), mDataPointers_d.size());
    ViewBase<std::uint32_t> dataIndices_d[rank];
    dataIndices_d[1] = ViewBase<std::uint32_t>(mDataIndices_d.data(), mDataIndices_d.size());

    // copy to device memory
    cudaErrChk(cudaMemcpyAsync(reinterpret_cast<std::complex<double>*>(mModsFlat_d.data()), mModsFlat.data(),
        mModsFlat_d.size()*sizeof(cuda::std::complex<double>), cudaMemcpyHostToDevice));
    cudaErrChk(cudaMemcpyAsync(mDataPointers_d.data(), mDataPointers.data(),
        mDataPointers_d.size()*sizeof(std::uint32_t), cudaMemcpyHostToDevice));
    cudaErrChk(cudaMemcpyAsync(mDataIndices_d.data(), mDataIndices.data(),
        mDataIndices_d.size()*sizeof(std::uint32_t), cudaMemcpyHostToDevice));
    cudaErrChk(cudaMemcpyAsync(reinterpret_cast<std::complex<double>*>(mPhysFlat_d.data()), mPhysFlat.data(),
        mPhysFlat_d.size()*sizeof(cuda::std::complex<double>), cudaMemcpyHostToDevice));

    // set device views
    mModsView = mods_t(reinterpret_cast<std::complex<double>*>(mModsFlat_d.data()), mModsFlat_d.size(), modsDims.data(), dataPointers_d, dataIndices_d);
    mPhysView = phys_t(reinterpret_cast<std::complex<double>*>(mPhysFlat_d.data()), mPhysFlat_d.size(), physDims.data(), dataPointers_d, dataIndices_d);

    //cudaMalloc((void**)&appContainer_backward.input_buffer_S, 2*sizeof(double)*config_backward.Ntheta* (m_even_endBatch[config_backward.num_m_even -1] + m_odd_endBatch[config_backward.num_m_odd -1]));
    //cudaMalloc((void**)&appContainer_backward.buffer_S, 2*sizeof(double)*config_backward.Ntheta* (m_even_endBatch[config_backward.num_m_even -1] + m_odd_endBatch[config_backward.num_m_odd -1]));
    //resPfSolve = initializeParallALT(&VkGPU, config_backward, &appContainer_backward);
    
}

void @Op@<@Tag@>::applyOperators(MatrixZ& rOut, const MatrixZ& in) const
{
    Profiler::RegionFixture<2> fix("@Op@<@Tag@>::applyOperators");

    assert(static_cast<std::size_t>(in.rows()) == mModsView.dims()[0]);
    assert(static_cast<std::size_t>(in.cols()) == mModsView.indices()[1].size());
    assert(static_cast<std::size_t>(rOut.rows()) == mPhysView.dims()[0]);
    assert(static_cast<std::size_t>(rOut.cols()) == mPhysView.indices()[1].size());

    std::uint32_t nLayers = static_cast<std::uint32_t>(this->mspSetup->slowSize());

    /// copy data to view
    int start = 0;
    std::int64_t offSet = 0;
    for(std::uint32_t p = 0; p < nLayers; ++p)
    {
        int cols = this->mspSetup->mult(p);
        int inRows = this->mspSetup->fastSize(p);

        const Eigen::Ref<const MatrixZ> inB = in.block(0, start, inRows, cols);

        for (std::int64_t j = 0; j < inB.cols(); ++j)
        {
            for (std::int64_t i = 0; i < inB.rows(); ++i)
            {
#if defined QUICC_JW_ROW_MAJOR || defined QUICC_JW_ALL_ROW_MAJOR
               // copy padded to flattened and transpose
               mModsFlat[offSet + i * inB.cols() + j] =
                  inB.data()[i + j * in.rows()];
#else
               // copy padded to flattened column
               mModsFlat[offSet + i + j * inB.rows()] =
                  inB.data()[i + j * in.rows()];
#endif
            }
        }
        offSet += inB.size();
        start += cols;
    }

    @HostToDevice@

    /// apply
    mOp->apply(mPhysView, mModsView);

    /// copy back

    @DeviceToHost@

    start = 0;
    offSet = 0;
    int outRows = this->mspSetup->fwdSize();
    for(std::uint32_t p = 0; p < nLayers; p++)
    {
        int cols = this->mspSetup->mult(p);

        Eigen::Ref<MatrixZ> outB = rOut.block(0, start, outRows, cols);

#if defined QUICC_JW_ROW_MAJOR || defined QUICC_JW_ALL_ROW_MAJOR
        for (std::int64_t j = 0; j < outB.cols(); ++j)
        {
            for (std::int64_t i = 0; i < outB.rows(); ++i)
            {
                // copy padded to flattened column and transpose
                outB.data()[i+j*rOut.rows()]= mPhysFlat[offSet + i*outB.cols()+j];
            }
        }
#else
        for (std::int64_t i = 0; i < outB.size(); ++i)
        {
            outB.data()[i] = mPhysFlat[offSet + i];
        }
        #endif

        offSet += outB.size();
        start += cols;
    }
}

void @Op@<@Tag@>::makeOperator(Matrix& op, const int i) const
{
    throw std::logic_error("view ALegendre operator should never call this");
}

void @Op@<@Tag@>::applyOperators(Matrix& rOut, const MatrixZ& in) const
{
    throw std::logic_error("view ALegendre operator should never call this");
}

void @Op@<@Tag@>::applyOperator(Eigen::Ref<MatrixZ> rOut, const int i, const Eigen::Ref<const MatrixZ>& in) const
{
    throw std::logic_error("view ALegendre operator should never call this");
}

