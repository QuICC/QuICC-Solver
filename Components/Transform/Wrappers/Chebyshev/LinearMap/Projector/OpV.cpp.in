/**
 * @file @Op@.cpp
 * @brief Wrapper of the Chebyshev LinearMap @Op@ @Kind@
 */

#include "QuICC/Transform/Wrappers/Chebyshev/LinearMap/Projector/@Op@@Tag@.hpp.inc"
#include "View/ViewSparse.hpp"
#include "Memory/Cpu/NewDelete.hpp"
#include "ViewOps/Chebyshev/LinearMap/OpsType.hpp"
#include "ViewOps/Chebyshev/LinearMap/Tags.hpp"
#include "Profiler/Interface.hpp"
@CppHeader@

namespace QuICC {
namespace Transform {
namespace Fft {
namespace Chebyshev {
namespace LinearMap {
namespace @Kind@ {

void @Op@<@Tag@>::initBackend() const
{
    Profiler::RegionFixture<3> fix("@Op@<@Tag@>::initBackend");

    std::uint32_t nR = mspSetup->fwdSize();
    std::uint32_t nN = mspSetup->specSize();

    // Make operators
    using namespace QuICC::Transform::Chebyshev;
    using namespace QuICC::Transform::Chebyshev::LinearMap;

    auto mem = std::make_shared<QuICC::Memory::@MemRes@>();
    using op_t = OpsType<@OpInOut@, @Op@_t, @OpDirection@, Transform::Chebyshev::LinearMap::@Tag@>;
    mOp = std::make_unique<op_t>(@Mem@, mspSetup->lower(), this->mspSetup->upper());

    constexpr size_t rank = 3;
    std::uint32_t nLayers = static_cast<std::uint32_t>(this->mspSetup->slowSize());

    ///\todo this should be the full matrix size
    std::uint32_t L = static_cast<std::uint32_t>(this->mspSetup->slow(nLayers-1)) + 1;

    // alloc in/out dataspace
    // indices/pointers are the same for In/Out
    mDataPointers.resize(L+1);
    mDataPointers[0] = 0;

    std::uint32_t M = 0;
    std::uint32_t nCols = 0;
    std::uint32_t layerCtr = 0;
    for (std::uint32_t i = 0; i < L; ++i)
    {
        std::uint32_t blockWidth = 0;
        if (static_cast<std::uint32_t>(this->mspSetup->slow(layerCtr)) == i )
        {
            blockWidth = static_cast<std::uint32_t>(this->mspSetup->mult(layerCtr));
            ++layerCtr;
        }

        nCols += blockWidth;
        mDataPointers[i+1] = nCols;

        /// make up indices, we don't know them and
        /// the exact value is needed only for the comm stage
        for (std::uint32_t idx = 0; idx < blockWidth; idx++)
        {
            mDataIndices.push_back(idx);
        }

        M = std::max(M, blockWidth);
    }

    // dim 0 - R  - radial modes
    // dim 1 - M  - harmonic order
    // dim 2 - L  - harmonic degree
    std::array<std::uint32_t, rank> modsDims = {nN, M, L};
    mModsFlat.resize(nN*nCols);

    // dim 0 - Nr - radial points
    // dim 1 - M  - harmonic order
    // dim 2 - L  - harmonic degree
    std::array<std::uint32_t, rank> physDims = {nR, M, L};
    mPhysFlat.resize(nR * nCols);

    using namespace QuICC::View;

    @SetDataViews@
}

void @Op@<@Tag@>::transform(MatrixZ& rOut, const MatrixZ& in) const
{
    Profiler::RegionFixture<2> fix("@Op@<@Tag@>::transform");

    assert(static_cast<std::size_t>(in.rows()) == mModsView.dims()[0]);
    assert(static_cast<std::size_t>(in.cols()) == mModsView.indices()[1].size());
    assert(static_cast<std::size_t>(rOut.rows()) == mPhysView.dims()[0]);
    assert(static_cast<std::size_t>(rOut.cols()) == mPhysView.indices()[1].size());

    std::uint32_t nLayers = static_cast<std::uint32_t>(this->mspSetup->slowSize());
    int inRows = this->mspSetup->specSize();

    /// copy data to view
    int start = 0;
    std::int64_t offSet = 0;
    for(std::uint32_t p = 0; p < nLayers; ++p)
    {
        int cols = this->mspSetup->mult(p);

        const Eigen::Ref<const MatrixZ> inB = in.block(0, start, inRows, cols);

        for (std::int64_t j = 0; j < inB.cols(); ++j)
        {
            for (std::int64_t i = 0; i < inB.rows(); ++i)
            {
               // copy padded to flattened column
               mModsFlat[offSet + i + j * inB.rows()] =
                  inB.data()[i + j * in.rows()];
            }
        }
        offSet += inB.size();
        start += cols;
    }

    @HostToDevice@

    /// apply
    mOp->apply(mPhysView, mModsView);

    /// copy back

    @DeviceToHost@

    start = 0;
    offSet = 0;
    int outRows = this->mspSetup->fwdSize();
    for(std::uint32_t p = 0; p < nLayers; p++)
    {
        int cols = this->mspSetup->mult(p);

        Eigen::Ref<MatrixZ> outB = rOut.block(0, start, outRows, cols);

        for (std::int64_t i = 0; i < outB.size(); ++i)
        {
            outB.data()[i] = mPhysFlat[offSet + i];
        }

        offSet += outB.size();
        start += cols;
    }
}

void @Op@<@Tag@>::transform(Matrix& rOut, const Matrix& in) const
{
   throw std::logic_error("Real chebyshev transform not implemented");
}

} // namespace Projector
} // namespace LinearMap
} // namespace Chebyshev
} // namespace Fft
} // namespace Transform
} // namespace QuICC
