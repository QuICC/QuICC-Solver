Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Poloidal", " ", "mass", " ", "matrix"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Timing", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diagonalMP", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"l", ">", "0"}], ",", 
          RowBox[{"buildOperator", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"nN", ",", "nN", ",", "l"}], "}"}], ",", " ", "sphlapl", 
            ",", "bgrid", ",", "bweights", ",", "ValueSphJnl", ",", 
            "ValueSphJnl", ",", "True"}], "]"}], ",", 
          RowBox[{"0", 
           RowBox[{"IdentityMatrix", "[", "nN", "]"}]}]}], "]"}], "]"}], ",", 
       
       RowBox[{"{", 
        RowBox[{"l", ",", "m", ",", "maxL"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"matMP", "=", 
     RowBox[{"BlockDiagonalMatrix", "[", "diagonalMP", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
