Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Compute", " ", "eigen", " ", "spectrum"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Timing", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ev", "=", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Chop", "@", "matQ"}], ",", 
         RowBox[{"Chop", "@", "matM"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "==", "0"}], ",", 
       RowBox[{"ev", "=", 
        RowBox[{
         RowBox[{"Sort", "[", "ev", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "nN"}], "+", "1"}], ")"}]}]}], "]"}], "]"}]}]}], 
      "]"}], ";"}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ComplexListPlot", "[", 
       RowBox[{"ev", ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}]}], "]"}], ",", 
      RowBox[{"ListPlot", "[", 
       RowBox[{"Im", "@", "ev"}], "]"}]}], "}"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"ev", ",", "5"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "20"}], "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"Im", "@", "ev"}]}], ",", "5"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "20"}], "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"Re", "@", "ev"}]}], ",", "5"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "20"}], "]"}], "]"}]}]}]], "Input",
