Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Coriolis", " ", "matrix", " ", "and", " ", "mass", " ", "matrix"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Timing", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"matQ", "=", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"e", "[", 
         RowBox[{"1", ",", "1", ",", "2"}], "]"}], ",", 
        RowBox[{"-", "matT"}]}], "]"}], " ", "+", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"e", "[", 
         RowBox[{"1", ",", "2", ",", "2"}], "]"}], ",", "matQP"}], "]"}], " ",
       "+", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"e", "[", 
         RowBox[{"2", ",", "1", ",", "2"}], "]"}], ",", 
        RowBox[{"-", "matQT"}]}], "]"}], "+", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"e", "[", 
         RowBox[{"2", ",", "2", ",", "2"}], "]"}], ",", 
        RowBox[{"-", "matP"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"matM", "=", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"e", "[", 
         RowBox[{"1", ",", "1", ",", "2"}], "]"}], ",", "matMT"}], "]"}], " ",
       "+", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"e", "[", 
         RowBox[{"2", ",", "2", ",", "2"}], "]"}], ",", "matMP"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.919337379293543*^9, 3.91933746494128*^9}, {
   3.919337994401496*^9, 3.919338025140799*^9}, {3.919338119130103*^9, 
