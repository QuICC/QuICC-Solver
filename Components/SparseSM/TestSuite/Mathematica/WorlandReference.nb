Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"testBoundary", "[", 
    RowBox[{"meta_", ",", "id_", ",", "opfunc_", ",", "name_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"outprec", " ", "=", " ", "32"}], ",", 
       RowBox[{"rBc", "=", "1"}], ",", "maxN", ",", "norm", ",", "l", ",", 
       "ref", ",", "descr", ",", "msg", ",", "tempmsg", ",", "fbase", ",", 
       "fname"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"l", " ", "=", 
       RowBox[{"meta", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"maxN", "=", 
       RowBox[{"meta", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ref", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"opfunc", "[", 
            RowBox[{"j", ",", "l", ",", "rBc"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "maxN"}], "}"}]}], "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"ref", " ", "=", 
       RowBox[{"N", "[", 
        RowBox[{"ref", ",", "outprec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"msg", "=", 
       RowBox[{
       "\"\<Exporting \>\"", "<>", "name", "<>", 
        "\"\< Worland boundary of truncation \>\"", "<>", 
        RowBox[{"ToString", "[", "maxN", "]"}], "<>", 
        "\"\< for \[Alpha] = \>\"", " ", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"N", "[", "$w\[Alpha]", "]"}], "]"}], "<>", 
        "\"\<, d\[Beta] = \>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"N", "[", "$wd\[Beta]", "]"}], "]"}], "<>", "\"\<, l = \>\"",
         "<>", 
        RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<...\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fbase", "=", 
       RowBox[{"name", "<>", "\"\<_id\>\"", "<>", 
        RowBox[{"ToString", "[", "id", "]"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"fbase", " ", "=", " ", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Boundary\>\"", ",", "fbase"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fname", "=", 
       RowBox[{"fbase", "<>", "\"\<_meta.dat\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"descr", "=", 
       RowBox[{"Flatten", "[", "meta", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"descr", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Insert", "[", 
         RowBox[{"descr", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"$w\[Alpha]", ",", "outprec"}], "]"}], ",", 
            RowBox[{"N", "[", 
             RowBox[{"$wd\[Beta]", ",", "outprec"}], "]"}]}], "}"}], ",", 
          "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"descr", " ", "=", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{"descr", ",", 
         RowBox[{"Length", "@", "descr"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
         "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"fname", "=", 
       RowBox[{"fbase", "<>", "\"\<_ref.dat\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
         "]"}], ",", "ref", ",", "\"\<Table\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
