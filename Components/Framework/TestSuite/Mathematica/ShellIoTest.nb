Cell[BoxData[{
 RowBox[{
  RowBox[{"specTorV", "[", 
   RowBox[{"n_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "s", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"l", ">", "0"}], "&&", 
        RowBox[{"n", "<=", " ", "maxN"}], " ", "&&", " ", 
        RowBox[{"l", "<=", " ", "maxL"}], " ", "&&", " ", 
        RowBox[{"m", " ", "<=", " ", "maxM"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"n", "+", "1"}]], "+", 
           RowBox[{
            FractionBox["2", 
             RowBox[{"n", "+", "1"}]], "\[ImaginaryI]"}]}], ")"}]}], ";"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "=", "0"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "==", "0"}], ",", 
       RowBox[{"Re", "[", "s", "]"}], ",", "s"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"specTorVr", "[", 
   RowBox[{"r_", ",", "l_", ",", "m_"}], "]"}], ":=", 
