         RowBox[{
          RowBox[{
           RowBox[{"specT", "[", 
            RowBox[{"i", ",", "l", ",", "m"}], "]"}], 
           RowBox[{"Tnab", "[", 
            RowBox[{"i", ",", "a", ",", "b", ",", "r"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "maxN"}], "}"}]}], "]"}], "//", 
        "Simplify"}], "//", "ComplexExpand"}]}], ";", "\[IndentingNewLine]", 
     "f"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
