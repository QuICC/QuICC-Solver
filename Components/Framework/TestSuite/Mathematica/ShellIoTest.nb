     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"pol", " ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"SphericalHarmonicY", "[", 
          RowBox[{"1", ",", "1", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
         "]"}], 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], "/", "ro"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
