Cell[BoxData[
 RowBox[{
  RowBox[{"computeSPM", "[", 
   RowBox[{"f_", ",", "maxM_"}], "]"}], " ", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"spm", ",", "ms", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"spm", " ", "=", " ", 
      RowBox[{"2", "\[Pi]", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"FourierCoefficient", "[", 
          RowBox[{"f", ",", "\[Phi]", ",", "k"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "maxM"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ms", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "0"}], ",", 
       RowBox[{"i", "<=", "maxM"}], ",", " ", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"PossibleZeroQ", "[", 
            RowBox[{"spm", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ms", ",", "i"}], "]"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "ms", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"spm", ",", "ms"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.876461579172879*^9, 3.8764616939603233`*^9}, {
  3.876461732548491*^9, 3.876461790823781*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"57a82ccb-8b1e-45a2-a1b9-84d0575faf06"],

