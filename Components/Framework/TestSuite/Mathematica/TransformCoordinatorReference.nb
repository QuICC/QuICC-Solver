             RowBox[{"{", 
              RowBox[{"\[Theta]", "->", "ltg"}], "}"}]}], ")"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"l", "==", "0"}], ",", "0", " ", ",", 
