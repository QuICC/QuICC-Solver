               RowBox[{"[", "k", "]"}], "]"}], ",", "maxL"}], "}"}]}], 
           "]"}]}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"Length", "@", "ms"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", "spmg", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"PossibleZeroQ", "[", 
        RowBox[{"splm", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ";", 
