Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"computeLoop", "[", "tId_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dN", ",", "dL", ",", "dM", ",", "dLM", ",", "imax", ",", "inL", ",", 
       "inM", ",", "useTor", ",", "usePol", ",", " ", "amp", ",", "ftag", ",",
        "meta", ",", "fbase", ",", "fname", ",", "inData", ",", "col", ",", 
       "f", ",", "fc", ",", "testTor", ",", "testPol", ",", "u", ",", "cu", 
       ",", "nlu", ",", "nlTor", ",", "nlPol", ",", "nlP", ",", "nlT", ",", 
       "hasNlP", ",", "hasNlT"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "imax", ",", "inL", ",", "inM", ",", "useTor", ",", "usePol", ",", 
         "amp", ",", "ftag"}], "}"}], " ", "=", " ", 
       RowBox[{"tests", "[", "tId", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{
        "imax", ",", "inL", ",", "inM", ",", "useTor", ",", "usePol", ",", 
         "amp", ",", "ftag"}], "}"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"fbase", "=", 
       RowBox[{"ftag", "<>", "\"\<_id\>\"", "<>", 
        RowBox[{"ToString", "[", "tId", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dN", " ", "=", 
       RowBox[{"inL", "+", 
        RowBox[{"2", " ", "imax"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dL", " ", "=", " ", 
       RowBox[{"2", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"inL", ",", "inM"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dM", " ", "=", " ", 
       RowBox[{"2", 
        RowBox[{"Max", "[", 
         RowBox[{"inL", ",", "inM"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dLM", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"dL", "+", "1", "-", "k"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{"dM", "-", "1"}]}], "}"}]}], "]"}], "+", "2"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fbase", "=", 
       RowBox[{"ftag", "<>", "\"\<_id\>\"", "<>", 
        RowBox[{"ToString", "[", "tId", "]"}]}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Write", " ", "metadata", " ", "file"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"meta", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"dN", ",", "dL", ",", "dM", ",", "dLM"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"PrependTo", "[", 
       RowBox[{"meta", ",", 
        RowBox[{"Length", "@", "meta"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"fname", "=", 
       RowBox[{"fbase", "<>", "\"\<_meta.dat\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
         "]"}], ",", "meta"}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Toroidal", " ", "input", " ", "data"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"inData", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"dN", "+", "1"}], ",", " ", "dLM"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"col", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"dL", "+", "1", "-", "m"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "0", ",", 
            RowBox[{"inM", "-", "1"}]}], "}"}]}], "]"}], "+", "1", " ", "+", 
        " ", "inL", "-", "inM"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"inData", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"1", ";;", 
           RowBox[{"(", 
            RowBox[{"1", "+", "imax"}], ")"}]}], ",", "col"}], "]"}], "]"}], 
       "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"useTor", 
          RowBox[{"(", 
           RowBox[{"amp", "-", 
            RowBox[{"amp", " ", "\[ImaginaryI]", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"inM", "==", "0"}], ",", "0", ",", "1"}], "]"}]}]}], 
           ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "imax"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"inData", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Re", "[", "inData", "]"}], ",", 
           RowBox[{"Im", "[", "inData", "]"}]}], "]"}], ",", "outprec"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fname", "=", 
       RowBox[{"fbase", "<>", "\"\<_tor_in.dat\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
         "]"}], ",", "inData", ",", "\"\<Table\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Poloidal", " ", "input", " ", "data"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"inData", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"dN", "+", "1"}], ",", " ", "dLM"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"col", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"dL", "+", "1", "-", "m"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "0", ",", 
