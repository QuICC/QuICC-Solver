        " ", "inL", "-", "inM"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"inData", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"1", ";;", 
           RowBox[{"(", 
            RowBox[{"1", "+", "imax"}], ")"}]}], ",", "col"}], "]"}], "]"}], 
       "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"usePol", 
          RowBox[{"(", 
           RowBox[{"amp", "-", 
            RowBox[{"amp", " ", "\[ImaginaryI]", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"inM", "==", "0"}], ",", "0", ",", "1"}], "]"}]}]}], 
           ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "imax"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"inData", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Re", "[", "inData", "]"}], ",", 
           RowBox[{"Im", "[", "inData", "]"}]}], "]"}], ",", "outprec"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fname", "=", 
       RowBox[{"fbase", "<>", "\"\<_pol_in.dat\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
         "]"}], ",", "inData", ",", "\"\<Table\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Analytical", " ", "input"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"f", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Wnl", "[", 
            RowBox[{"i", ",", "inL", ",", "r"}], "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"amp", "/", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"inM", "==", "0"}], ",", "2", ",", "1"}], "]"}]}], 
             "-", 
             RowBox[{"amp", " ", "\[ImaginaryI]"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "imax"}], "}"}]}], "]"}], "//", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fc", "=", 
       RowBox[{
        RowBox[{"Conjugate", "[", "f", "]"}], "//", "ComplexExpand"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"testTor", " ", "=", " ", 
       RowBox[{"useTor", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f", " ", 
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"inL", ",", "inM", ",", "\[Theta]", ",", "\[Phi]"}], 
            "]"}]}], "+", 
          RowBox[{"fc", " ", 
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"inL", ",", 
             RowBox[{"-", "inM"}], ",", "\[Theta]", ",", "\[Phi]"}], 
            "]"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"testPol", " ", "=", " ", 
       RowBox[{"usePol", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f", " ", 
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"inL", ",", "inM", ",", "\[Theta]", ",", "\[Phi]"}], 
            "]"}]}], "+", 
          RowBox[{"fc", " ", 
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{"inL", ",", 
             RowBox[{"-", "inM"}], ",", "\[Theta]", ",", "\[Phi]"}], 
            "]"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Evaluate", " ", "nonlinear", " ", "term"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{
        RowBox[{"Curl", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"r", " ", "testTor"}], ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
          "\"\<Spherical\>\""}], "]"}], " ", "+", " ", 
        RowBox[{"Curl", "[", 
         RowBox[{
          RowBox[{"Curl", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"r", " ", "testPol"}], ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
            "\"\<Spherical\>\""}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
          "\"\<Spherical\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ftag", " ", "==", " ", "\"\<inertia\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"cu", " ", "=", " ", 
          RowBox[{"Curl", "[", 
           RowBox[{"u", ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
            "\"\<Spherical\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"nlu", " ", "=", 
          RowBox[{
           RowBox[{"Cross", "[", 
            RowBox[{"u", ",", "cu"}], "]"}], "//", "Simplify"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ftag", " ", "==", " ", "\"\<field\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"nlu", " ", "=", " ", "u"}], ";"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Toroidal", "/", "Poloidal"}], " ", "representation"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"nlTor", "=", " ", 
       RowBox[{"r", " ", 
        RowBox[{
         RowBox[{"Curl", "[", 
          RowBox[{"nlu", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
           "\"\<Spherical\>\""}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nlT", "=", 
       RowBox[{"Simplify", "@", "nlTor"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"hasNlT", "=", 
       RowBox[{"!", 
        RowBox[{"PossibleZeroQ", "[", "nlT", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nlPol", "=", " ", 
       RowBox[{"r", " ", 
        RowBox[{
         RowBox[{"Curl", "[", 
          RowBox[{
           RowBox[{"Curl", "[", 
            RowBox[{"nlu", ",", 
             RowBox[{"{", 
              RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
             "\"\<Spherical\>\""}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
           "\"\<Spherical\>\""}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nlP", "=", 
       RowBox[{"Simplify", "@", "nlPol"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"hasNlP", "=", 
       RowBox[{"!", 
        RowBox[{"PossibleZeroQ", "[", "nlP", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{"hasNlT", ",", "hasNlP"}], "}"}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Compute", " ", "Toroidal"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"hasNlT", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"spmT", ",", "msT"}], "}"}], "=", 
          RowBox[{"computeSPM", "[", 
           RowBox[{"nlT", ",", 
            RowBox[{"2", "inM"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"splmT", "=", 
          RowBox[{"computeSPLM", "[", 
           RowBox[{"spmT", ",", "msT", ",", 
            RowBox[{"2", "inL"}], ",", "100"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
