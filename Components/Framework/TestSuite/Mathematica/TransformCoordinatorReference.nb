Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"writeREF", "[", 
    RowBox[{
    "spec_", ",", "ms_", ",", "maxL_", ",", "nn_", ",", "nlm_", ",", "cond_", 
     ",", "tag_", ",", "fbase_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"refData", ",", "im", ",", "col", ",", "cols", ",", "fname"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"refData", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"nn", " ", "+", " ", "1"}], ",", " ", "nlm"}], "]"}]}], ";", 
      "\n", 
      RowBox[{"If", "[", 
       RowBox[{"cond", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Do", "[", "\n", "  ", 
          RowBox[{
           RowBox[{
            RowBox[{"col", " ", "=", " ", 
             RowBox[{
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{"maxL", " ", "+", " ", "1", " ", "-", " ", "k"}], ",",
                 " ", 
                RowBox[{"{", 
                 RowBox[{"k", ",", " ", "0", ",", " ", 
                  RowBox[{
                   RowBox[{"ms", "[", 
                    RowBox[{"[", "im", "]"}], "]"}], " ", "-", " ", "1"}]}], 
                 "}"}]}], "]"}], " ", "+", " ", "1"}]}], ";", "\n", "  ", 
            RowBox[{"cols", " ", "=", " ", 
             RowBox[{
              RowBox[{"Dimensions", "[", 
               RowBox[{"spec", "[", 
                RowBox[{"[", "im", "]"}], "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
            RowBox[{
             RowBox[{"refData", "[", 
              RowBox[{"[", 
               RowBox[{";;", " ", ",", " ", 
                RowBox[{"col", " ", ";;", " ", 
                 RowBox[{
                 "col", " ", "+", " ", "cols", " ", "-", " ", "1"}]}]}], 
               "]"}], "]"}], " ", "=", " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"spec", "[", 
               RowBox[{"[", "im", "]"}], "]"}], "]"}]}], ";"}], "\n", "  ", 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{"im", ",", " ", "1", ",", " ", 
             RowBox[{"Length", "@", "ms"}]}], "}"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\n", 
      RowBox[{"refData", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Re", "[", "refData", "]"}], ",", " ", 
           RowBox[{"Im", "[", "refData", "]"}]}], "]"}], ",", " ", 
         "outprec"}], "]"}]}], ";", "\n", 
      RowBox[{"fname", " ", "=", " ", 
       RowBox[{"fbase", " ", "<>", " ", "tag", "<>", "\"\<_ref.dat\>\""}]}], 
      ";", "\n", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{"dataroot", ",", " ", "refdir", ",", " ", "fname"}], "}"}],
           "]"}], "]"}], ",", " ", "refData", ",", " ", "\"\<Table\>\""}], 
       "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
