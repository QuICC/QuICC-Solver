Cell[BoxData[
 RowBox[{
  RowBox[{"characteristic", "[", 
   RowBox[{"w_", ",", "v_", ",", "t_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", ",", "vtot", ",", "sd", ",", "pc"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vtot", "=", 
      RowBox[{"Total", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"vtot", "!=", "0"}], ",", 
        RowBox[{
         RowBox[{"Dot", "[", 
          RowBox[{"w", ",", "v"}], "]"}], "/", "vtot"}], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sd", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"vtot", "!=", "0"}], ",", 
        SqrtBox[
         FractionBox[
          RowBox[{"Dot", "[", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"w", "-", "c"}], ")"}], "2"], ",", "v"}], "]"}], 
          "vtot"]], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pc", "=", 
      RowBox[{"100", 
       RowBox[{"(", 
        RowBox[{"vtot", "/", "t"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"c", ",", "sd", ",", "pc"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
