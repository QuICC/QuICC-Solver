Cell[BoxData[{
 RowBox[{
  RowBox[{"specT", "[", 
   RowBox[{"n_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "s", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"i", "+", "1"}]], "+", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"i", "+", "1"}]], "\[ImaginaryI]"}]}], ")"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "==", "0"}], ",", 
       RowBox[{"Re", "[", "s", "]"}], ",", "s"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"specTr", "[", 
   RowBox[{"r_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "f", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{
