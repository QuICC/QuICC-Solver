Cell[BoxData[{
 RowBox[{
  RowBox[{"specT", "[", 
   RowBox[{"n_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "s", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"n", "<=", " ", "maxN"}], " ", "&&", " ", 
        RowBox[{"l", "<=", " ", "maxL"}], " ", "&&", " ", 
        RowBox[{"m", " ", "<=", " ", "maxM"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["3", 
            RowBox[{"n", "+", "1"}]], "+", 
           RowBox[{
            FractionBox["2", 
             RowBox[{"n", "+", "1"}]], "\[ImaginaryI]"}]}], ")"}]}], ";"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "=", "0"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "==", "0"}], ",", 
       RowBox[{"Re", "[", "s", "]"}], ",", "s"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"specTr", "[", 
   RowBox[{"r_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "f", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"specT", "[", 
            RowBox[{"i", ",", "l", ",", "m"}], "]"}], 
           RowBox[{"Wnl", "[", 
            RowBox[{"i", ",", "l", ",", "r"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "maxN"}], "}"}]}], "]"}], "//", 
        "Simplify"}], "//", "ComplexExpand"}]}], ";", "\[IndentingNewLine]", 
     "f"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
