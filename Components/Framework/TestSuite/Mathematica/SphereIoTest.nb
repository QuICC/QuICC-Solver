Cell[BoxData[
 RowBox[{
  RowBox[{"torV", "[", 
   RowBox[{"r_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "f", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"l", "==", "0"}], ",", "\[IndentingNewLine]", "0", ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"f", "=", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", 
               RowBox[{"i", "+", "1"}]], "+", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"i", "+", "1"}]], "\[ImaginaryI]"}]}], ")"}], 
            RowBox[{"Wnl", "[", 
             RowBox[{"i", ",", "l", ",", "r"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "maxN"}], "}"}]}], "]"}], "//", 
         "Simplify"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"f", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"m", ">", "0"}], ",", "2", ",", "1"}], "]"}], 
           RowBox[{"Re", "[", 
            RowBox[{"f", " ", 
             RowBox[{"SphericalHarmonicY", "[", 
              RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
              "]"}]}], "]"}]}], "//", "ComplexExpand"}], "//", "Simplify"}]}],
        ";", "\[IndentingNewLine]", "f"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
