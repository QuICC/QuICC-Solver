Cell[BoxData[{
 RowBox[{
  RowBox[{"ETornmode", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "vol"}]], 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"funcR", "=", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"specTorV", "[", 
             RowBox[{"i", ",", "l", ",", "m"}], "]"}], 
            RowBox[{"Wnl", "[", 
             RowBox[{"i", ",", "l", ",", "r"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "maxN"}], "}"}]}], "]"}], "//", 
         "Simplify"}]}], ";", 
       RowBox[{"funcR", "=", 
        RowBox[{"funcR", "/.", 
         RowBox[{"{", 
          RowBox[{"r", "->", "rsph"}], "}"}]}]}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "funcR", "]"}]}], ",", 
         RowBox[{
          RowBox[{"funcR", " ", "=", 
           RowBox[{"funcR", " ", "+", " ", 
            RowBox[{"0", " ", "rsph"}]}]}], ";"}]}], "]"}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{
          RowBox[{"wsph", " ", 
           RowBox[{"Wnabl", "[", 
            RowBox[{
            "n", ",", "$wsph\[Alpha]", ",", "$wsphd\[Beta]", ",", "l", ",", 
             "rsph"}], "]"}]}], ",", "funcR"}], "]"}]}], ";", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Norm", "[", "s", "]"}], "2"], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"m", "==", "0"}], ",", "1", ",", "2"}], "]"}], "l", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "maxN"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "maxM"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "m", ",", "maxL"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
