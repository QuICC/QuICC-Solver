Cell[BoxData[{
 RowBox[{
  RowBox[{"Ermode", "=", 
   RowBox[{
    FractionBox["1", "vol"], 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"funcR", "=", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"specT", "[", 
             RowBox[{"i", ",", "l", ",", "m"}], "]"}], 
            RowBox[{"Wnl", "[", 
             RowBox[{"i", ",", "l", ",", "r"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "maxN"}], "}"}]}], "]"}], "//", 
         "Simplify"}]}], ";", 
       RowBox[{"funcR", "=", 
        RowBox[{"funcR", "/.", 
         RowBox[{"{", 
          RowBox[{"r", "->", "grid"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "funcR", "]"}]}], ",", 
         RowBox[{
          RowBox[{"funcR", " ", "=", 
           RowBox[{"funcR", " ", "+", " ", 
            RowBox[{"0", " ", "grid"}]}]}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Norm", "[", 
          RowBox[{"funcR", "[", 
           RowBox[{"[", "n", "]"}], "]"}], "]"}], "2"], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"m", "==", "0"}], ",", "1", ",", "2"}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "nR"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "maxM"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "m", ",", "maxL"}], "}"}]}], "]"}]}]}], 
