          RowBox[{
           RowBox[{"specT", "[", 
            RowBox[{"i", ",", "l", ",", "m"}], "]"}], 
           RowBox[{"Wnl", "[", 
            RowBox[{"i", ",", "l", ",", "r"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "maxN"}], "}"}]}], "]"}], "//", 
        "Simplify"}], "//", "ComplexExpand"}]}], ";", "\[IndentingNewLine]", 
     "f"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
