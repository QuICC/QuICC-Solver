    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Curl", "[", 
         RowBox[{
          RowBox[{"Curl", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"polV", "[", 
                  RowBox[{"r", ",", "l", ",", "0"}], "]"}], "+", 
                 RowBox[{"polV", "[", 
                  RowBox[{"r", ",", "l", ",", "1"}], "]"}]}], ")"}], "r"}], 
              ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
            "\"\<Spherical\>\""}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
          "\"\<Spherical\>\""}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       FractionBox["r", 
        RowBox[{"l", 
         RowBox[{"(", 
          RowBox[{"l", "+", "1"}], ")"}]}]]}], "//", "Simplify"}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{"r", "->", "1"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", 
