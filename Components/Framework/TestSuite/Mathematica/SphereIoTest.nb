       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"n", "+", "1"}]], "+", 
           RowBox[{
            FractionBox["2", 
             RowBox[{"n", "+", "1"}]], "\[ImaginaryI]"}]}], ")"}]}], ";"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "=", "0"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "==", "0"}], ",", 
