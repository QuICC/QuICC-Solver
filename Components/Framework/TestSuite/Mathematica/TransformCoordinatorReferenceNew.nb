             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"spec", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"n", "+", "1"}], ",", "j"}], "]"}], "]"}], "!=", 
                 "0"}], ",", 
                RowBox[{
                 RowBox[{"spec", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"n", "+", "1"}], ",", "j"}], "]"}], "]"}], 
                 RowBox[{"Wnl", "[", 
                  RowBox[{"n", ",", "l", ",", "r"}], "]"}]}], ",", "0"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "0", ",", "maxN"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"cfr", "=", 
            RowBox[{
             RowBox[{"Conjugate", "[", "fr", "]"}], "//", "ComplexExpand"}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"f", " ", "+=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"fr", " ", 
               RowBox[{"SphericalHarmonicY", "[", 
                RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
                "]"}]}], "+", 
              RowBox[{"cfr", " ", 
               RowBox[{"SphericalHarmonicY", "[", 
                RowBox[{"l", ",", 
                 RowBox[{"-", "m"}], ",", "\[Theta]", ",", "\[Phi]"}], 
                "]"}]}]}], ")"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"j", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"f", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{"f", ",", 
           RowBox[{"TimeConstraint", "->", "$MaxSimplifyTime"}]}], "]"}]}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "f"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
