      RowBox[{"lg", "=", 
       RowBox[{"lgrid", "[", "ng", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lw", "=", 
       RowBox[{"lweights", "[", "ng", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"flm", " ", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"f", "=", 
             RowBox[{"Transpose", "[", 
              RowBox[{"fmg", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"ms", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "+", "1"}], "]"}], "]"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"l", "==", "0"}], ",", "0", " ", ",", 
               FractionBox["1", 
                RowBox[{"l", 
                 RowBox[{"(", 
                  RowBox[{"l", "+", "1"}], ")"}]}]]}], "]"}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"lw", " ", 
                RowBox[{"Plm", "[", 
                 RowBox[{"l", ",", 
                  RowBox[{"ms", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", "lg"}], "]"}]}], 
               ")"}], ".", "f"}]}]}], "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"l", ",", 
             RowBox[{"ms", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", "maxL"}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"Length", "@", "ms"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", "f", "]"}], ";", "\[IndentingNewLine]", "flm"}]}],
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"forwardALegendreAnalytic", "[", 
    RowBox[{"fm_", ",", "ms_", ",", "maxL_", ",", "ng_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ltg", ",", "fmg"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ltg", "=", 
       RowBox[{"ArcCos", "[", 
        RowBox[{"lgrid", "[", "ng", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fmg", "=", 
       RowBox[{"(", 
        RowBox[{"fm", "/.", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", "->", "ltg"}], "}"}]}], ")"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"forwardALegendre", "[", 
       RowBox[{"fmg", ",", "ms", ",", "maxL", ",", "ng"}], "]"}]}]}], 
