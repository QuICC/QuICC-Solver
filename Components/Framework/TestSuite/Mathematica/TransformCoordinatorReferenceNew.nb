Cell[BoxData[
 RowBox[{
  RowBox[{"formatData", "[", 
   RowBox[{"maxN_", ",", "maxL_", ",", "maxM_", ",", "fnlm_", ",", "ms_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ref", ",", "nLM", ",", "im", ",", "m", ",", "l", ",", "s", ",", "ilm", 
      ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nLM", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"maxL", "+", "1", "-", "m"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", "maxM"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ref", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"maxN", "+", "1"}], ",", " ", "nLM"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"im", "=", "1"}], ",", 
       RowBox[{"im", "<=", 
        RowBox[{"Length", "[", "ms", "]"}]}], ",", 
       RowBox[{"im", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"m", "=", 
         RowBox[{"ms", "[", 
          RowBox[{"[", "im", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"m", "==", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"c", "=", 
            FractionBox["1", "2"]}], ";"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"c", "=", "1"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"l", "=", "m"}], ",", 
          RowBox[{"l", "<=", " ", "maxL"}], ",", 
          RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{"Transpose", "[", 
             RowBox[{
              RowBox[{"fnlm", "[", 
               RowBox[{"[", "im", "]"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"l", "-", "m", "+", "1"}], ",", ";;"}], "]"}], "]"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"ilm", "=", 
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"k", "+", "1"}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "0", ",", 
