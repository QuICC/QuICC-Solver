Cell[BoxData[{
 RowBox[{
  RowBox[{"forwardFourier", "[", 
   RowBox[{"f_", ",", "maxM_"}], "]"}], " ", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fg", ",", "tm", ",", "fm", ",", "ms", ",", "i", ",", "ng", ",", "phi", 
      ",", "k", ",", "nI", ",", "nJ", ",", "nK"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nI", ",", "nJ", ",", "nK"}], "}"}], "=", 
      RowBox[{"Dimensions", "[", "f", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tm", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"2", "\[Pi]", " ", 
         RowBox[{"Fourier", "[", 
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j", ",", ";;"}], "]"}], "]"}], ",", 
           RowBox[{"FourierParameters", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nI"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "nJ"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fm", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"tm", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "i"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"maxM", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ms", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{"i", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "maxM"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"fm", ",", "ms"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"forwardFourierAnalytic", "[", 
   RowBox[{"f_", ",", "maxM_"}], "]"}], " ", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fm", ",", "ms", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fm", " ", "=", " ", 
      RowBox[{"2", "\[Pi]", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"FourierCoefficient", "[", 
          RowBox[{"f", ",", "\[Phi]", ",", "k"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "maxM"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ms", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "0"}], ",", 
       RowBox[{"i", "<=", "maxM"}], ",", " ", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"PossibleZeroQ", "[", 
            RowBox[{"fm", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ms", ",", "i"}], "]"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"fm", ",", "ms"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True,
