             "m"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ref", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "ilm"}], "]"}], "]"}], "=", 
            RowBox[{"c", " ", "s"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "ref"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
