   RowBox[{"forwardALegendre", "[", 
    RowBox[{"fmg_", ",", "ms_", ",", "maxL_", ",", "ng_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lg", ",", "lw", ",", "flm", ",", "f"}], "}"}], ",", 
