Cell[BoxData[
 RowBox[{
  RowBox[{"referenceTorPolLoop", "[", 
   RowBox[{"meta_", ",", "subdir_", ",", "name_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "maxN", ",", " ", "maxL", ",", " ", "maxM", ",", "pId", ",", "kId", ",", 
      "fbase", ",", " ", "msg", ",", "tempmsg", ",", "progress", ",", "fname",
       ",", "descr", ",", "torSpec", ",", "polSpec", ",", "inData", ",", 
      "inFct", ",", "evaluateNlFct", ",", "nlFct", ",", "needCurl", ",", "nl",
       ",", "nlProjFct", ",", "nlTorFct", ",", "nlPolFct", ",", "refTor", ",",
       "refPol", ",", "outData"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"maxN", ",", " ", "maxL", ",", " ", "maxM"}], "}"}], "=", 
      RowBox[{"meta", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"fbase", "=", "name"}], ";", "\[IndentingNewLine]", 
     RowBox[{"msg", "=", 
      RowBox[{
      "\"\<Exporting \>\"", "<>", "name", "<>", 
       "\"\< Toroidal/Poloidal loop reference for N = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<, L = \>\"", " ", "<>", 
       RowBox[{"ToString", "[", "maxL", "]"}], "<>", "\"\<, M = \>\"", "<>", 
       RowBox[{"ToString", "[", "maxM", "]"}], "<>", "\"\<...\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tempmsg", "=", 
      RowBox[{"PrintTemporary", "[", "msg", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Generate", " ", "metadata"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"progress", "=", 
      RowBox[{
      "PrintTemporary", "[", "\"\<...Writing metadata...\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fname", "=", 
      RowBox[{"fbase", "<>", "\"\<_meta.dat\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kId", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{
          RowBox[{"meta", "[", 
           RowBox[{"[", "6", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "\"\<nlPassthrough\>\"",
         ",", " ", "0", ",", " ", "\"\<nlInertia\>\"", ",", " ", "1", ",", 
        "\"\<nlCurl\>\"", ",", " ", "2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pId", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"meta", "[", 
             RowBox[{"[", "7", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "==", "\"\<nl2Tor\>\""}], 
         " ", "&&", " ", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"meta", "[", 
             RowBox[{"[", "7", "]"}], "]"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}], "]"}], "==", "\"\<nl2Pol\>\""}]}],
         ",", "0", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"descr", " ", "=", " ", 
      RowBox[{"createMetadata", "[", 
       RowBox[{
       "maxN", ",", "maxL", ",", "maxM", ",", "3", ",", "kId", ",", "pId"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{"dataroot", ",", "refdir", ",", "subdir", ",", "fname"}], 
          "}"}], "]"}], "]"}], ",", "descr"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"NotebookDelete", "[", "progress", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Toroidal", " ", "input"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"progress", "=", 
      RowBox[{
      "PrintTemporary", "[", "\"\<...Writing Toroidal input...\>\"", "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"inFct", " ", "=", " ", 
      RowBox[{"meta", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"torSpec", " ", "=", " ", 
      RowBox[{"inFct", "[", 
       RowBox[{"maxN", ",", " ", "maxL", ",", " ", "maxM"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"inData", " ", "=", " ", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Re", "[", "torSpec", "]"}], ",", 
          RowBox[{"Im", "[", "torSpec", "]"}]}], "]"}], ",", "outprec"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fname", "=", 
      RowBox[{"fbase", "<>", "\"\<_tor_in.dat\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
