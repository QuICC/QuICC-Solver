Cell[BoxData[
 RowBox[{
  RowBox[{"evaluateNonlinearWLF", "[", 
   RowBox[{
   "maxN_", ",", "maxL_", ",", "maxM_", ",", "torSpec_", ",", "polSpec_", ",",
     "nlFct_", ",", "needCurl_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tor", ",", "pol", ",", "u", ",", "cu", ",", "nl", ",", "progress"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Get", " ", "analytic", " ", "expression", " ", "for", " ", 
      RowBox[{"Toroidal", "/", "Poloidal"}], " ", "scalars"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"progress", "=", 
      RowBox[{
      "PrintTemporary", "[", "\"\<   (Toroidal scalar expansion)\>\"", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tor", "=", 
      RowBox[{"analyticWLF", "[", 
       RowBox[{"maxN", ",", "maxL", ",", "maxM", ",", "torSpec"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"NotebookDelete", "[", "progress", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"progress", "=", 
      RowBox[{
      "PrintTemporary", "[", "\"\<   (Poloidal scalar expansion)\>\"", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pol", "=", 
      RowBox[{"analyticWLF", "[", 
       RowBox[{"maxN", ",", "maxL", ",", "maxM", ",", "polSpec"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"NotebookDelete", "[", "progress", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Evaluate", " ", "field"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"progress", "=", 
      RowBox[{
      "PrintTemporary", "[", 
       "\"\<   (Compute field from Toroidal/Poloidal)\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"u", " ", "=", " ", 
      RowBox[{
       RowBox[{"Curl", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r", " ", "tor"}], ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
         "\"\<Spherical\>\""}], "]"}], " ", "+", " ", 
       RowBox[{"Curl", "[", 
        RowBox[{
         RowBox[{"Curl", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"r", " ", "pol"}], ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
           "\"\<Spherical\>\""}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
         "\"\<Spherical\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"NotebookDelete", "[", "progress", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"needCurl", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"progress", "=", 
         RowBox[{
         "PrintTemporary", "[", "\"\<   (Compute curl from field)\>\"", 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"cu", " ", "=", " ", 
         RowBox[{"Curl", "[", 
          RowBox[{"u", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", 
           "\"\<Spherical\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "progress", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"progress", "=", 
         RowBox[{
         "PrintTemporary", "[", "\"\<   (Compute nonlinear term)\>\"", 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nl", "=", 
         RowBox[{"nlFct", "[", 
          RowBox[{"u", ",", "cu"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "progress", "]"}], ";"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"progress", "=", 
         RowBox[{
         "PrintTemporary", "[", "\"\<   (Compute nonlinear term)\>\"", 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nl", "=", 
         RowBox[{"nlFct", "[", "u", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "progress", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "nl"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9254355983850613`*^9, 3.925435950422057*^9}, {
