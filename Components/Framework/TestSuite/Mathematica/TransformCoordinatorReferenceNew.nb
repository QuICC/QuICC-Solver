Cell[BoxData[
 RowBox[{
  RowBox[{"forwardAnalyticTorPolWLF", "[", 
   RowBox[{
   "maxN_", ",", "maxL_", ",", "maxM_", ",", "nl_", ",", "torFct_", ",", 
    "polFct_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cnl", ",", "tor", ",", "pol", ",", "f", ",", "fm", ",", "ms", ",", 
      "flm", ",", "nth", ",", "nr", ",", "progress"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Grid", " ", "sizes"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nth", "=", 
      RowBox[{"Ceiling", "[", 
       RowBox[{
        FractionBox["3", "2"], 
        RowBox[{"(", 
         RowBox[{"maxL", "+", "2"}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nr", "=", 
      RowBox[{"Ceiling", "[", 
       RowBox[{
        FractionBox["3", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "maxN"}], "+", "maxL", "+", "1"}], ")"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
