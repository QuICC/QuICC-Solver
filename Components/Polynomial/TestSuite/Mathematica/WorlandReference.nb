Cell[BoxData[
 RowBox[{
  RowBox[{"refop", "[", 
   RowBox[{
   "ns_", ",", "gfunc_", ",", "wfunc_", ",", "opfunc_", ",", "name_"}], "]"}],
   ":=", " ", 
