Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Check", " ", "basic", " ", "setup"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxN", "=", "9"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ls", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "5", ",", "10", ",", "20"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ns", "=", 
     RowBox[{"{", 
      RowBox[{
      "5", ",", "7", ",", "10", ",", "12", ",", "15", ",", "18", ",", "20", 
       ",", "22", ",", "25", ",", "28", ",", "30"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"err", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "<=", " ", 
       RowBox[{"Length", "@", "ls"}]}], ",", 
      RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"errl", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"l", "=", 
        RowBox[{"ls", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", " ", "=", "1"}], ",", " ", 
         RowBox[{"i", "<=", " ", 
          RowBox[{"Length", "@", "ns"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ng", "=", 
           RowBox[{"ns", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"rg", " ", "=", " ", 
           RowBox[{"bgrid", "[", "ng", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"wg", "=", 
           RowBox[{"bweights", "[", "ng", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"ortho", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{"NoSlipSphJnl", "[", 
                RowBox[{"i", ",", "l", ",", "rg"}], "]"}], ",", 
               RowBox[{"wg", " ", 
                RowBox[{"NoSlipSphJnl", "[", 
                 RowBox[{"j", ",", "l", ",", "rg"}], "]"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "0", ",", "maxN"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "0", ",", "maxN"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"ortho", "-", 
                 RowBox[{"IdentityMatrix", "[", 
                  RowBox[{"maxN", "+", "1"}], "]"}]}], ",", "5"}], "]"}], "//",
               "MatrixForm"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"errl", ",", " ", 
            RowBox[{
             RowBox[{"ortho", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", 
                RowBox[{"-", "1"}]}], "]"}], "]"}], "-", "1"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Clear", "[", 
           RowBox[{"ng", ",", " ", "rg", ",", " ", "wg"}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"err", ",", "errl"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{"maxN", ",", "l"}], "]"}]}]}]], "Input",
