Cell[BoxData[
 RowBox[{
  RowBox[{"refDenseOp", "[", 
   RowBox[{
   "ns_", ",", "gfunc_", ",", "wfunc_", ",", "opfunc_", ",", "name_"}], "]"}],
   ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "32"}], ",", "i", ",", "maxN", ",", 
      "gridN", ",", "l", ",", " ", "grid", ",", "weights", ",", " ", "op", 
      ",", "msg", ",", "descr", ",", "tempmsg", ",", "fbase", ",", "fname"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"i", "\[LessEqual]", " ", 
        RowBox[{"Length", "[", "ns", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"maxN", "=", 
         RowBox[{"ns", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gridN", " ", "=", " ", 
         RowBox[{"ns", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"l", "=", 
         RowBox[{"ns", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fbase", "=", 
         RowBox[{"\"\<weighted_\>\"", "<>", "name"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"msg", "=", 
         RowBox[{
         "\"\<Exporting \>\"", "<>", "name", "<>", 
          "\"\< Worland operator for N = \>\"", "<>", 
          RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<, Ng = \>\"", 
          " ", "<>", 
          RowBox[{"ToString", "[", "gridN", "]"}], "<>", "\"\<, l = \>\"", "<>", 
          RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<...\>\""}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tempmsg", "=", 
         RowBox[{"PrintTemporary", "[", "msg", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Generate", " ", "metadata"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"fbase", "<>", "\"\<_id\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"i", "-", "1"}], "]"}], "<>", "\"\<_meta.dat\>\""}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"descr", " ", "=", " ", 
         RowBox[{"createMetadata", "[", 
          RowBox[{"maxN", ",", "gridN", ",", "l"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", "descr"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Generate", " ", "operator"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"generateRefData", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"grid", " ", "=", " ", 
            RowBox[{"gfunc", "[", "gridN", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"weights", "=", 
            RowBox[{"wfunc", "[", "gridN", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"op", " ", "=", " ", 
            RowBox[{"opfunc", "[", 
             RowBox[{"maxN", ",", "l", ",", "grid", ",", "weights"}], "]"}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"op", " ", "=", " ", 
            RowBox[{"N", "[", 
             RowBox[{"op", ",", "outprec"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"fname", "=", 
            RowBox[{"fbase", "<>", "\"\<_l\>\"", "<>", 
             RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<_n\>\"", "<>", 
             RowBox[{"ToString", "[", "maxN", "]"}], "<>", "\"\<_g\>\"", "<>", 
             RowBox[{"ToString", "[", "gridN", "]"}], "<>", 
             "\"\<.dat\>\""}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Export", "[", 
            RowBox[{
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"{", 
                RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], 
               "]"}], "]"}], ",", "op"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"NotebookDelete", "[", "tempmsg", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"msg", ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\< Done(\>\"", "<>", 
                  RowBox[{"DateString", "[", "]"}], "<>", "\"\<)\>\""}], ",", 
                 
                 RowBox[{"FontColor", "\[Rule]", "Green"}]}], "]"}]}], "}"}], 
             "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
