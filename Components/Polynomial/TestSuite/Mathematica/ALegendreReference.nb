Cell[BoxData[
 RowBox[{
  RowBox[{"refop", "[", 
   RowBox[{
   "ns_", ",", "gfunc_", ",", "wfunc_", ",", "opfunc_", ",", "name_"}], "]"}],
   ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"outprec", " ", "=", " ", "16"}], ",", "i", ",", "specN", ",", 
      "gridN", ",", "m", ",", " ", "grid", ",", "weights", ",", " ", "op", 
      ",", "msg", ",", "tempmsg", ",", "fname"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"i", "\[LessEqual]", " ", 
        RowBox[{"Length", "[", "ns", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"specN", "=", 
         RowBox[{"ns", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gridN", " ", "=", " ", 
         RowBox[{"ns", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"m", "=", 
         RowBox[{"ns", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"msg", "=", 
         RowBox[{
         "\"\<Exporting \>\"", "<>", "name", "<>", 
          "\"\< ALegendre operator for N = \>\"", "<>", 
          RowBox[{"ToString", "[", "specN", "]"}], "<>", "\"\<, Ng = \>\"", 
          " ", "<>", 
          RowBox[{"ToString", "[", "gridN", "]"}], "<>", "\"\<, m = \>\"", "<>", 
          RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<...\>\""}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tempmsg", "=", 
         RowBox[{"PrintTemporary", "[", "msg", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"grid", " ", "=", " ", 
         RowBox[{"gfunc", "[", "gridN", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"weights", " ", "=", " ", 
         RowBox[{"wfunc", "[", "gridN", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"op", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"opfunc", "[", 
             RowBox[{"l", ",", "m", ",", "grid"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"l", ",", "m", ",", 
              RowBox[{"m", "+", "specN", "-", "1"}]}], "}"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", "op", "]"}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"op", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"op", ",", "outprec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"name", "<>", "\"\<_m\>\"", "<>", 
          RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<_l\>\"", "<>", 
          RowBox[{"ToString", "[", "specN", "]"}], "<>", "\"\<_g\>\"", "<>", 
          RowBox[{"ToString", "[", "gridN", "]"}], "<>", "\"\<.dat\>\""}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", "op"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"fname", "=", 
         RowBox[{"\"\<weighted_\>\"", "<>", "fname"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"dataroot", ",", "refdir", ",", "fname"}], "}"}], "]"}], 
           "]"}], ",", 
          RowBox[{"weights", "*", "op"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "tempmsg", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"msg", ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\< Done(\>\"", "<>", 
               RowBox[{"DateString", "[", "]"}], "<>", "\"\<)\>\""}], ",", 
              RowBox[{"FontColor", "\[Rule]", "Green"}]}], "]"}]}], "}"}], 
          "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
